<Project>
  <!--
    System.Web support. A project opts in with <UseSystemWeb>true</UseSystemWeb>.
    - net10.0: WebFormsForCore, a port of System.Web (Web Forms, ASMX, ScriptServices) to ASP.NET Core.
    - netstandard2.0: Microsoft.AspNetCore.SystemWebAdapters, which type-forwards to the real System.Web
      when the library is loaded by a .NET Framework application. System.Web.UI is not available there,
      so Web Forms specific code is excluded from that leg with #if !NETSTANDARD2_0.
  -->
  <ItemGroup Condition="'$(UseSystemWeb)' == 'true' And '$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="WebFormsForCore.Web" Version="$(WebFormsForCoreVersion)" />
    <PackageReference Include="WebFormsForCore.Web.Extensions" Version="$(WebFormsForCoreVersion)" />
    <PackageReference Include="WebFormsForCore.Web.Services" Version="$(WebFormsForCoreVersion)" />
    <!-- Comes in through CoreWCF; its WsiProfiles/WebServiceBindingAttribute types clash with WebFormsForCore's System.Web.Services (CS0433). Runtime only. -->
    <PackageReference Include="System.Web.Services.Description" Version="8.1.2" ExcludeAssets="compile" />
    <!-- Lift transitive dependencies of WebFormsForCore past known advisories (GHSA-2fmv-rv2c-59x7, GHSA-846f-f764-76mx, GHSA-7hqp-7c5m-4vq6). -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.14" />
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.14" Condition="'$(UsingMicrosoftNETSdkWeb)' != 'true'" />
  </ItemGroup>

  <ItemGroup Condition="'$(UseSystemWeb)' == 'true' And '$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
  </ItemGroup>
</Project>

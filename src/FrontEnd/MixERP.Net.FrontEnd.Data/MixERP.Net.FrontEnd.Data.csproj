<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.FrontEnd.Data</RootNamespace>
    <AssemblyName>MixERP.Net.FrontEnd.Data</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>1685</NoWarn>
    <CodeAnalysisRuleSet>..\..\MixERP.ruleset</CodeAnalysisRuleSet>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <!-- Preserved from the deleted Properties/AssemblyInfo.cs -->
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>MixERP.Net.FrontEnd.Data</AssemblyTitle>
    <Product>MixERP.Net.FrontEnd.Data</Product>
    <Company>MixERP Inc.</Company>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- These were explicitly empty in the former Properties/AssemblyInfo.cs; the SDK would
         otherwise default Description/Configuration to non-empty values. -->
    <Description></Description>
    <AssemblyTrademark></AssemblyTrademark>
    <AssemblyConfiguration></AssemblyConfiguration>
    <!-- Keep AssemblyInformationalVersion as the literal original value, with no git-SHA suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <Version>1.2.0.1</Version>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>b556a8f4-02ff-4f46-9d7a-4643512c7004</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <!-- Replaces the legacy System.Web reference: ASP.NET Core HttpContext /
       IHttpContextAccessor for the sign-in seam in Office/Users.cs. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.DbFactory/MixERP.Net.DBFactory.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.Entities/MixERP.Net.Entities.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../../Libraries/Logic/PetaPoco/PetaPoco.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

@* ---------------------------------------------------------------------------------------------
   Site/Account/ChangePassword.aspx (+ its 347-line code-behind)
   -> Components/Pages/Site/Account/ChangePassword.razor (checklist task 98). The route is the one
   the migrated layouts link to (Specialist 5).

   MasterPageFile="~/BackendMaster.Master" -> @layout BackendLayout. ScriptContentPlaceholder and
   StyleSheetContentPlaceholder were EMPTY. BottomScriptContentPlaceholder carried
   <script src="/js/Pages/Site/Account/ChangePassword.aspx.js"></script>; a .razor file may not
   contain a <script> element, so that file is loaded from OnAfterRenderAsync(firstRender) through
   Specialist 7's wwwroot/js/mixerp/page-interop.js (loadScripts), unchanged.

   CODE-BEHIND MAP (Page_Init built the whole page programmatically; the markup below is that
   control tree, element for element, with HtmlControlHelper's css classes inlined):
     CreateHeader           -> <h1>@Titles.ChangePassword</h1>
     CreateDivider          -> <div class="ui divider"></div>        (HtmlControlHelper.GetDivider)
     CreateMessage          -> the "message" <div> (class assigned by ShowMessage)
     CreateForm             -> <div class="ui tiny form segment">    (GetFormSegment("ui tiny form segment"))
       CreateUserNameField      -> field + label(for) + "ui left icon input" + readonly input + "user icon"
       CreateCurrentPasswordField -> ... + <input type="password" id="PasswordInputPassword"> + "key icon"
       CreateNewPasswordField     -> ... + id="NewPasswordInputPassword"        + "key icon"
       CreateConfirmPasswordField -> ... + id="ConfirmPasswordInputPassword"    + "key icon"
       CreateButtons            -> the ChangePassword button + the "ui purple button" cancel link to "/"
       CreateMessageContainer   -> <div class="ui inverted pink error message segment">
     ChangePasswordButton_Click -> ChangePasswordAsync() below
     Dispose(bool)              -> nothing to port: the disposables were WebForms child controls,
                                   which no longer exist (the fields are plain strings now).

   ⚠ The field ORDER is load-bearing twice over: HtmlControlHelper placed the INPUT before the
   ICON inside "ui left icon input" (that is what the original emitted), and the message container
   is appended AFTER the buttons.

   ⚠ The element ids are the contract of /js/Pages/Site/Account/ChangePassword.aspx.js, which
   validates by identifier: PasswordInputPassword, NewPasswordInputPassword,
   ConfirmPasswordInputPassword (plus UserNameInputText, referenced by its label's "for").

   VALIDATION ORDER AND MESSAGES are preserved exactly:
     1. Warnings.PleaseEnterCurrentPassword
     2. Warnings.PleaseEnterNewPassword
     3. Warnings.NewPasswordCannotBeOldPassword
     4. Warnings.ConfirmationPasswordDoesNotMatch
   Success -> Labels.YourPasswordWasChanged with "ui large green header";
   MixERPException -> ex.Message with "ui large red header", preceded by
   Log.Warning("Could not change password: {Message}.", ex.Message).

   AppUsers.GetCurrent() is replaced by Specialist 4's circuit-safe CurrentLoginProvider (the
   former returns an EMPTY login inside a circuit), and AppUsers.GetCurrentUserDB() by
   CurrentLogin.GetCatalogAsync().
   --------------------------------------------------------------------------------------------- *@
@page "/Site/Account/ChangePassword"
@layout BackendLayout
@inherits MixERPAuthorizedPageBase
@using Serilog

@inject IJSRuntime JSRuntime

<h1>@Titles.ChangePassword</h1>
<div class="ui divider"></div>

@* CreateMessage: an empty <div> that ShowMessage fills with the text and the css class. *@
<div class="@this.messageCssClass">@this.messageText</div>

<div class="ui tiny form segment">
    @* CreateUserNameField *@
    <div class="field">
        <label for="UserNameInputText">@Titles.Username</label>
        <div class="ui left icon input">
            <input type="text" id="UserNameInputText" name="UserNameInputText" readonly="readonly" value="@this.userName" />
            <i class="user icon"></i>
        </div>
    </div>

    @* CreateCurrentPasswordField *@
    <div class="field">
        <label for="PasswordInputPassword">@Titles.CurrentPassword</label>
        <div class="ui left icon input">
            <input type="password" id="PasswordInputPassword" name="PasswordInputPassword" @bind="this.currentPassword" @bind:event="oninput" />
            <i class="key icon"></i>
        </div>
    </div>

    @* CreateNewPasswordField *@
    <div class="field">
        <label for="NewPasswordInputPassword">@Titles.NewPassword</label>
        <div class="ui left icon input">
            <input type="password" id="NewPasswordInputPassword" name="NewPasswordInputPassword" @bind="this.newPassword" @bind:event="oninput" />
            <i class="key icon"></i>
        </div>
    </div>

    @* CreateConfirmPasswordField *@
    <div class="field">
        <label for="ConfirmPasswordInputPassword">@Titles.ConfirmPassword</label>
        <div class="ui left icon input">
            <input type="password" id="ConfirmPasswordInputPassword" name="ConfirmPasswordInputPassword" @bind="this.confirmPassword" @bind:event="oninput" />
            <i class="key icon"></i>
        </div>
    </div>

    @* CreateButtons: the asp:Button rendered <input type="submit">; there is no form post any
       more, so it is a <button type="button"> with the same class and the same server-side
       handler. Its OnClientClick gate ("return $('.form').form('validate form');") runs FIRST
       inside the handler through page-interop.validateForm. *@
    <button type="button" class="ui pink button" @onclick="this.ChangePasswordAsync">@Titles.ChangePassword</button>
    <a class="ui purple button" href="/">@Titles.Cancel</a>

    @* CreateMessageContainer *@
    <div class="ui inverted pink error message segment">@this.errorMessage</div>
</div>

@code {
    /// <summary>
    ///     BottomScriptContentPlaceholder: the single &lt;script src&gt; of the legacy page.
    /// </summary>
    private static readonly string[] PageScripts =
    {
        "/js/Pages/Site/Account/ChangePassword.aspx.js"
    };

    private string userName = string.Empty;
    private string catalog = string.Empty;

    private string currentPassword = string.Empty;
    private string newPassword = string.Empty;
    private string confirmPassword = string.Empty;

    //CreateMessage()'s div: no class and no text until ShowMessage runs.
    private string messageText = string.Empty;
    private string messageCssClass;

    //CreateMessageContainer()'s div: the validation message surface.
    private string errorMessage = string.Empty;

    /// <summary>
    ///     Page_Init: <c>this.IsLandingPage = true</c> -- the page has no menu entry of its own, so
    ///     the policy check must not run against it. Set in the constructor because the base
    ///     activation sequence that reads it runs in OnInitializedAsync.
    /// </summary>
    public ChangePassword()
    {
        this.IsLandingPage = true;
    }

    /// <summary>
    ///     CreateUserNameField's <c>AppUsers.GetCurrent().View.UserName</c> and the catalog the
    ///     click handler posts against, both read through the circuit-safe login provider.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync().ConfigureAwait(true);

        MetaLogin login = await this.CurrentLogin.GetCurrentAsync().ConfigureAwait(true);

        if (login != null && login.View != null)
        {
            this.userName = login.View.UserName;
        }

        this.catalog = await this.CurrentLogin.GetCatalogAsync().ConfigureAwait(true);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender).ConfigureAwait(true);

        if (!firstRender)
        {
            return;
        }

        IJSObjectReference module = await this.JSRuntime
            .InvokeAsync<IJSObjectReference>("import", "/js/mixerp/page-interop.js").ConfigureAwait(true);

        await module.InvokeVoidAsync("loadScripts", (object)PageScripts).ConfigureAwait(true);
    }

    /// <summary>
    ///     ChangePasswordButton_Click, including the OnClientClick gate.
    /// </summary>
    private async Task ChangePasswordAsync()
    {
        //OnClientClick: "return $('.form').form('validate form');" -- a false result suppressed the
        //postback, so nothing below may run.
        if (!await this.ValidateClientSideAsync().ConfigureAwait(true))
        {
            return;
        }

        //The original re-read the user name from the login on every click.
        string user = this.userName;

        if (string.IsNullOrWhiteSpace(this.currentPassword))
        {
            this.errorMessage = Warnings.PleaseEnterCurrentPassword;
            return;
        }

        if (string.IsNullOrWhiteSpace(this.newPassword))
        {
            this.errorMessage = Warnings.PleaseEnterNewPassword;
            return;
        }

        if (this.currentPassword.Equals(this.newPassword, StringComparison.Ordinal))
        {
            this.errorMessage = Warnings.NewPasswordCannotBeOldPassword;
            return;
        }

        if (!this.newPassword.Equals(this.confirmPassword, StringComparison.Ordinal))
        {
            this.errorMessage = Warnings.ConfirmationPasswordDoesNotMatch;
            return;
        }

        //A previous attempt's validation message must not survive a successful one.
        this.errorMessage = string.Empty;

        try
        {
            if (MixERP.Net.FrontEnd.Data.Office.User.ChangePassword(this.catalog, user, this.currentPassword, this.newPassword))
            {
                this.ShowMessage(Labels.YourPasswordWasChanged, "ui large green header");
            }
        }
        catch (MixERPException ex)
        {
            Log.Warning("Could not change password: {Message}.", ex.Message);
            this.ShowMessage(ex.Message, "ui large red header");
        }
    }

    private async Task<bool> ValidateClientSideAsync()
    {
        try
        {
            IJSObjectReference module = await this.JSRuntime
                .InvokeAsync<IJSObjectReference>("import", "/js/mixerp/page-interop.js").ConfigureAwait(true);

            return await module.InvokeAsync<bool>("validateForm", ".form").ConfigureAwait(true);
        }
        catch (JSException ex)
        {
            //The client gate was never authoritative: without it the postback simply happened and
            //the server-side checks below decided. Same here.
            Log.Verbose("The client-side form validation could not run. {Exception}.", ex);
            return true;
        }
    }

    /// <summary>
    ///     ShowMessage(msg, cssClass).
    /// </summary>
    private void ShowMessage(string msg, string cssClass)
    {
        this.messageText = msg;
        this.messageCssClass = cssClass;
    }
}

<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.FrontEnd</RootNamespace>
    <AssemblyName>MixERP.Net.FrontEnd</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <!-- Carried over from the deleted Properties/AssemblyInfo.cs. The master-page/layout version
         literal reads this through AssemblyInformationalVersionAttribute - do not remove. -->
    <Version>1.2.0.1</Version>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
    <!-- Carry-forward from MixERP.Net.ApplicationState/migration-summary.md: SDK projects append
         a git-SHA suffix to AssemblyInformationalVersion by default, which would change the
         version string the master-page/layout version literal renders. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- The Modules/<Name>/ and Modules/<Name>.Data/ subtrees are SEPARATE projects with their own
         .csproj files. Exclude their files from this project's default item globs (the host only owns
         Modules/Default.aspx, Modules/FirstSteps.aspx and Modules/Update.aspx at the Modules root).
         The db/ folder holds SQL scripts only. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Modules\*\**;db\**;Designs\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Hosting" Version="9.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Resource/ stays at the CONTENT ROOT (not wwwroot): it is written at runtime
         (attachments, e-mails, database backups, temporary report images, runtime configs).
         Program.cs must create any missing subdirectory at startup. -->
    <!-- *.config files under Resource\ and MixERP.Installation.config are ALREADY picked up by
         the Web SDK's default Content glob, so they must be UPDATEd (not Included again) or the
         build fails with NETSDK1022 "Duplicate 'Content' items". -->
    <Content Update="MixERP.Installation.config" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Resource\**\*.config" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resource\**" Exclude="Resource\**\*.config" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Logic\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.ReportManager\MixERP.Net.ReportManager.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Updater\MixERP.Net.Updater.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.AttachmentFactory\MixERP.Net.WebControls.AttachmentFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ReportEngine\MixERP.Net.WebControls.ReportEngine.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ScrudFactory\MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.TransactionChecklist\MixERP.Net.WebControls.TransactionChecklist.csproj" />
    <ProjectReference Include="..\MixERP.Net.FrontEnd.Data\MixERP.Net.FrontEnd.Data.csproj" />
    <!-- Added by the Program.cs composition pass (checklist tasks 38 and 39). These three
         libraries used to be reached only through the AppDomain assembly scan / reflection
         (ICurrencyConverter discovery) and through the module projects. On modern .NET the
         HOST owns their startup composition: AddCurrencylayer(), AddOpenExchangeRates() +
         UseOpenExchangeRates(...) and Configure<EmailOptions>(...). Without the references
         those calls cannot exist and the configured HTTP-client/configuration pipeline is
         bypassed permanently (recorded in each library's migration-summary.md). -->
    <ProjectReference Include="..\..\Libraries\CurrencyAPI\MixERP.Net.CurrencyConversion.Currencylayer\MixERP.Net.CurrencyConversion.Currencylayer.csproj" />
    <ProjectReference Include="..\..\Libraries\CurrencyAPI\MixERP.Net.CurrencyConversion.OpenExchangeRates\MixERP.Net.CurrencyConversion.OpenExchangeRates.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Messaging\MixERP.Net.Messaging.Email.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- ==========================================================================================
         The 8 module UI projects (Modules/migration-summary.md section 13(a)).
         DIRECTION: HOST -> RCL. The legacy module->host reference was the inverted direction a
         Razor Class Library may not use (it makes the RCL's components undiscoverable) and was
         removed by the infrastructure pass; it must NEVER be reintroduced. The three shared types
         it existed for live in MixERP.Net.Framework / MixERP.Net.WebControls.ScrudFactory now, and
         the host's CurrentLoginProvider / MixERPAuthorization reach the modules through the
         ICurrentLogin / IMixERPAuthorization contracts registered above.

         Without these eight references no module assembly reaches the host output, so
         DiscoveryAssemblies finds nothing, ModuleComponentResolver resolves nothing and EVERY
         /Modules/** route plus the whole dashboard renders empty. They also are what makes each
         module's `_content/<AssemblyName>/...` static assets resolve.

         NOTE: the DefaultItemExcludes entry `Modules\*\**` above stays. These files belong to the
         sibling projects and must not be compiled into the host as well.
         ========================================================================================== -->
    <ProjectReference Include="Modules\Sales\MixERP.Net.Core.Modules.Sales.csproj" />
    <ProjectReference Include="Modules\Purchase\MixERP.Net.Core.Modules.Purchase.csproj" />
    <ProjectReference Include="Modules\Inventory\MixERP.Net.Core.Modules.Inventory.csproj" />
    <ProjectReference Include="Modules\Finance\MixERP.Net.Core.Modules.Finance.csproj" />
    <ProjectReference Include="Modules\Manufacturing\MixERP.Net.Core.Modules.Manufacturing.csproj" />
    <ProjectReference Include="Modules\CRM\MixERP.Net.Core.Modules.CRM.csproj" />
    <ProjectReference Include="Modules\POS\MixERP.Net.Core.Modules.POS.csproj" />
    <ProjectReference Include="Modules\BackOffice\MixERP.Net.Core.Modules.BackOffice.csproj" />
  </ItemGroup>

</Project>

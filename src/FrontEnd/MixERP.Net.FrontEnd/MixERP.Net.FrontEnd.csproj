<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MixERP.Net.FrontEnd</RootNamespace>
    <AssemblyName>MixERP.Net.FrontEnd</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>..\..\MixERP.ruleset</CodeAnalysisRuleSet>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- Content is listed explicitly below (legacy folder layout, no wwwroot). -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <!-- Legacy ConfigurationManager settings (former Web.config appSettings), deployed as MixERP.Net.FrontEnd.dll.config. -->
    <AppConfig>App.config</AppConfig>
    <!-- The module projects (Modules/<Module>) are separate projects nested in this folder; they build into this
         application's output folder and are loaded at startup (like the former shared bin folder). -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Modules\*\**;Tests\**;Designs\**;db\**;Backups\**</DefaultItemExcludes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.153.1" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Web.UI\MixERP.Net.Web.UI.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.DbFactory\MixERP.Net.DBFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.ReportManager\MixERP.Net.ReportManager.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Updater\MixERP.Net.Updater.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\..\Libraries\Checklists\MixERP.Net.FirstSteps\MixERP.Net.FirstSteps.csproj" />
    <ProjectReference Include="..\..\Libraries\CurrencyAPI\MixERP.Net.CurrencyConversion.Currencylayer\MixERP.Net.CurrencyConversion.Currencylayer.csproj" />
    <ProjectReference Include="..\..\Libraries\CurrencyAPI\MixERP.Net.CurrencyConversion.OpenExchangeRates\MixERP.Net.CurrencyConversion.OpenExchangeRates.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.AttachmentFactory\MixERP.Net.WebControls.AttachmentFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ReportEngine\MixERP.Net.WebControls.ReportEngine.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ScrudFactory\MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.TransactionChecklist\MixERP.Net.WebControls.TransactionChecklist.csproj" />
    <ProjectReference Include="..\MixERP.Net.FrontEnd.Data\MixERP.Net.FrontEnd.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Static assets and runtime configuration files served/read from the content root. -->
    <Content Include="Scripts\**;Static\**;Stylesheets\**;bundles\**;App_Themes\**;Reports\Assets\**;Reports\Print.html;Site\offline.html;Resource\**;Views\**;Modules\*\Scripts\**;Modules\*\Reports\Source\**;index.html;robots.txt;License.txt;MixERP.Installation.config;Web.config" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>MixERP.Net.FrontEnd</RootNamespace>
    <AssemblyName>MixERP.Net.FrontEnd</AssemblyName>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>..\..\MixERP.ruleset</CodeAnalysisRuleSet>
    <!-- Web Forms pages, user controls, ASMX services and handlers run on WebFormsForCore (see Program.cs). -->
    <UseSystemWeb>true</UseSystemWeb>
    <UseSystemWebExtensions>true</UseSystemWebExtensions>
    <UseSystemWebServices>true</UseSystemWebServices>
    <!--
      Like classic ASP.NET, WebFormsForCore compiles .aspx/.ascx markup at runtime against the assemblies in the
      site's own bin folder, so the output must stay a flat direct subfolder of the project (the module projects
      under Modules\ build into this same folder).
    -->
    <OutputPath>bin\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- Every Modules\<Module>\ folder is a separate project; only the pages directly under Modules\ belong here. -->
    <Compile Remove="Modules\*\**" />
    <EmbeddedResource Remove="Modules\*\**" />
    <None Remove="Modules\*\obj\**;Modules\*\bin\**" />
    <Content Remove="Modules\*\obj\**;Modules\*\bin\**;Modules\*\*.csproj;Modules\*\packages.config" />
  </ItemGroup>

  <ItemGroup>
    <!-- Web Forms markup and static site assets (former FilesToIncludeForPublish=AllFilesInProjectFolder). -->
    <Content Include="**\*.aspx;**\*.ascx;**\*.master;**\*.asmx;**\*.ashx;**\*.asax;**\*.skin;**\*.html;**\*.js;**\*.css;**\*.map;**\*.png;**\*.jpg;**\*.gif;**\*.ico;**\*.svg;**\*.woff;**\*.woff2;**\*.ttf;**\*.eot;**\*.sql;**\*.xml;**\*.txt;**\*.bundle"
             Exclude="bin\**;obj\**;Modules\*\obj\**;Modules\*\bin\**;@(Content)"
             CopyToPublishDirectory="PreserveNewest" />
    <None Remove="**\*.aspx;**\*.ascx;**\*.master;**\*.asmx;**\*.ashx;**\*.asax;**\*.skin;**\*.html;**\*.js;**\*.css;**\*.map;**\*.png;**\*.jpg;**\*.gif;**\*.ico;**\*.svg;**\*.woff;**\*.woff2;**\*.ttf;**\*.eot;**\*.sql;**\*.xml;**\*.txt;**\*.bundle" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The data layer was written against Npgsql 2.x DateTime semantics; Npgsql 6+ maps timestamptz to UTC-only
      DateTime values unless the legacy behavior is enabled.
    -->
    <RuntimeHostConfigurationOption Include="Npgsql.EnableLegacyTimestampBehavior" Value="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Logic\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.ReportManager\MixERP.Net.ReportManager.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Updater\MixERP.Net.Updater.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.AttachmentFactory\MixERP.Net.WebControls.AttachmentFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ReportEngine\MixERP.Net.WebControls.ReportEngine.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ScrudFactory\MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.TransactionChecklist\MixERP.Net.WebControls.TransactionChecklist.csproj" />
    <ProjectReference Include="..\MixERP.Net.FrontEnd.Data\MixERP.Net.FrontEnd.Data.csproj" />
  </ItemGroup>
</Project>

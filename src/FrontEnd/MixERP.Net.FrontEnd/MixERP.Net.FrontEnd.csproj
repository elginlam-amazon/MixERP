    <ProjectReference Include="../MixERP.Net.FrontEnd.Data/MixERP.Net.FrontEnd.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The module projects live below the site folder; they are separate projects. -->
    <Compile Remove="Modules/**" />
    <None Remove="Modules/**" />
    <Content Include="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


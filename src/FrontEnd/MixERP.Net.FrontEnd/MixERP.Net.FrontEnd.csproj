<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <EnableDefaultItems>false</EnableDefaultItems>
    <RootNamespace>MixERP.Net.FrontEnd</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.4.1-dev-02447" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.12" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.12" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.12" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="System.Security.Permissions" Version="9.0.0" />
    <PackageReference Include="System.CodeDom" Version="10.0.12" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude module subdirectories that have their own projects -->
    <Compile Remove="Modules/BackOffice/**" />
    <Compile Remove="Modules/BackOffice.Data/**" />
    <Compile Remove="Modules/CRM/**" />
    <Compile Remove="Modules/CRM.data/**" />
    <Compile Remove="Modules/Finance/**" />
    <Compile Remove="Modules/Finance.Data/**" />
    <Compile Remove="Modules/Inventory/**" />
    <Compile Remove="Modules/Inventory.Data/**" />
    <Compile Remove="Modules/Manufacturing/**" />
    <Compile Remove="Modules/Manufacturing.Data/**" />
    <Compile Remove="Modules/POS/**" />
    <Compile Remove="Modules/POS.Data/**" />
    <Compile Remove="Modules/Purchase/**" />
    <Compile Remove="Modules/Purchase.Data/**" />
    <Compile Remove="Modules/Sales/**" />
    <Compile Remove="Modules/Sales.Data/**" />
    <!-- Exclude obj directories from previous builds -->
    <Compile Remove="**/obj/**" />
    <!-- Exclude designer files from compilation - they're code-gen artifacts -->
    <!-- Keep them but they need proper exclusion of duplicates -->
  </ItemGroup>
  <ItemGroup>
    <!-- Explicit compilation - exclude modules that have their own projects -->
    <Compile Include="**/*.cs"
             Exclude="Modules/BackOffice/**;Modules/BackOffice.Data/**;Modules/CRM/**;Modules/CRM.data/**;Modules/Finance/**;Modules/Finance.Data/**;Modules/Inventory/**;Modules/Inventory.Data/**;Modules/Manufacturing/**;Modules/Manufacturing.Data/**;Modules/POS/**;Modules/POS.Data/**;Modules/Purchase/**;Modules/Purchase.Data/**;Modules/Sales/**;Modules/Sales.Data/**;**/obj/**;**/bin/**" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Libraries/Logic/MixER.Net.StateServer/MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.Entities/MixERP.Net.Entities.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.ReportManager/MixERP.Net.ReportManager.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.Updater/MixERP.Net.Updater.csproj" />
    <ProjectReference Include="../../Libraries/Logic/PetaPoco/PetaPoco.csproj" />
    <ProjectReference Include="../../Libraries/Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../Libraries/Server Controls/Project/MixERP.Net.WebControls.AttachmentFactory/MixERP.Net.WebControls.AttachmentFactory.csproj" />
    <ProjectReference Include="../../Libraries/Server Controls/Project/MixERP.Net.WebControls.ReportEngine/MixERP.Net.WebControls.ReportEngine.csproj" />
    <ProjectReference Include="../../Libraries/Server Controls/Project/MixERP.Net.WebControls.ScrudFactory/MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="../../Libraries/Server Controls/Project/MixERP.Net.WebControls.TransactionChecklist/MixERP.Net.WebControls.TransactionChecklist.csproj" />
    <ProjectReference Include="../MixERP.Net.FrontEnd.Data/MixERP.Net.FrontEnd.Data.csproj" />
  </ItemGroup>
</Project>

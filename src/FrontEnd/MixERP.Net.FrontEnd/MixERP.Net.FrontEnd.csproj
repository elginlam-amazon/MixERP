<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.FrontEnd</RootNamespace>
    <AssemblyName>MixERP.Net.FrontEnd</AssemblyName>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>..\..\MixERP.ruleset</CodeAnalysisRuleSet>
    <!-- The Web Forms markup, scripts and stylesheets live in the project folder (the content root), not in wwwroot. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
    <PackageReference Include="CoreWebForms.Compiler.Dynamic" Version="0.5.0" />
    <PackageReference Include="CoreWebForms.SystemWebExtensions" Version="0.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <!-- Each module under Modules\<Module>\ is its own project; only the top-level Modules\*.aspx code-behind belongs here. -->
    <Compile Remove="Modules\*\**" />
    <None Remove="Modules\*\bin\**;Modules\*\obj\**" />
  </ItemGroup>
  <ItemGroup>
    <!-- Web Forms pages/controls/handlers and static assets are served from the content root and must be published with the app. -->
    <Content Include="**\*" Exclude="bin\**;obj\**;**\bin\**;**\obj\**;**\*.cs;**\*.csproj;**\*.csproj.user;**\*.snk;Properties\**;App.config" CopyToOutputDirectory="Never" CopyToPublishDirectory="PreserveNewest" />
    <Content Update="appsettings*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Remove="@(Content)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\Libraries\Logic\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.ReportManager\MixERP.Net.ReportManager.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Updater\MixERP.Net.Updater.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.AttachmentFactory\MixERP.Net.WebControls.AttachmentFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ReportEngine\MixERP.Net.WebControls.ReportEngine.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ScrudFactory\MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.TransactionChecklist\MixERP.Net.WebControls.TransactionChecklist.csproj" />
    <ProjectReference Include="..\MixERP.Net.FrontEnd.Data\MixERP.Net.FrontEnd.Data.csproj" />
  </ItemGroup>
</Project>

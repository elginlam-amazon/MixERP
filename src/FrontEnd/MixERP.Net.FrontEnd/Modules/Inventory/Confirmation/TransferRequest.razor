@* Ported from Confirmation/TransferRequest.ascx + .ascx.cs + .ascx.designer.cs - the stock
   transfer REQUEST check list.

   OnControlLoad built a `Checklist` and added it to <asp:PlaceHolder ID="Placeholder1">.
   `MixERP.Net.FrontEnd.Controls.Checklist` NO LONGER EXISTS (it only set Catalog from
   AppUsers.GetCurrentUserDB(), which is EMPTY inside a Blazor circuit), so
   <TransactionChecklistForm> is hosted directly with Catalog from ICurrentLogin.

   PRESERVED SURFACE:
     * IsStockTransferRequest = true - the flag that switches the check list onto the
       non-GL transfer-request tables instead of the transaction tables. This screen and its
       markup are otherwise identical in shape to its siblings, so losing this one boolean
       would make the check list query the wrong book.
     * AttachmentBookName = "inventory.transfer.request" (not "transaction").
     * the check list's OverridePath = "/Modules/Inventory/TransferRequest.mix", which the
       code-behind assigned. NOTE: unlike its Transfer and Adjustment siblings, THIS .ascx
       declared NO OverridePath in its <%@ Control %> directive, so the CONTROL's own
       OverridePath stays unset - that is the original surface and it is preserved (nothing
       is assigned in a constructor here on purpose).
     * RestrictedTransactionMode = this.IsRestrictedMode, which the base computes during
       base.OnInitializedAsync().

   The original declared no AccessLevel, MasterPageId, RemoveTheme or IsLandingPage override
   and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.TransactionCheckListControl
@using MixERP.Net.WebControls.TransactionChecklist
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <TransactionChecklistForm ViewReportButtonText="@Titles.ViewThisRequest"
                              Text="@Titles.StockTransferRequest"
                              AttachmentBookName="inventory.transfer.request"
                              OverridePath="/Modules/Inventory/TransferRequest.mix"
                              DisplayWithdrawButton="true"
                              DisplayViewReportButton="true"
                              DisplayAttachmentButton="true"
                              IsStockTransferRequest="true"
                              ReportPath="~/Modules/Inventory/Reports/InventoryTransferRequestReport.mix"
                              ViewPath="/Modules/Inventory/TransferRequest.mix"
                              AddNewPath="/Modules/Inventory/Entry/TransferRequest.mix"
                              UserId="@this.userId"
                              RestrictedTransactionMode="@this.IsRestrictedMode"
                              Catalog="@this.catalog" />
}

@code {
    private bool loaded;
    private int userId;
    private string catalog;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the check list above, which is markup now; the user id
    ///     and the catalog are asynchronous, so they are read in OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks AND computes IsRestrictedMode,
        //which the check list below is given - never skip it, and never read IsRestrictedMode
        //before it.
        await base.OnInitializedAsync();

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.loaded = true;
    }
}

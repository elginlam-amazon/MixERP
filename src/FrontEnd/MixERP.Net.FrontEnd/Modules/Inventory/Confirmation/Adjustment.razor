@* Ported from Confirmation/Adjustment.ascx + .ascx.cs + .ascx.designer.cs - the stock
   adjustment transaction CHECK LIST (verify / withdraw / print / GL advice / attach).

   OnControlLoad built a `Checklist` and added it to <asp:PlaceHolder ID="Placeholder1">.
   `MixERP.Net.FrontEnd.Controls.Checklist` NO LONGER EXISTS (it was a one-property Report/
   Checklist subclass that set Catalog from AppUsers.GetCurrentUserDB(), which is EMPTY
   inside a Blazor circuit), so <TransactionChecklistForm> is hosted directly with Catalog
   from ICurrentLogin.

   PRESERVED SURFACE, ODDITY INCLUDED:
     * the control's own OverridePath is "/Modules/Inventory/TRANSFER.mix" - the value the
       <%@ Control %> directive declares on this ADJUSTMENT screen. It looks like an upstream
       copy-paste bug (its own code-behind sets Adjustment.mix on the hosted check list, two
       lines of markup away), but OverridePath decides MENU AUTHORIZATION: the host's
       MixERPAuthorization.VerifyAccess compares a menu Url against it, so changing it
       silently changes who can reach this screen. It is carried VERBATIM and raised
       separately. Assigned in the CONSTRUCTOR because the host's ModuleHost.razor reads it
       off an Activator.CreateInstance probe instance on which no lifecycle method runs.
     * the SEPARATE OverridePath the code-behind assigned onto the hosted check list, which
       IS "/Modules/Inventory/Adjustment.mix" - also carried verbatim, as a parameter below.
       The two genuinely differ and both are preserved as found.
     * DisplayPrintGlEntryButton = true and the GlAdvicePath into the Finance module, which
       its three Transfer* siblings do not have.
     * RestrictedTransactionMode = this.IsRestrictedMode, which the base computes during
       base.OnInitializedAsync().

   The original declared no AccessLevel, MasterPageId, RemoveTheme or IsLandingPage override
   and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.TransactionCheckListControl
@using MixERP.Net.WebControls.TransactionChecklist
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <TransactionChecklistForm ViewReportButtonText="@Titles.ViewThisAdjustment"
                              Text="@Titles.StockAdjustment"
                              AttachmentBookName="transaction"
                              OverridePath="/Modules/Inventory/Adjustment.mix"
                              DisplayWithdrawButton="true"
                              DisplayViewReportButton="true"
                              DisplayAttachmentButton="true"
                              DisplayPrintGlEntryButton="true"
                              ReportPath="~/Modules/Inventory/Reports/InventoryAdjustmentReport.mix"
                              ViewPath="/Modules/Inventory/Adjustment.mix"
                              GlAdvicePath="~/Modules/Finance/Reports/GLAdviceReport.mix"
                              AddNewPath="/Modules/Inventory/Entry/Adjustment.mix"
                              UserId="@this.userId"
                              RestrictedTransactionMode="@this.IsRestrictedMode"
                              Catalog="@this.catalog" />
}

@code {
    private bool loaded;
    private int userId;
    private string catalog;

    public Adjustment()
    {
        //<%@ Control ... OverridePath="/Modules/Inventory/Transfer.mix" %>
        //NOT a typo of this port - see the header note. Carried verbatim.
        this.OverridePath = "/Modules/Inventory/Transfer.mix";
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the check list above, which is markup now; the user id
    ///     and the catalog are asynchronous, so they are read in OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks AND computes IsRestrictedMode,
        //which the check list below is given - never skip it, and never read IsRestrictedMode
        //before it.
        await base.OnInitializedAsync();

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.loaded = true;
    }
}

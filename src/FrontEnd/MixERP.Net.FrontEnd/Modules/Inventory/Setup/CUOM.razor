@* Ported from Setup/CUOM.ascx + .ascx.cs + .ascx.designer.cs - the compound
   units-of-measure maintenance screen.

   OnControlLoad built a Scrud and added it to <asp:PlaceHolder ID="ScrudPlaceholder">,
   which is this markup now. The .ascx's inline scrudCustomValidator() block - the gate
   Scrud.js calls before it saves, which refuses a compound unit whose base and compare
   units are the same - moved VERBATIM to wwwroot/js/setup/CUOM.js, because a .razor file
   may not contain <script>.

   GetDisplayFields() read DbConfig.GetDbParameter(AppUsers.GetCurrentUserDB(), ...).
   AppUsers.GetCurrentUserDB() returns an EMPTY catalog inside a Blazor circuit, so the
   catalog comes from ICurrentLogin and the lookup moved to OnInitializedAsync.

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.Core.Modules.Inventory.Internal
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources
@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (this.loaded)
{
    <Scrud KeyColumn="compound_unit_id"
           TableSchema="core"
           Table="compound_units"
           ViewSchema="core"
           View="compound_unit_scrud_view"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           Text="@Titles.CompoundUnitsOfMeasure" />
}

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above, which is markup now; its display-field
    ///     lookup needs the catalog, which is asynchronous, so that work is in
    ///     OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await ModuleScripts.LoadAsync(this.JS,
                "_content/MixERP.Net.Core.Modules.Inventory/js/setup/CUOM.js");
        }
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "core.units.unit_id",
            DbConfig.GetDbParameter(catalog, "UnitDisplayField"));
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "core.units.unit_id", "core.unit_scrud_view");
        return string.Join(",", displayViews);
    }
}

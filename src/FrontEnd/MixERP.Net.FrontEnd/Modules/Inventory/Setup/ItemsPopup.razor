@* Ported from Setup/ItemsPopup.ascx + ItemsPopup.ascx.cs + ItemsPopup.ascx.designer.cs -
   the item maintenance screen in its POPUP form, opened by StockAdjustmentForm's F4 item
   lookup as
   /Modules/Inventory/Setup/ItemsPopup.mix?modal=1&CallBackFunctionName=loadItems&AssociatedControlId=ItemIdHidden.

   PRESERVED SURFACE: MasterPageId = "MixERPBlankMaster.Master" (from the <%@ Control %>
   directive), assigned in the CONSTRUCTOR because the host's ModuleHost.razor reads it off
   an Activator.CreateInstance PROBE INSTANCE on which no lifecycle method ever runs. That
   is what makes this screen render chrome-free inside the popup window; losing it would
   render the whole backend layout inside the modal.

   The <div class="container" id="container" runat="server"> wrapper is preserved with its
   id and class - the blank master's stylesheet targets it. (The `runat="server"` only
   existed so the code-behind COULD reach it; nothing ever did.)

   The eight display-field lookups read
   DbConfig.GetDbParameter(AppUsers.GetCurrentUserDB(), ...); that catalog is EMPTY inside a
   Blazor circuit, so it comes from ICurrentLogin in OnInitializedAsync.

   The original declared no OverridePath, AccessLevel, RemoveTheme or IsLandingPage override
   and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

<div class="container" id="container">
    @if (this.loaded)
    {
        <Scrud KeyColumn="item_id"
               TableSchema="core"
               Table="items"
               ViewSchema="core"
               View="item_scrud_view"
               DisplayFields="@this.displayFields"
               DisplayViews="@this.displayViews"
               UseDisplayViewsAsParents="true"
               ExcludeEdit="item_code, maintain_stock, item_group_id"
               Text="@Titles.Items" />
    }
</div>

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    public ItemsPopup()
    {
        //<%@ Control ... MasterPageId="MixERPBlankMaster.Master" %>
        this.MasterPageId = "MixERPBlankMaster.Master";
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above, which is markup now; its eight
    ///     display-field lookups need the catalog, which is asynchronous.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    internal static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "core.item_types.item_type_id",
            DbConfig.GetDbParameter(catalog, "ItemTypeDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.item_groups.item_group_id",
            DbConfig.GetDbParameter(catalog, "ItemGroupDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.brands.brand_id",
            DbConfig.GetDbParameter(catalog, "BrandDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.parties.party_id",
            DbConfig.GetDbParameter(catalog, "PartyDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.units.unit_id",
            DbConfig.GetDbParameter(catalog, "UnitDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.sales_taxes.sales_tax_id",
            DbConfig.GetDbParameter(catalog, "SalesTaxDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.shipping_mail_types.shipping_mail_type_id",
            DbConfig.GetDbParameter(catalog, "ShippingMailTypeDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.shipping_package_shapes.shipping_package_shape_id",
            DbConfig.GetDbParameter(catalog, "ShippingPackageShapeDisplayField"));

        return string.Join(",", displayFields);
    }

    internal static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();

        ScrudHelper.AddDisplayView(displayViews, "core.item_types.item_type_id", "core.item_type_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.item_groups.item_group_id", "core.item_group_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.brands.brand_id", "core.brand_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.parties.party_id", "core.supplier_selector_view");
        ScrudHelper.AddDisplayView(displayViews, "core.units.unit_id", "core.unit_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.sales_taxes.sales_tax_id", "core.sales_tax_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.shipping_mail_types.shipping_mail_type_id",
            "core.shipping_mail_type_selector_view");
        ScrudHelper.AddDisplayView(displayViews, "core.shipping_package_shapes.shipping_package_shape_id",
            "core.shipping_package_shape_selector_view");

        return string.Join(",", displayViews);
    }
}

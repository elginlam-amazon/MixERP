@* Ported from Setup/Stores.ascx + .ascx.cs + .ascx.designer.cs - the store maintenance
   screen. OnControlLoad built a Scrud and added it to
   <asp:PlaceHolder ID="ScrudPlaceholder">, which is this markup now. NOTE the schema: the
   table and view are in `office`, while three of the five display fields point at `core`
   and `office` tables - all carried over exactly.

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <Scrud KeyColumn="store_id"
           TableSchema="office"
           Table="stores"
           ViewSchema="office"
           View="store_scrud_view"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           UseDisplayViewsAsParents="true"
           Text="@Titles.Stores" />
}

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above, which is markup now; its five
    ///     display-field lookups need the catalog, which is asynchronous.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "office.store_types.store_type_id",
            DbConfig.GetDbParameter(catalog, "StoreTypeDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.accounts.account_id",
            DbConfig.GetDbParameter(catalog, "AccountDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "office.offices.office_id",
            DbConfig.GetDbParameter(catalog, "OfficeDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "office.cash_repositories.cash_repository_id",
            DbConfig.GetDbParameter(catalog, "CashRepositoryDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.sales_taxes.sales_tax_id",
            DbConfig.GetDbParameter(catalog, "SalesTaxDisplayField"));
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "office.store_types.store_type_id", "office.store_type_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.accounts.account_id", "core.cash_account_selector_view");
        ScrudHelper.AddDisplayView(displayViews, "office.offices.office_id", "office.office_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "office.cash_repositories.cash_repository_id",
            "office.cash_repository_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.sales_taxes.sales_tax_id", "core.sales_tax_scrud_view");

        return string.Join(",", displayViews);
    }
}

@* Ported from Setup/Items.ascx - the item maintenance screen in its NORMAL, in-layout form
   (/Modules/Inventory/Setup/Items.mix).

   UPSTREAM SHAPE, PRESERVED: Items.ascx has NO code-behind and NO designer file of its own.
   Its directive declares CodeBehind="ItemsPopup.ascx.cs"
   Inherits="MixERP.Net.Core.Modules.Inventory.Setup.ItemsPopup", i.e. the screen SHARED the
   popup's code-behind and differed ONLY in its markup:

     * the wrapper is <div id="OverflowDiv"> instead of <div class="container" id="container">;
     * it declares NO MasterPageId, so it renders inside the normal backend layout, while
       ItemsPopup.ascx declares MasterPageId="MixERPBlankMaster.Master".

   Both differences are reproduced here. The Scrud configuration is therefore IDENTICAL to
   ItemsPopup's, and the two display-list builders are reused from
   ItemsPopup.GetDisplayFields/GetDisplayViews rather than duplicated - exactly the sharing
   the single shared code-behind expressed, so the two screens cannot drift.

   The original declared no OverridePath, AccessLevel, RemoveTheme or IsLandingPage override
   and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

<div id="OverflowDiv">
    @if (this.loaded)
    {
        <Scrud KeyColumn="item_id"
               TableSchema="core"
               Table="items"
               ViewSchema="core"
               View="item_scrud_view"
               DisplayFields="@this.displayFields"
               DisplayViews="@this.displayViews"
               UseDisplayViewsAsParents="true"
               ExcludeEdit="item_code, maintain_stock, item_group_id"
               Text="@Titles.Items" />
    }
</div>

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The shared legacy body (ItemsPopup.ascx.cs) ONLY built the Scrud above, which is
    ///     markup now; its eight display-field lookups need the catalog, which is asynchronous.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = ItemsPopup.GetDisplayFields(catalog);
        this.displayViews = ItemsPopup.GetDisplayViews();
        this.loaded = true;
    }
}

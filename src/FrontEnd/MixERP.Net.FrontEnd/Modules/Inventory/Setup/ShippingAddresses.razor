@* Ported from Setup/ShippingAddresses.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad built a Scrud and added it to <asp:PlaceHolder ID="ScrudPlaceholder">,
   which is this markup now.

   PRESERVED: Exclude = "shipping_address_code" (generated on the database), and the two
   display fields that are LITERAL column names rather than configured parameters
   ("country_name", "state_name") - the original mixes the two forms and both are kept
   exactly as found.

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <Scrud KeyColumn="shipping_address_id"
           TableSchema="core"
           Table="shipping_addresses"
           ViewSchema="core"
           View="shipping_address_scrud_view"
           Exclude="shipping_address_code"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           Text="@Titles.ShippingAddressMaintenance" />
}

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above, which is markup now; its display-field
    ///     lookup needs the catalog, which is asynchronous.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "core.parties.party_id",
            DbConfig.GetDbParameter(catalog, "PartyDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.countries.country_id", "country_name");
        ScrudHelper.AddDisplayField(displayFields, "core.states.state_id", "state_name");
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "core.parties.party_id", "core.party_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.countries.country_id", "core.country_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.states.state_id", "core.state_scrud_view");
        return string.Join(",", displayViews);
    }
}

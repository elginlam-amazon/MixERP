@* Ported from Confirmation/JournalVoucher.ascx + .ascx.cs + .ascx.designer.cs - the journal
   voucher CHECK LIST (verify / withdraw / print GL entry / attach).

   OnControlLoad built a `Checklist` and added it to <asp:PlaceHolder ID="Placeholder1">.
   MixERP.Net.FrontEnd.Controls.Checklist NO LONGER EXISTS: it was a one-property subclass of
   TransactionChecklistForm whose only job was setting Catalog from
   AppUsers.GetCurrentUserDB(), which returns an EMPTY catalog inside a Blazor circuit. The
   markup therefore uses <TransactionChecklistForm> directly and supplies Catalog from
   ICurrentLogin.

   PRESERVED SURFACE:
     * the control's own OverridePath = "/Modules/Finance/JournalVoucher.mix" (from the
       <%@ Control %> directive), assigned in the CONSTRUCTOR because the host's
       ModuleHost.razor reads it off an Activator.CreateInstance PROBE INSTANCE on which no
       lifecycle method ever runs;
     * the SEPARATE assignment the code-behind made onto the hosted check list,
       `checklist.OverridePath = this.OverridePath` - i.e. the SAME value, which is why the
       element below is given it explicitly rather than left to default;
     * the three ~/-rooted paths (ViewPath, AddNewPath, GlAdvicePath) verbatim, including the
       tilde: the migrated TransactionChecklistForm resolves them exactly as it did for the
       Sales/Purchase/Inventory check lists;
     * AttachmentBookName = "transaction", which is what the attachment factory keys this
       transaction's files on - changing it would orphan every existing attachment;
     * RestrictedTransactionMode = this.IsRestrictedMode, which the base computes during
       base.OnInitializedAsync().

   This is a TransactionCheckListControl (not a MixERPUserControl), as the original was. The
   original declared no AccessLevel, MasterPageId, RemoveTheme or IsLandingPage override. *@

@inherits MixERP.Net.Framework.Controls.TransactionCheckListControl
@using MixERP.Net.WebControls.TransactionChecklist
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <TransactionChecklistForm Text="@Titles.JournalVoucherEntry"
                              DisplayWithdrawButton="true"
                              DisplayPrintGlEntryButton="true"
                              DisplayAttachmentButton="true"
                              AttachmentBookName="transaction"
                              OverridePath="@this.OverridePath"
                              ViewPath="~/Modules/Finance/JournalVoucher.mix"
                              AddNewPath="~/Modules/Finance/Entry/JournalVoucher.mix"
                              GlAdvicePath="~/Modules/Finance/Reports/GLAdviceReport.mix"
                              UserId="@this.userId"
                              RestrictedTransactionMode="@this.IsRestrictedMode"
                              Catalog="@this.catalog" />
}

@code {
    private bool loaded;
    private int userId;
    private string catalog;

    public JournalVoucher()
    {
        //<%@ Control ... OverridePath="/Modules/Finance/JournalVoucher.mix" %>
        this.OverridePath = "/Modules/Finance/JournalVoucher.mix";
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the check list above, which is markup now; the user id
    ///     and the catalog are asynchronous, so they are read in OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks AND computes IsRestrictedMode,
        //which the check list below is given - never skip it, and never read IsRestrictedMode
        //before it.
        await base.OnInitializedAsync();

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.loaded = true;
    }
}

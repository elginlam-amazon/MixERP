<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MixERP.Net.Core.Modules.Finance</RootNamespace>
    <AssemblyName>MixERP.Net.Core.Modules.Finance</AssemblyName>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\..\</SolutionDir>
    <Configurations>Debug;Release;Mono-Debug;Mono-Release</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The module folder is part of the legacy web root: it holds the markup, the client scripts
         and the NuGet packages folder next to the sources, so the SDK content globs are turned off
         and only the sources are compiled. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);packages\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <!-- The GAC references the .NET Framework project carried (System, System.Data, System.Drawing,
         System.Web, System.Web.Services, System.Web.Extensions, System.Configuration,
         System.EnterpriseServices, System.Xml, ...) do not exist on modern .NET. The ones that still
         have a counterpart are supplied as packages below; the System.Web.UI and System.Web.Services
         surface has none, which is why the Web Forms and ASMX sources are excluded from the compile.
         See knowledge base docs 25, 26 and 33. -->
    <!-- ASP.NET Core SignalR lives in the shared framework rather than in a package; a class
         library has to ask for the framework explicitly. See knowledge base doc 32. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>

@* Ported from Setup/CostCenters.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad built a Scrud over office.cost_centers (note the OFFICE schema, not core) and
   added it to <asp:PlaceHolder ID="ScrudPlaceholder">, which is this markup now.

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

<Scrud KeyColumn="cost_center_id"
       TableSchema="office"
       Table="cost_centers"
       ViewSchema="office"
       View="cost_center_scrud_view"
       Text="@Titles.CostCenters" />

@code {
    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above and added it to
    ///     &lt;asp:PlaceHolder ID="ScrudPlaceholder"&gt;, which is this markup now.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }
}

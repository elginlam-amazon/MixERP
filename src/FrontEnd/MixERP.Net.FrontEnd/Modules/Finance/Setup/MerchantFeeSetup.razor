@* Ported from Setup/MerchantFeeSetup.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad built a Scrud over core.merchant_fee_setup and added it to
   <asp:PlaceHolder ID="ScrudPlaceholder">, which is this markup now. UseDisplayViewsAsParents was set, and is preserved.
   NOTE the view name: this screen reads the TABLE core.merchant_fee_setup as its view, not a
   *_scrud_view - that is what the original set and it is carried over as found.

   The display-field lookups read DbConfig.GetDbParameter(AppUsers.GetCurrentUserDB(), ...);
   that catalog is EMPTY inside a Blazor circuit, so it comes from ICurrentLogin in
   OnInitializedAsync - which is also why the Scrud renders only once `loaded` is true (the
   display fields decide which column of each parent view is shown).

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <Scrud KeyColumn="merchant_fee_setup_id"
           TableSchema="core"
           Table="merchant_fee_setup"
           ViewSchema="core"
           View="merchant_fee_setup"
           UseDisplayViewsAsParents="true"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           Text="@Titles.MerchantFeeSetup" />
}

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above, which is markup now; its display-field
    ///     lookups need the catalog, which is asynchronous.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "core.bank_accounts.account_id",
            DbConfig.GetDbParameter(catalog, "BankAccountDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.payment_cards.payment_card_id",
            DbConfig.GetDbParameter(catalog, "PaymentCardDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.accounts.account_id",
            DbConfig.GetDbParameter(catalog, "AccountDisplayField"));
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "core.bank_accounts.account_id", "core.merchant_account_selector_view");
        ScrudHelper.AddDisplayView(displayViews, "core.payment_cards.payment_card_id", "core.payment_cards");
        ScrudHelper.AddDisplayView(displayViews, "core.accounts.account_id", "core.merchant_fee_setup_account_selector_view");
        return string.Join(",", displayViews);
    }
}

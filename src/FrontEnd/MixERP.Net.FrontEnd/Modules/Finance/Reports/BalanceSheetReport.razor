@* Ported from Reports/BalanceSheetReport.ascx + .ascx.cs + .ascx.designer.cs - the printable balance sheet, opened from the Balance Sheet screen's Print button.

   `WebReport` NO LONGER EXISTS (it was a one-property Report subclass that set Catalog from
   AppUsers.GetCurrentUserDB(), which is EMPTY inside a circuit), so <Report> is hosted
   directly with Catalog from ICurrentLogin.

   AutoInitialize IS DELIBERATELY FALSE, with InitializeReport() called from OnAfterRender once
   the @@ref exists. The original pushed its parameters in BEFORE setting AutoInitialize = true;
   the migrated Report component honours AutoInitialize from OnParametersSet, which runs BEFORE
   a parent can reach the child through @@ref - so AutoInitialize="true" here would initialize
   with an EMPTY parameter collection and the report would render blank.

   this.Page.Request["X"] became ModuleQuery.Get(Navigation, "X"): a module control is rendered
   through the host's /Modules/{*path} route, so it cannot declare [SupplyParameterFromQuery],
   and there is no HttpContext over a circuit.

   This is the one Finance report with NO RunningTotalText - the original did not set it, so it
   is not supplied here either.

   PRESERVED SURFACE: MasterPageId = "MixERPReportMaster.Master" and RemoveTheme = true,
   assigned in the CONSTRUCTOR because ModuleHost.razor reads them off an Activator-created
   probe instance on which no lifecycle method runs. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using System.Collections.ObjectModel
@using System.Globalization
@using MixERP.Net.Common
@using MixERP.Net.Core.Modules.Finance.Internal
@using MixERP.Net.WebControls.ReportEngine
@using MixERP.Net.i18n.Resources
@inject NavigationManager Navigation

@if (this.loaded)
{
    <Report @ref="this.report" AutoInitialize="false" Catalog="@this.catalog" Path="@ReportFilePath" />
}

@code {
    private const string ReportFilePath = "~/Modules/Finance/Reports/Source/Transactions.BalanceSheet.xml";

    private Report report;
    private bool loaded;
    private bool initializePending;
    private string catalog;
    private int userId;
    private int officeId;

    public BalanceSheetReport()
    {
        //<%@@ Control ... MasterPageId="MixERPReportMaster.Master" RemoveTheme="true" %>
        this.MasterPageId = "MixERPReportMaster.Master";
        this.RemoveTheme = true;
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body built the report above, which is markup now, and read the query
    ///     string - which happens in OnAfterRender, where the @ref the parameters are pushed
    ///     through exists.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.officeId = login.OfficeId;

        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.loaded = true;
        this.initializePending = true;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        base.OnAfterRender(firstRender);

        if (!this.initializePending || this.report == null)
        {
            return;
        }

        this.initializePending = false;

        DateTime previousPeriod = Conversion.TryCastDate(ModuleQuery.Get(this.Navigation, "PreviousPeriod"));
        DateTime currentPeriod = Conversion.TryCastDate(ModuleQuery.Get(this.Navigation, "CurrentPeriod"));
        decimal factor = Conversion.TryCastDecimal(ModuleQuery.Get(this.Navigation, "Factor"));

        //The original's local was named parameter2 and there was no parameter1 - the name is
        //kept so the two files read alike.
        Collection<KeyValuePair<string, object>> parameter2 = new Collection<KeyValuePair<string, object>>();
        parameter2.Add(new KeyValuePair<string, object>("@PreviousPeriod", previousPeriod));
        parameter2.Add(new KeyValuePair<string, object>("@CurrentPeriod", currentPeriod));
        parameter2.Add(new KeyValuePair<string, object>("@UserId",
            this.userId.ToString(CultureInfo.InvariantCulture)));
        parameter2.Add(new KeyValuePair<string, object>("@Factor",
            factor.ToString(CultureInfo.InvariantCulture)));
        parameter2.Add(new KeyValuePair<string, object>("@OfficeId",
            this.officeId.ToString(CultureInfo.InvariantCulture)));

        this.report.ParameterCollection.Clear();
        this.report.AddParameterToCollection(parameter2);
        this.report.InitializeReport();
        this.StateHasChanged();
    }
}

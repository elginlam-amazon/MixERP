@* Ported from Reports/ProfitAndLossAccount.ascx + .ascx.cs + .ascx.designer.cs - the profit
   and loss statement.

   The screen was built procedurally (CreateHeader / CreateForm / CreateGrid) into
   <asp:PlaceHolder ID="Placeholder1">; it is markup now, in the same child order and with the
   same ids and classes: an h2, a "ui form segment" wrapping an "inline fields" div (From, To,
   Factor, the Show Compact toggle, Show, Print), then a div.auto-overflow-panel wrapping
   #PLAccountGridView.

   ⚠ #PLAccountGridView IS AN AUTO-GENERATED, POSITIONALLY-READ GRID (AutoGenerateColumns was
   on, so the columns ARE the data source's columns in its own order, headers = column names).
   js/reports/ProfitAndLossAccount.js - the .ascx's inline block, moved verbatim - reads
   `td:last, th:last` TWICE per row: the first (the real last column) is the "is summation"
   flag, tested through its INPUT's :checked state and then REMOVED; the second read then hits
   the new last column, the "is profit" flag, which is tested the same way and HIDDEN. So the
   trailing BOOLEAN column is rendered as the DISABLED CHECKBOX a GridView's auto-generated
   CheckBoxField produced. The script is loaded on the render AFTER the query.

   PlAccountGridView_RowDataBound IS REPRODUCED EXACTLY, including its WebForms side effect:
     * the HEADER's cell 0 was blanked and cell 1 was replaced with Titles.Amount;
     * for every data row it set cells 1 .. Count-2 to Text.ToFormattedNumber("{0:N}") and
       CssClass "text right". Assigning TableCell.Text CLEARS that cell's controls, so THE
       SECOND BOOLEAN COLUMN - which sits at Count-2 - had its checkbox destroyed and rendered
       EMPTY. ⚠ That means the script's "is profit" test has never matched and no row has ever
       received the `negative` class. It is preserved as found rather than "fixed": making it
       match would newly colour rows, which is a behaviour change. ToFormattedNumber also
       renders a ZERO as an EMPTY cell, which is why that helper is used.
   PlAccountGridView_DataBound only set HeaderRow.TableSection, which a real <thead> makes
   unnecessary.

   THE SHOW BUTTON IS A SERVER HANDLER (an <asp:Button> with Click -> BindGrid) and stays one.
   Its FOUR inputs are read at click time through ElementValueReader: the two dates (written by
   the jQuery UI datepicker), the factor, and #IsCompactHidden - which is written ONLY by the
   script's CompactCheckBox.change handler, so @@bind could never see it. Under WebForms all
   four arrived on the postback; reading the elements at click time is the faithful equivalent.
   ShowCompact() keeps its exact test, `value == "1"`. The PRINT button had no server handler.

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using System.Data
@using MixERP.Net.Common
@using MixERP.Net.Common.Extensions
@using MixERP.Net.Core.Modules.Finance.Internal
@using MixERP.Net.Entities
@using MixERP.Net.WebControls.Common
@using MixERP.Net.i18n.Resources
@inject IJSRuntime JS

<style>
    th[rowspan] {
        border: 1px solid #D4D4D5;
    }
</style>

<h2>@Titles.ProfitAndLossStatement</h2>

<div class="ui form segment">
    <div class="inline fields">
        <div class="field">
            <label for="FromDateTextBox">@Titles.From</label>
            <DateTextBox ID="FromDateTextBox" Mode="@(FrequencyType.FiscalYearStartDate)"
                         Catalog="@this.catalog" OfficeId="@this.officeId" @bind-Text="this.fromDate" />
        </div>
        <div class="field">
            <label for="ToDateTextBox">@Titles.To</label>
            <DateTextBox ID="ToDateTextBox" Mode="@(FrequencyType.FiscalYearEndDate)"
                         Catalog="@this.catalog" OfficeId="@this.officeId" @bind-Text="this.toDate" />
        </div>
        <div class="field">
            <label for="FactorInputText">@Titles.Factor</label>
            <input type="text" id="FactorInputText" class="small input integer" value="@this.factor" />
        </div>
        @* AddCompactCheckBoxField(): the checkbox is UNCHECKED and #IsCompactHidden starts at
           "0"; the script keeps the two in step and the server reads only the hidden field. *@
        <div class="field">
            <div class="ui checkbox">
                <input type="checkbox" id="CompactCheckBox" />
                <input type="hidden" id="IsCompactHidden" value="0" />
                <label>@Titles.ShowCompact</label>
            </div>
        </div>
        <button id="ShowButton" type="button" class="ui positive button" @onclick="this.ShowButton_Click">@Titles.Show</button>
        <input type="button" id="PrintButton" class="ui orange button" value="@Titles.Print" />
    </div>
</div>

<div class="auto-overflow-panel">
    <table id="PLAccountGridView" class="ui definition celled segment table nowrap">
        @if (this.table != null)
        {
            <thead>
                <tr>
                    @for (int i = 0; i < this.table.Columns.Count; i++)
                    {
                        <th>@this.GetHeaderText(i)</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in this.table.Rows)
                {
                    <tr>
                        @for (int i = 0; i < this.table.Columns.Count; i++)
                        {
                            @if (this.IsNumberFormatted(i))
                            {
                                <td class="text right">@GridFormat.Text(row[i]).ToFormattedNumber("{0:N}")</td>
                            }
                            else if (this.IsCheckBoxColumn(i))
                            {
                                <td>
                                    <input type="checkbox" disabled="disabled" checked="@Conversion.TryCastBoolean(row[i])" />
                                </td>
                            }
                            else
                            {
                                <td>@GridFormat.Text(row[i])</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        }
    </table>
</div>

@code {
    private const string ControllerScript =
        "_content/MixERP.Net.Core.Modules.Finance/js/reports/ProfitAndLossAccount.js";

    private ElementValueReader elementValues;

    private string catalog;
    private int officeId;
    private int userId;

    private string fromDate;
    private string toDate;
    private string factor = "1";
    private string isCompact = "0";

    private DataTable table;
    private bool bound;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body called the three Create* builders - all markup now - and then
    ///     BindGrid(), which needs the catalog and is therefore asynchronous.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        this.elementValues = new ElementValueReader(this.JS);

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.officeId = login.OfficeId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();

        //`if (!this.Page.IsPostBack) this.BindGrid();`
        this.BindGrid();
    }

    /// <summary>
    ///     OnRowDataBound's header branch: cell 0 blanked, cell 1 replaced with Titles.Amount.
    /// </summary>
    private string GetHeaderText(int index)
    {
        if (index.Equals(0))
        {
            return string.Empty;
        }

        if (index.Equals(1))
        {
            return Titles.Amount;
        }

        return this.table.Columns[index].ColumnName;
    }

    private bool IsNumberFormatted(int index)
    {
        return index > 0 && index < this.table.Columns.Count - 1;
    }

    private bool IsCheckBoxColumn(int index)
    {
        return index.Equals(this.table.Columns.Count - 1) &&
               this.table.Columns[index].DataType == typeof(bool);
    }

    private async Task ShowButton_Click()
    {
        string from = await this.elementValues.GetValueAsync("FromDateTextBox");
        string to = await this.elementValues.GetValueAsync("ToDateTextBox");
        string factorValue = await this.elementValues.GetValueAsync("FactorInputText");
        string compact = await this.elementValues.GetValueAsync("IsCompactHidden");

        if (from != null)
        {
            this.fromDate = from;
        }

        if (to != null)
        {
            this.toDate = to;
        }

        if (factorValue != null)
        {
            this.factor = factorValue;
        }

        if (compact != null)
        {
            this.isCompact = compact;
        }

        this.BindGrid();
    }

    /// <summary>
    ///     Port of ShowCompact(): the hidden field carries "1" or "0".
    /// </summary>
    private bool ShowCompact()
    {
        return this.isCompact != null && this.isCompact.Equals("1");
    }

    /// <summary>
    ///     Port of BindGrid(), verbatim - the same seven arguments in the same order.
    /// </summary>
    private void BindGrid()
    {
        DateTime from = Conversion.TryCastDate(this.fromDate);
        DateTime to = Conversion.TryCastDate(this.toDate);
        decimal factorValue = Conversion.TryCastDecimal(this.factor);

        bool compact = this.ShowCompact();

        this.table = Data.Reports.ProfitAndLossAccount.GetPLAccount(this.catalog, from, to, this.userId,
            this.officeId, compact, factorValue);
        this.bound = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (!this.bound)
        {
            return;
        }

        await ModuleScripts.LoadAsync(this.JS, ControllerScript);
    }
}

@* Ported from Reports/AccountStatementPopup.ascx - the account statement shown CHROME-FREE
   inside the pop-up window the balance sheet's balance links open
   (AccountStatementPopup.mix?AccountId=...&To=...).

   ⚠ THIS .ascx HAD NO CODE-BEHIND OF ITS OWN: it declared
       CodeBehind="AccountStatement.ascx.cs"
       Inherits="MixERP.Net.Core.Modules.Finance.Reports.AccountStatement"
   i.e. it SHARED Reports/AccountStatement's class, and there is no AccountStatementPopup.ascx.cs
   or .designer.cs in the repository. Treating it as "a control with no code-behind" would have
   silently emptied this screen - which is the balance sheet's entire drill-down. The shared
   implementation is the Internal/AccountStatementScreen component below; its AutoInitialize()
   is what reads the ?AccountId= and ?To= this popup is always opened with.

   WHAT THIS SCREEN ACTUALLY DIFFERS IN, and all of it is preserved:
     * MasterPageId = "MixERPBlankMaster.Master" - this is what renders it without the
       application chrome inside the popup window. Assigned in the CONSTRUCTOR, because
       ModuleHost.razor reads it off an Activator.CreateInstance PROBE INSTANCE on which no
       lifecycle method ever runs (and it is what selects the host's BlankLayout).
     * the <div style="padding: 24px;"> wrapper the .ascx put around the placeholder.
     * its own <style> block, identical to the sibling's.
   RemoveTheme was NOT set on this control, so it is not set here either. It DOES carry the
   same <script src="js/reports/AccountStatement.js"> as the sibling, so the script is loaded
   here too.

   The original declared no OverridePath, AccessLevel or IsLandingPage override and implemented
   no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Core.Modules.Finance.Internal
@inject IJSRuntime JS

<style type="text/css">
    #AccountOverViewGrid td:nth-child(1),
    #AccountOverViewGrid th:nth-child(1) {
        width: 200px;
    }
</style>

<div style="padding: 24px;">
    <AccountStatementScreen @ref="this.screen" />
</div>

@code {
    private const string ControllerScript =
        "_content/MixERP.Net.Core.Modules.Finance/js/reports/AccountStatement.js";

    private AccountStatementScreen screen;

    public AccountStatementPopup()
    {
        //<%@ Control ... MasterPageId="MixERPBlankMaster.Master" %>
        this.MasterPageId = "MixERPBlankMaster.Master";
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body (shared with Reports/AccountStatement) built the screen that is now
    ///     the Internal/AccountStatementScreen component above, whose own lifecycle runs the
    ///     asynchronous login/catalog lookup and AutoInitialize().
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (this.screen == null || !this.screen.Ready)
        {
            return;
        }

        await ModuleScripts.LoadAsync(this.JS, ControllerScript);
    }
}

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!--
    Converted from a net45 WebForms web-application project to a net10.0 RAZOR CLASS
    LIBRARY. Removed: ProjectTypeGuids, TargetFrameworkVersion, the Microsoft.Common.props /
    Microsoft.CSharp.targets / Microsoft.WebApplication.targets imports, the NuGet.targets
    import + EnsureNuGetPackageBuildImports target, ProjectExtensions (the IIS Express
    settings), the empty Pre/PostBuildEvent groups, every explicit Compile/Content/None/
    EmbeddedResource item (the SDK globs them), and the
    <OutputPath>..\..\bin\</OutputPath> overrides - those existed only to drop this
    assembly into the host's bin/ for WebForms assembly probing, which a ProjectReference
    now does properly.

    RootNamespace and AssemblyName are PRESERVED EXACTLY: MixERP.Net.Framework.
    DiscoveryAssemblies and the host's Services/Modules/ModuleComponentResolver.cs resolve
    module components BY TYPE NAME plus TRAILING NAMESPACE SEGMENTS, so renaming either
    would make every /Modules/** route and every dashboard widget resolve to nothing.

    The ProjectReference to the HOST (..\..\MixERP.Net.FrontEnd.csproj) is GONE. It was
    the inverted direction, which makes an RCL's components undiscoverable; the host now
    references this project. The two base classes it was needed for
    (MixERPUserControl, TransactionCheckListControl) moved to MixERP.Net.Framework and
    Scrud moved to MixERP.Net.WebControls.ScrudFactory - both already referenced below.

    VERIFIED, NOT ASSUMED: Microsoft.NET.Sdk.Razor does NOT add the Microsoft.AspNetCore.App
    framework reference on its own (project.assets.json listed only Microsoft.NETCore.App), so
    it is declared explicitly below - the same way every already-migrated
    MixERP.Net.WebControls.* RCL declares it. It is what supplies ASP.NET Core SignalR,
    replacing the dropped Microsoft.AspNet.SignalR packages.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.Core.Modules.CRM</RootNamespace>
    <AssemblyName>MixERP.Net.Core.Modules.CRM</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>../../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Carried over from the deleted Properties/AssemblyInfo.cs. -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.Core.Modules.CRM</AssemblyTitle>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.Core.Modules.CRM</Product>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <!--
      The legacy AssemblyInformationalVersion is "1.2.0.1 RC". It must NOT go into <Version>:
      <Version> is also the NuGet package version, and "1.2.0.1 RC" is not a valid version
      string, which makes NuGet's RestoreTask fail (silently, as MSB4181). It therefore goes
      into <InformationalVersion> while <Version> keeps the bare numeric form - exactly the
      convention the already-migrated sibling Modules/*.Data projects use.
    -->
    <Version>1.2.0.1</Version>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>252931b3-b4b5-4b26-a09f-99de54eecc14</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!--
    Every reference to an already-migrated library is KEPT; only the GUID/Name child
    metadata was stripped (it is meaningless to the SDK).
  -->
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ScrudFactory\MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.StockTransactionView\MixERP.Net.WebControls.StockTransactionViewFactory.csproj" />
    <ProjectReference Include="..\CRM.data\MixERP.Net.Core.Modules.CRM.data.csproj" />
  </ItemGroup>

</Project>

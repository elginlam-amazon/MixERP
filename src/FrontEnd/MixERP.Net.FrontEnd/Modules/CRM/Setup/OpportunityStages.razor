@* Ported from Setup/OpportunityStages.ascx + .ascx.cs + .ascx.designer.cs.
   The code-behind's OnControlLoad built a Scrud and added it to the ascx's
   <asp:PlaceHolder ID="ScrudPlaceholder">. Scrud is a Blazor component now
   (MixERP.Net.WebControls.ScrudFactory.Scrud), so the placeholder plus the five
   property assignments ARE this markup; the component still supplies UserId,
   UserName, OfficeCode, OfficeId and Catalog from ICurrentLogin itself.
   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme
   or IsLandingPage override, and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

<Scrud KeyColumn="opportunity_stage_id"
       TableSchema="crm"
       Table="opportunity_stages"
       ViewSchema="crm"
       View="opportunity_stages"
       Text="@Titles.OpportunityStages" />

@code {

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body of this control consisted ONLY of building the Scrud above, which is
    ///     markup now, so there is nothing left for this hook to do.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }
}

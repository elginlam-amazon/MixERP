@* Ported from Confirmation/Return.ascx + .ascx.cs + .ascx.designer.cs - the sales-return
   transaction CHECK LIST.

   `Checklist` NO LONGER EXISTS (it was a one-property TransactionChecklistForm subclass that
   set Catalog from AppUsers.GetCurrentUserDB(), which is EMPTY inside a circuit), so the
   markup uses <TransactionChecklistForm> directly with Catalog from ICurrentLogin.

   PRESERVED SURFACE - INCLUDING AN UPSTREAM ODDITY, DELIBERATELY NOT "FIXED":
     * the control's own OverridePath is "/Modules/Sales/Return.mix" (the <%@ Control %>
       directive), assigned in the CONSTRUCTOR because ModuleHost.razor reads it off an
       Activator-created probe instance;
     * the SEPARATE OverridePath the code-behind assigned onto the hosted check list is
       "~/Modules/Sales/Return.mix" - the ONLY "~"-prefixed OverridePath in the solution.
       MixERPAuthorization.VerifyAccess compares against menu.Url.Replace("~", ""), so the
       "~" on the CONTROL side is NOT stripped and the two values are not equivalent.
       It is carried across verbatim and raised separately.
     * RestrictedTransactionMode = this.IsRestrictedMode. *@

@inherits MixERP.Net.Framework.Controls.TransactionCheckListControl
@using MixERP.Net.Common
@using MixERP.Net.Core.Modules.Sales.Internal
@using MixERP.Net.Entities
@using MixERP.Net.WebControls.TransactionChecklist
@using MixERP.Net.i18n.Resources
@inject NavigationManager Navigation

@if (this.loaded)
{
    <TransactionChecklistForm Text="@Titles.SalesReturn"
                              ViewReportButtonText="@Titles.ViewThisReturn"
                              EmailReportButtonText="@Titles.EmailThisReturn"
                              PartyEmailAddress="@this.partyEmailAddress"
                              AttachmentBookName="transaction"
                              OverridePath="~/Modules/Sales/Return.mix"
                              DisplayWithdrawButton="true"
                              DisplayViewReportButton="true"
                              DisplayEmailReportButton="true"
                              DisplayPrintGlEntryButton="true"
                              DisplayAttachmentButton="true"
                              ReportPath="~/Modules/Sales/Reports/SalesReturnReport.mix"
                              GlAdvicePath="~/Modules/Finance/Reports/GLAdviceReport.mix"
                              ViewPath="~/Modules/Sales/Return.mix"
                              AddNewPath="~/Modules/Sales/Entry/Return.mix"
                              UserId="@this.userId"
                              RestrictedTransactionMode="@this.IsRestrictedMode"
                              Catalog="@this.catalog" />
}

@code {
    private bool loaded;
    private int userId;
    private string catalog;
    private string partyEmailAddress;

    public Return()
    {
        //<%@ Control ... OverridePath="/Modules/Sales/Return.mix" %>
        this.OverridePath = "/Modules/Sales/Return.mix";
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body built the check list above, which is markup now; the TranId lookup and
    ///     the two login-derived values are asynchronous, so they are read in OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks AND computes IsRestrictedMode.
        await base.OnInitializedAsync();

        long transactionMasterId = Conversion.TryCastLong(ModuleQuery.Get(this.Navigation, "TranId"));

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.partyEmailAddress = Data.Helpers.Parties.GetEmailAddress(this.catalog,
            TranBook.Sales, SubTranBook.Return, transactionMasterId);
        this.loaded = true;
    }
}

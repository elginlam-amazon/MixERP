@* Ported from Entry/Return.ascx + .ascx.cs + .ascx.designer.cs - the sales-return ENTRY
   form. OnControlLoad did TWO things:
     1. long tranId = Conversion.TryCastLong(this.Request.QueryString["TranId"]);
        if (tranId <= 0) this.Response.Redirect("~/Modules/Sales/Return.mix");
        A sales return may only be entered against an existing transaction, so a missing or
        non-positive TranId sends the user back to the sales-return LIST. Response.Redirect
        has no counterpart in a circuit: NavigationManager.NavigateTo does the same thing,
        and the form is suppressed while the redirect is pending (Response.Redirect ended
        the response, so the form never rendered in that case either).
     2. built a StockTransactionForm into <asp:PlaceHolder ID="Placeholder1"> - that
        placeholder plus its property assignments ARE the markup below.

   PRESERVED SURFACE: OverridePath = "/Modules/Sales/Return.mix" (from the <%@ Control %>
   directive, assigned in the CONSTRUCTOR because ModuleHost.razor reads it off an
   Activator-created probe instance) and ITransaction.

   Catalog / OfficeId come from ICurrentLogin - an empty login inside a circuit otherwise.
   The .ascx's <script src="..."> element moved to OnAfterRenderAsync. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@implements MixERP.Net.Entities.Contracts.ITransaction
@using MixERP.Net.Common
@using MixERP.Net.Core.Modules.Sales.Internal
@using MixERP.Net.Entities
@using MixERP.Net.WebControls.StockTransactionFactory
@using MixERP.Net.i18n.Resources
@using Microsoft.JSInterop
@inject IJSRuntime JS
@inject NavigationManager Navigation

@if (this.loaded && !this.redirecting)
{
    <StockTransactionForm Book="TranBook.Sales"
                          SubBook="SubTranBook.Return"
                          Text="@Titles.SalesReturn"
                          ShowPriceTypes="true"
                          ShowStore="true"
                          ShowSalesType="true"
                          Catalog="@this.catalog"
                          OfficeId="@this.officeId" />
}

@code {
    private bool loaded;
    private bool redirecting;
    private string catalog;
    private int officeId;

    public Return()
    {
        //<%@ Control ... OverridePath="/Modules/Sales/Return.mix" %>
        this.OverridePath = "/Modules/Sales/Return.mix";
    }

    /// <summary>
    ///     The TranId guard of the legacy OnControlLoad. It stays HERE (and not in
    ///     OnInitializedAsync) because MixERPUserControlBase raises OnControlLoad from
    ///     OnInitialized, which runs BEFORE OnInitializedAsync - the same "before anything else"
    ///     position the original check had.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
        long tranId = Conversion.TryCastLong(ModuleQuery.Get(this.Navigation, "TranId"));

        if (tranId <= 0)
        {
            this.redirecting = true;
            this.Navigation.NavigateTo("/Modules/Sales/Return.mix");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        if (this.redirecting)
        {
            return;
        }

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.officeId = login.OfficeId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender && !this.redirecting)
        {
            await ModuleScripts.LoadAsync(this.JS,
                "_content/MixERP.Net.Core.Modules.Sales/js/entry/Return.js");
        }
    }
}

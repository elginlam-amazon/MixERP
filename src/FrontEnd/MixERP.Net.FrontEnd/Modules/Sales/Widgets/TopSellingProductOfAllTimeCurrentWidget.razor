@* Ported from Widgets/TopSellingProductOfAllTimeCurrentWidget.ascx + .ascx.cs +
   .ascx.designer.cs - the dashboard PIE chart of the top selling products of all time.

   The <asp:GridView AutoGenerateColumns="False"> declared exactly TWO BoundFields,
   ItemName/item_name and TotalSales/total_sales, over the DataTable returned by
   TopSellingProducts.GetTopSellingProductsOfAllTime(catalog) - so those two columns, in
   that order, are rendered here from the DataTable by column name. That order is
   LOAD-BEARING: the host's mixerp-core.js `preparePieChart` reads td:eq(0) as the slice
   title and td:eq(1) as the slice value (its default first/second column arguments), and
   the fifth argument `true` makes it hide the table afterwards.
   DataSource/DataBind() become the @foreach.

   The <asp:Literal ID="TopSellingProductsLiteral"> + its Titles assignment become the
   inline @Titles expression, and the inline display:none the code-behind added is kept
   alongside the declared `hidden` class.

   The catalog comes from ICurrentLogin: AppUsers.GetCurrentUserDB() returns an EMPTY
   catalog inside a Blazor circuit, and a widget deriving from MixERPWidget does not inherit
   the CurrentLogin property (that is declared by MixERPUserControl).

   The inline $(document).ready(preparePieChart(...)) block moved VERBATIM to
   wwwroot/js/widgets/TopSellingProductOfAllTimeCurrentWidget.js.

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override. *@

@inherits MixERP.Net.Framework.Controls.MixERPWidget
@using System.Data
@using MixERP.Net.Core.Modules.Sales.Internal
@using MixERP.Net.Framework.Security
@using MixERP.Net.i18n.Resources
@using Microsoft.JSInterop
@inject ICurrentLogin CurrentLogin
@inject IJSRuntime JS

<div class="eight wide column widget" id="TopSellingProductOfAllTimeCurrentWidget">
    <div class="ui attached segment">
        <div class="ui left floated column">
            <div class="ui header">
                @Titles.TopSellingProductsOfAllTime
            </div>
        </div>
        <div class="right floated column">
            <i class="expand disabled icon"></i>
            <i class="move icon"></i>
            <i class="help icon"></i>
            <i class="close icon" onclick="$(this).closest('.widget').remove();"></i>
        </div>
    </div>
    <div class="ui attached segment">
        <table id="TopSellingProductsOfAllTimeGridView" class="hidden" style="display:none;">
            <thead>
                <tr>
                    <th scope="col">ItemName</th>
                    <th scope="col">TotalSales</th>
                </tr>
            </thead>
            <tbody>
                @foreach (DataRow row in this.Rows)
                {
                    <tr>
                        <td>@row["item_name"]</td>
                        <td>@row["total_sales"]</td>
                    </tr>
                }
            </tbody>
        </table>
        <canvas id="top-selling-products-canvas" width="500" height="180"></canvas>
        <div id="top-selling-products-legend"></div>
    </div>
</div>

@code {
    private DataTable table;
    private bool scriptsLoaded;

    private IEnumerable<DataRow> Rows
    {
        get
        {
            if (this.table == null)
            {
                return new List<DataRow>();
            }

            return this.table.Rows.Cast<DataRow>();
        }
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body set the Literal text (markup now) and bound the grid; the catalog the
    ///     binding needs is asynchronous, so the query moved to OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.table = Data.Reports.TopSellingProducts.GetTopSellingProductsOfAllTime(catalog);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (this.scriptsLoaded)
        {
            return;
        }

        //The chart script reads the rendered table, so it must not run before the rows are in
        //the DOM - which is the render AFTER the asynchronous query completed.
        this.scriptsLoaded = true;

        await ModuleScripts.LoadAsync(this.JS,
            "_content/MixERP.Net.Core.Modules.Sales/js/widgets/TopSellingProductOfAllTimeCurrentWidget.js");
    }
}

@* Ported from Setup/Salespersons.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad called LoadControl(), which built a Scrud and added it to the
   <asp:PlaceHolder ID="ScrudPlaceholder">. GetDisplayFields() reads the two
   *DisplayField database parameters of the CURRENT USER'S CATALOG, which is why the
   Scrud is rendered from OnInitializedAsync: AppUsers.GetCurrentUserDB() returns an
   EMPTY catalog inside a Blazor circuit, so the catalog comes from
   ICurrentLogin.GetCatalogAsync() instead.
   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <Scrud KeyColumn="salesperson_id"
           TableSchema="core"
           Table="salespersons"
           ViewSchema="core"
           View="salesperson_scrud_view"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           UseDisplayViewsAsParents="true"
           SelectedValues="@this.selectedValues"
           Text="@Titles.SalesPersons" />
}

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;
    private string selectedValues;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body (`this.LoadControl()`) built the Scrud above, and its display-field
    ///     lookups are asynchronous now, so the work moved to OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.selectedValues = GetSelectedValues();
        this.loaded = true;
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "core.accounts.account_id",
            DbConfig.GetDbParameter(catalog, "AccountDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.sales_teams.sales_team_id",
            DbConfig.GetDbParameter(catalog, "SalesTeamDisplayField"));
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "core.accounts.account_id",
            "core.salesperson_account_selector_view");
        ScrudHelper.AddDisplayView(displayViews, "core.sales_teams.sales_team_id", "core.sales_team_scrud_view");
        return string.Join(",", displayViews);
    }

    private static string GetSelectedValues()
    {
        List<string> selectedValues = new List<string>();

        //Todo:
        //The default selected value of agent account
        //should be implemented via GL Mapping.
        ScrudHelper.AddSelectedValue(selectedValues, "core.accounts.account_id", "'20100 (Accounts Payable)'");
        return string.Join(",", selectedValues);
    }
}

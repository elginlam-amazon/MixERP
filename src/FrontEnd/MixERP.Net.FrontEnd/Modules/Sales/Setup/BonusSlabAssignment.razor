@* Ported from Setup/BonusSlabAssignment.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad built a Scrud and added it to <asp:PlaceHolder ID="ScrudPlaceholder">.
   The display-field lookups read the current user's catalog, so they run in
   OnInitializedAsync through ICurrentLogin (AppUsers.GetCurrentUserDB() is empty in a
   circuit). The original declared no OverridePath, AccessLevel, MasterPageId,
   RemoveTheme or IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <Scrud KeyColumn="salesperson_bonus_setup_id"
           TableSchema="core"
           Table="salesperson_bonus_setups"
           ViewSchema="core"
           View="salesperson_bonus_setup_scrud_view"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           Text="@Titles.AgentBonusSlabAssignment" />
}

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body built the Scrud above; its display-field lookups are asynchronous
    ///     now, so the work moved to OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "core.bonus_slabs.bonus_slab_id",
            DbConfig.GetDbParameter(catalog, "BonusSlabDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.salespersons.salesperson_id",
            DbConfig.GetDbParameter(catalog, "SalespersonDisplayField"));
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "core.bonus_slabs.bonus_slab_id", "core.bonus_slab_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "core.salespersons.salesperson_id", "core.salesperson_scrud_view");
        return string.Join(",", displayViews);
    }
}

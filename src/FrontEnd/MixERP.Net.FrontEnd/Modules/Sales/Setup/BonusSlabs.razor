@* Ported from Setup/BonusSlabs.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad built a Scrud and added it to <asp:PlaceHolder ID="ScrudPlaceholder">.
   The .ascx's inline <script> (the two module-scope jQuery lookups, the
   $(document).ready call and scrudCustomValidator()) moved VERBATIM to
   wwwroot/js/setup/BonusSlabs.js - a .razor file may not contain <script>.
   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.Core.Modules.Sales.Internal
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources
@using Microsoft.JSInterop
@inject IJSRuntime JS

@if (this.loaded)
{
    <Scrud KeyColumn="bonus_slab_id"
           TableSchema="core"
           Table="bonus_slabs"
           ViewSchema="core"
           View="bonus_slab_scrud_view"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           UseDisplayViewsAsParents="true"
           Text="@Titles.AgentBonusSlabs" />
}

@code {
    private bool loaded;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body built the Scrud above; its display-field lookups are asynchronous
    ///     now, so the work moved to OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        string catalog = await this.CurrentLogin.GetCatalogAsync();

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);

        if (firstRender)
        {
            await ModuleScripts.LoadAsync(this.JS,
                "_content/MixERP.Net.Core.Modules.Sales/js/setup/BonusSlabs.js");
        }
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "core.frequencies.frequency_id",
            DbConfig.GetDbParameter(catalog, "FrequencyDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "core.accounts.account_id",
            DbConfig.GetDbParameter(catalog, "AccountDisplayField"));
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "core.frequencies.frequency_id", "core.frequency_selector_view");
        ScrudHelper.AddDisplayView(displayViews, "core.accounts.account_id", "core.bonus_slab_account_selector_view");
        return string.Join(",", displayViews);
    }
}

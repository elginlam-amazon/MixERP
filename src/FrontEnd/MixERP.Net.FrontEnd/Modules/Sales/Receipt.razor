@* Ported from Receipt.ascx + .ascx.cs + .ascx.designer.cs - the customer-receipt
   TRANSACTION LIST screen. OnControlLoad built a StockTransactionView and added it to
   <asp:PlaceHolder ID="Placeholder1">; StockTransactionView is a Blazor component now,
   so the placeholder plus the property assignments ARE this markup. This list offers no
   add/return/merge button beyond AddNewUrl.
   UserId / OfficeId / Catalog come from ICurrentLogin because AppUsers.GetCurrent() /
   GetCurrentUserDB() return an EMPTY login inside a Blazor circuit.
   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Entities
@using MixERP.Net.WebControls.StockTransactionViewFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <StockTransactionView Text="@Titles.SalesReceipt"
                          Book="TranBook.Sales"
                          SubBook="SubTranBook.Receipt"
                          AddNewUrl="~/Modules/Sales/Entry/Receipt.mix"
                          PreviewUrl="~/Modules/Sales/Reports/CustomerReceiptReport.mix"
                          ChecklistUrl="~/Modules/Sales/Confirmation/Receipt.mix"
                          DbTableName="transactions.transaction_master"
                          PrimaryKey="transaction_master_id"
                          UserId="@this.userId"
                          OfficeId="@this.officeId"
                          Catalog="@this.catalog" />
}

@code {
    private bool loaded;
    private int userId;
    private int officeId;
    private string catalog;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body built the StockTransactionView above, which is markup now; the three
    ///     login-derived values it also set are asynchronous, so they are read in
    ///     OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.officeId = login.OfficeId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.loaded = true;
    }
}

@* Ported from Order.ascx + .ascx.cs + .ascx.designer.cs - the purchase-order TRANSACTION
   LIST screen. OnControlLoad built a StockTransactionView and added it to
   <asp:PlaceHolder ID="Placeholder1">; StockTransactionView is a Blazor component now,
   so the placeholder plus the property assignments ARE this markup.

   This is a NON-GL transaction list (transactions.non_gl_stock_master), and it is the
   only Purchase list that offers the MERGE TO GRN action - the purchase mirror of the
   Sales order list's "merge to delivery".

   UserId / OfficeId / Catalog come from ICurrentLogin because AppUsers.GetCurrent() /
   GetCurrentUserDB() return an EMPTY login inside a Blazor circuit.

   The original declared no OverridePath, AccessLevel, MasterPageId, RemoveTheme or
   IsLandingPage override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Entities
@using MixERP.Net.WebControls.StockTransactionViewFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <StockTransactionView Text="@Titles.PurchaseOrder"
                          Book="TranBook.Purchase"
                          SubBook="SubTranBook.Order"
                          AddNewUrl="~/Modules/Purchase/Entry/Order.mix"
                          PreviewUrl="~/Modules/Purchase/Reports/PurchaseOrderReport.mix"
                          ChecklistUrl="~/Modules/Purchase/Confirmation/Order.mix"
                          MergeToGRNButtonUrl="~/Modules/Purchase/Entry/GRN.mix"
                          IsNonGlTransaction="true"
                          ShowMergeToGRNButton="true"
                          DbTableName="transactions.non_gl_stock_master"
                          PrimaryKey="non_gl_stock_master_id"
                          UserId="@this.userId"
                          OfficeId="@this.officeId"
                          Catalog="@this.catalog" />
}

@code {
    private bool loaded;
    private int userId;
    private int officeId;
    private string catalog;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body built the StockTransactionView above, which is markup now; the three
    ///     login-derived values it also set are asynchronous, so they are read in
    ///     OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.officeId = login.OfficeId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.loaded = true;
    }
}

@* Ported from Confirmation/Return.ascx + .ascx.cs + .ascx.designer.cs - the
   purchase-return transaction CHECK LIST (verify / withdraw / print / email).

   OnControlLoad built a `Checklist` and added it to <asp:PlaceHolder ID="Placeholder1">.
   `MixERP.Net.FrontEnd.Controls.Checklist` NO LONGER EXISTS: it was a one-property
   subclass of TransactionChecklistForm whose only job was setting Catalog from
   AppUsers.GetCurrentUserDB(), which returns an EMPTY catalog inside a Blazor circuit. The
   markup therefore uses <TransactionChecklistForm> directly and supplies Catalog from
   ICurrentLogin.

   PRESERVED SURFACE:
     * the control's own OverridePath = "/Modules/Purchase/Return.mix" (from the
       <%@ Control %> directive), assigned in the CONSTRUCTOR because the host's
       ModuleHost.razor reads it off an Activator-created PROBE INSTANCE on which no
       lifecycle method runs.
     * the SEPARATE OverridePath the code-behind assigned onto the hosted check list
       (also "/Modules/Purchase/Return.mix") - now a parameter on the element below.
       NOTE: unlike Sales/Confirmation/Return, whose check-list value is the only
       "~"-prefixed one in the codebase, the Purchase value carries NO "~" - the two
       modules genuinely differ here, and both are preserved as found.
     * RestrictedTransactionMode = this.IsRestrictedMode, which the base computes during
       base.OnInitializedAsync().

   The original declared no AccessLevel, MasterPageId, RemoveTheme or IsLandingPage
   override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.TransactionCheckListControl
@using MixERP.Net.Common
@using MixERP.Net.Core.Modules.Purchase.Internal
@using MixERP.Net.Entities
@using MixERP.Net.WebControls.TransactionChecklist
@using MixERP.Net.i18n.Resources
@inject NavigationManager Navigation

@if (this.loaded)
{
    <TransactionChecklistForm Text="@Titles.PurchaseReturn"
                              ViewReportButtonText="@Titles.ViewThisReturn"
                              EmailReportButtonText="@Titles.EmailThisReturn"
                              PartyEmailAddress="@this.partyEmailAddress"
                              AttachmentBookName="transaction"
                              OverridePath="/Modules/Purchase/Return.mix"
                              DisplayWithdrawButton="true"
                              DisplayViewReportButton="true"
                              DisplayEmailReportButton="true"
                              DisplayPrintGlEntryButton="true"
                              DisplayAttachmentButton="true"
                              ReportPath="~/Modules/Purchase/Reports/PurchaseReturnReport.mix"
                              GlAdvicePath="~/Modules/Finance/Reports/GLAdviceReport.mix"
                              ViewPath="/Modules/Purchase/Return.mix"
                              AddNewPath="/Modules/Purchase/Entry/Return.mix"
                              UserId="@this.userId"
                              RestrictedTransactionMode="@this.IsRestrictedMode"
                              Catalog="@this.catalog" />
}

@code {
    private bool loaded;
    private int userId;
    private string catalog;
    private string partyEmailAddress;

    public Return()
    {
        //<%@ Control ... OverridePath="/Modules/Purchase/Return.mix" %>
        this.OverridePath = "/Modules/Purchase/Return.mix";
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body built the check list above, which is markup now; the TranId lookup and
    ///     the two login-derived values are asynchronous, so they are read in OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks AND computes IsRestrictedMode,
        //which the check list below is given - never skip it, and never read IsRestrictedMode
        //before it.
        await base.OnInitializedAsync();

        long transactionMasterId = Conversion.TryCastLong(ModuleQuery.Get(this.Navigation, "TranId"));

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.userId = login.UserId;
        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.partyEmailAddress = Data.Helpers.Parties.GetEmailAddress(this.catalog,
            TranBook.Purchase, SubTranBook.Return, transactionMasterId);
        this.loaded = true;
    }
}

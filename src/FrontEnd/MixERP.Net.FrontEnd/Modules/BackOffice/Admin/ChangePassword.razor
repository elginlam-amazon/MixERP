@* Ported from Admin/ChangePassword.ascx + .ascx.cs + .ascx.designer.cs - the administrative
   "set another user's password" screen.

   ⚠ AccessLevel.LocalhostAdmin IS PRESERVED, and it is the STRICTEST level in the enum. This
   screen SETS AN ARBITRARY USER'S PASSWORD, so the gate is the whole point:
   MixERPAuthorization.CheckAccessLevelAsync requires an admin AND a local request (with the
   DbConfig Mode == DEVELOPMENT + IsLocalhost relaxation), and logs
   "Access to {Control} is denied to {User} from {IP}." on refusal.

   STRUCTURE. The legacy .ascx was an <asp:PlaceHolder> into which OnControlLoad added ONE
   CompositeControl, `ChangePasswordControl`, whose CreateChildControls() built the whole screen
   and whose Render() wrote only its own panel. A CompositeControl has no Blazor counterpart and
   needs none - it existed to group the controls - so its child tree is this component's markup,
   in the identical order and with the identical ids and css classes:

     div                                       (the bare HtmlGenericControl panel, no tag/class)
       > h2                                    (Titles.ChangePassword)
       > div.ui.divider                        (HtmlControlHelper.GetDivider())
       > div.ui.tiny.form.segment              (HtmlControlHelper.GetFormSegment(...))
           > div.field > label[for=UserSelect] + select#UserSelect
           > div.field > label[for=PasswordInputPassword] + input#PasswordInputPassword
           > button#UpdateButton.ui.positive.button
       > div.ui.large.green.header             (the message label)

   NOTE the panel was `new HtmlGenericControl()` with NO TagName and no attributes. WebForms
   renders a tagless HtmlGenericControl as a <span>, so a <span> is emitted - not a <div> - so
   the rendered tree is unchanged. (It is a block-level container by css, which is why nothing
   about the layout depends on it.)

   THE UPDATE BUTTON IS A REAL SERVER HANDLER and is ported as one. Its two inputs are rendered
   by this component and typed/picked by the USER, so @bind recovers them natively - no
   interop seam is needed here (unlike Policy/MenuAccess, whose hidden field is jQuery-written).
     ⚠ The legacy handler passed `this.userSelect.SelectedItem.TEXT` - the user NAME, not the
     user id - to User.SetNewPassword, while the select's VALUE was the id. That is preserved
     exactly: the bound value is the id, and the name is looked up from the same list the select
     was built from, so the argument reaching SetNewPassword is byte-identical.

   THE FOUR OUTCOMES OF UpdateButton_Click ARE ALL PRESERVED, in order: a blank user name ->
   Warnings.InvalidUser; a blank password -> Warnings.PasswordCannotBeEmpty; success ->
   Titles.PasswordUpdated in the green header; a MixERPException -> Log.Warning("Cannot change
   password. {Exception}.", ex) and the exception's own message. ShowError() also SWAPS the
   message label's class from "ui large green header" to "big error", and that swap is
   reproduced - it is how the user tells a failure from a success.

   The login-derived values are from ICurrentLogin: AppUsers.GetCurrentUserDB() (the catalog the
   user list is read from AND the catalog the password is written to) and
   AppUsers.GetCurrent().View.UserId (the AUDIT id recorded against the change) both return an
   EMPTY login inside a circuit, which would have listed no users and attributed the change to
   user 0.

   The original declared no OverridePath, MasterPageId, RemoveTheme or IsLandingPage override
   and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using System.Collections.ObjectModel
@using MixERP.Net.Common.Helpers
@using MixERP.Net.Core.Modules.BackOffice.Data.Admin
@using MixERP.Net.Common
@using MixERP.Net.Framework
@using MixERP.Net.i18n.Resources
@using Serilog

<span>
    <h2>@Titles.ChangePassword</h2>
    @((MarkupString)HtmlControlHelper.GetDivider())
    <div class="ui tiny form segment">
        <div class="field">
            <label for="UserSelect">@Titles.SelectUser</label>
            <select id="UserSelect" @bind="this.selectedUserId">
                @foreach (MixERP.Net.Entities.Office.UserSelectorView user in this.users)
                {
                    <option value="@user.UserId">@user.UserName</option>
                }
            </select>
        </div>
        <div class="field">
            <label for="PasswordInputPassword">@Titles.EnterNewPassword</label>
            <input type="password" id="PasswordInputPassword" @bind="this.password" />
        </div>
        <button id="UpdateButton" class="ui positive button" @onclick="this.UpdateButton_Click">@Titles.Update</button>
    </div>
    <div class="@this.messageCssClass">@this.message</div>
</span>

@code {
    /// <summary>The message label's class until <c>ShowError</c> swaps it.</summary>
    private const string SuccessCssClass = "ui large green header";

    /// <summary>The class <c>ShowError</c> swapped it to.</summary>
    private const string ErrorCssClass = "big error";

    /// <summary>
    ///     The legacy <c>public override AccessLevel AccessLevel</c>, carried across unchanged.
    ///     <para>
    ///         <c>MixERPUserControlBase.AccessLevel</c> is an ABSTRACT GET-ONLY property, so it is
    ///         overridden rather than assigned - which is also what the probe needs:
    ///         <c>ModuleHost.razor</c> reads the surface off an <c>Activator.CreateInstance</c>
    ///         instance on which no lifecycle method runs, and a getter answers there.
    ///     </para>
    /// </summary>
    public override AccessLevel AccessLevel
    {
        get { return AccessLevel.LocalhostAdmin; }
    }

    private IEnumerable<MixERP.Net.Entities.Office.UserSelectorView> users = new Collection<MixERP.Net.Entities.Office.UserSelectorView>();
    private string selectedUserId = string.Empty;
    private string password = string.Empty;
    private string message = string.Empty;
    private string messageCssClass = SuccessCssClass;

    private string catalog;
    private int currentUserId;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY added the ChangePasswordControl composite, whose child tree is
    ///     the markup above; everything that tree needed at build time (the user list, from the
    ///     catalog) is asynchronous and lives in OnInitializedAsync.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        MixERP.Net.Framework.Security.LoginInfo login = await this.CurrentLogin.GetLoginAsync();

        this.catalog = await this.CurrentLogin.GetCatalogAsync();
        this.currentUserId = login.UserId;

        //Was: this.userSelect.DataSource = User.GetUserSelectorView(AppUsers.GetCurrentUserDB());
        //     DataTextField = "UserName", DataValueField = "UserId"; DataBind()
        this.users = User.GetUserSelectorView(this.catalog) ??
                     (IEnumerable<MixERP.Net.Entities.Office.UserSelectorView>)new Collection<MixERP.Net.Entities.Office.UserSelectorView>();

        //A DropDownList selects its FIRST item by default, which is what the postback read when
        //the user changed nothing.
        MixERP.Net.Entities.Office.UserSelectorView first = this.users.FirstOrDefault();

        if (first != null)
        {
            this.selectedUserId = Conversion.TryCastString(first.UserId);
        }
    }

    /// <summary>
    ///     Port of <c>UpdateButton_Click</c>, outcome for outcome.
    /// </summary>
    private void UpdateButton_Click()
    {
        //Was this.userSelect.SelectedItem.Text - the user NAME, not the id. See the header.
        string username = this.GetSelectedUserName();
        string password = this.password;

        if (string.IsNullOrWhiteSpace(username))
        {
            this.ShowError(Warnings.InvalidUser);
            return;
        }

        if (string.IsNullOrWhiteSpace(password))
        {
            this.ShowError(Warnings.PasswordCannotBeEmpty);
            return;
        }

        try
        {
            User user = new User();

            user.SetNewPassword(this.catalog, this.currentUserId, username, password);

            //A success resets the label's class as well as its text: the legacy control created
            //the label with the green-header class and only ShowError ever changed it, so a
            //success after a failure must put it back.
            this.messageCssClass = SuccessCssClass;
            this.message = Titles.PasswordUpdated;
        }
        catch (MixERPException ex)
        {
            Log.Warning("Cannot change password. {Exception}.", ex);
            this.ShowError(ex.Message);
        }
    }

    /// <summary>
    ///     The TEXT of the selected option, i.e. what <c>DropDownList.SelectedItem.Text</c>
    ///     returned on the postback.
    /// </summary>
    private string GetSelectedUserName()
    {
        MixERP.Net.Entities.Office.UserSelectorView selected = this.users
            .FirstOrDefault(u => Conversion.TryCastString(u.UserId).Equals(this.selectedUserId, StringComparison.Ordinal));

        return selected == null ? null : Conversion.TryCastString(selected.UserName);
    }

    /// <summary>Port of the private <c>ShowError</c>, including the css class swap.</summary>
    private void ShowError(string message)
    {
        this.messageCssClass = ErrorCssClass;
        this.message = message;
    }
}

@* Ported from Roles.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad built a Scrud over office.roles and added it to
   <asp:PlaceHolder ID="ScrudPlaceholder">, which is this markup now.

   AccessLevel.AdminOnly IS PRESERVED. The host's
   ModuleHost.razor reads the surface properties off an Activator.CreateInstance PROBE on which
   no lifecycle method runs, and MixERPUserControl.RunAuthorizationChecksAsync then enforces the
   value through MixERPAuthorization.CheckAccessLevelAsync - which, for AdminOnly, requires
   View.IsAdmin and logs "Access to {Control} is denied to {User} from {IP}." on refusal. Losing
   it would expose this setup screen to every signed-in user.

   The original declared no OverridePath, MasterPageId, RemoveTheme, IsLandingPage or
   IsRestrictedMode override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

<Scrud KeyColumn="role_id"
       TableSchema="office"
       Table="roles"
       ViewSchema="office"
       View="role_scrud_view"
       Text="@Titles.Roles" />

@code {
    /// <summary>
    ///     The legacy <c>public override AccessLevel AccessLevel</c>, carried across unchanged.
    ///     <para>
    ///         <c>MixERPUserControlBase.AccessLevel</c> is an ABSTRACT GET-ONLY property, so it is
    ///         overridden rather than assigned - which is also what the probe needs:
    ///         <c>ModuleHost.razor</c> reads the surface off an <c>Activator.CreateInstance</c>
    ///         instance on which no lifecycle method runs, and a getter answers there.
    ///     </para>
    /// </summary>
    public override AccessLevel AccessLevel
    {
        get { return AccessLevel.AdminOnly; }
    }

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above, which is markup now, so there is
    ///     nothing procedural left to run.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }
}

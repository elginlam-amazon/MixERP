@* Ported from Users.ascx + .ascx.cs + .ascx.designer.cs.
   OnControlLoad built a Scrud over office.users and added it to
   <asp:PlaceHolder ID="Placeholder1">, which is this markup now.

   ⚠ AccessLevel.LocalhostAdmin IS PRESERVED. This is the STRICTEST level in the enum and it is
   this screen's whole server-side protection - the user table is where roles and elevation are
   assigned. MixERPAuthorization.CheckAccessLevelAsync enforces it, including the rule that a
   LocalhostAdmin screen is reachable only by an admin AND only when the request is local, with
   the DbConfig Mode == DEVELOPMENT + IsLocalhost relaxation; a refusal logs
   "Access to {Control} is denied to {User} from {IP}." Losing or weakening it would let any
   signed-in administrator edit users from anywhere.

   ⚠ THE THREE Deny* FLAGS ARE A SECOND, INDEPENDENT GATE AND ARE ALSO PRESERVED. The legacy
   body computed `bool denyToNonAdmins = !AppUsers.GetCurrent().View.IsAdmin.ToBool();` and set
   DenyAdd/DenyEdit/DenyDelete from it, so a NON-admin who somehow reached the screen still got a
   read-only form. AppUsers.GetCurrent() returns an EMPTY login inside a Blazor circuit
   (IsAdmin == false), which would have made the form permanently read-only for everyone - a
   silent regression - so IsAdmin comes from ICurrentLogin instead. That is also why the Scrud
   renders only once `loaded` is true: the flags must be known at first render, not after it.

   ExcludeEdit = "password, user_name" is preserved verbatim, spacing included: a user's login
   name may be chosen on creation but never edited, and the password is changed through
   Admin/ChangePassword, not here.

   NOTE the view is the plain "office.user_view", not a "*_scrud_view" like every sibling
   screen - that is the original's choice and is preserved. So is the UPSTREAM TYPO in the
   display-view list, which registers "office.departments.deparment_id" (missing the "t"); it
   therefore matches no column and that parent view has never been applied. Correcting it would
   newly change which column of the department parent is displayed, so it is carried across as
   found and raised separately.

   The original declared no OverridePath, MasterPageId, RemoveTheme, IsLandingPage or
   IsRestrictedMode override and implemented no ITransaction. *@

@inherits MixERP.Net.Framework.Controls.MixERPUserControl
@using MixERP.Net.Common.Helpers
@using MixERP.Net.WebControls.ScrudFactory
@using MixERP.Net.i18n.Resources

@if (this.loaded)
{
    <Scrud Text="@Titles.Users"
           TableSchema="office"
           Table="users"
           ViewSchema="office"
           View="user_view"
           KeyColumn="user_id"
           DisplayFields="@this.displayFields"
           DisplayViews="@this.displayViews"
           ExcludeEdit="password, user_name"
           DenyAdd="@this.denyToNonAdmins"
           DenyEdit="@this.denyToNonAdmins"
           DenyDelete="@this.denyToNonAdmins" />
}

@code {
    /// <summary>
    ///     The legacy <c>public override AccessLevel AccessLevel</c>, carried across unchanged.
    ///     <para>
    ///         <c>MixERPUserControlBase.AccessLevel</c> is an ABSTRACT GET-ONLY property, so it is
    ///         overridden rather than assigned - which is also what the probe needs:
    ///         <c>ModuleHost.razor</c> reads the surface off an <c>Activator.CreateInstance</c>
    ///         instance on which no lifecycle method runs, and a getter answers there.
    ///     </para>
    /// </summary>
    public override AccessLevel AccessLevel
    {
        get { return AccessLevel.LocalhostAdmin; }
    }

    private bool loaded;
    private bool denyToNonAdmins;
    private string displayFields;
    private string displayViews;

    /// <summary>
    ///     MixERPUserControlBase.OnControlLoad is abstract, so every ported control declares it.
    ///     The legacy body ONLY built the Scrud above, which is markup now; everything it
    ///     computed for that Scrud (the IsAdmin flag and the display-field lookups) needs the
    ///     login and the catalog, both of which are asynchronous.
    /// </summary>
    public override void OnControlLoad(object sender, EventArgs e)
    {
    }

    protected override async Task OnInitializedAsync()
    {
        //base.OnInitializedAsync runs BOTH authorization checks - never skip it.
        await base.OnInitializedAsync();

        LoginInfo login = await this.CurrentLogin.GetLoginAsync();
        string catalog = await this.CurrentLogin.GetCatalogAsync();

        //Was: !AppUsers.GetCurrent().View.IsAdmin.ToBool()
        this.denyToNonAdmins = !login.IsAdmin;

        this.displayFields = GetDisplayFields(catalog);
        this.displayViews = GetDisplayViews();
        this.loaded = true;
    }

    private static string GetDisplayFields(string catalog)
    {
        List<string> displayFields = new List<string>();
        ScrudHelper.AddDisplayField(displayFields, "office.offices.office_id",
            DbConfig.GetDbParameter(catalog, "OfficeDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "office.roles.role_id",
            DbConfig.GetDbParameter(catalog, "RoleDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "office.departments.department_id",
            DbConfig.GetDbParameter(catalog, "DepartmentDisplayField"));
        ScrudHelper.AddDisplayField(displayFields, "office.stores.store_id",
            DbConfig.GetDbParameter(catalog, "StoreDisplayField"));
        return string.Join(",", displayFields);
    }

    private static string GetDisplayViews()
    {
        List<string> displayViews = new List<string>();
        ScrudHelper.AddDisplayView(displayViews, "office.offices.office_id", "office.office_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "office.roles.role_id", "office.role_scrud_view");
        //⚠ UPSTREAM TYPO, PRESERVED: "deparment_id" is missing a "t", so this entry has never
        //matched a column. See the header note.
        ScrudHelper.AddDisplayView(displayViews, "office.departments.deparment_id", "office.department_scrud_view");
        ScrudHelper.AddDisplayView(displayViews, "office.stores.store_id", "office.store_scrud_view");
        return string.Join(",", displayViews);
    }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>MixERP.Net.Core.Modules.POS</AssemblyName>
    <RootNamespace>MixERP.Net.Core.Modules.POS</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <!-- Module assemblies are loaded by the FrontEnd host from its output directory (was ~/bin). -->
    <OutputPath>..\..\bin\$(Configuration)\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ScrudFactory\MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.StockTransactionView\MixERP.Net.WebControls.StockTransactionViewFactory.csproj" />
    <ProjectReference Include="..\..\MixERP.Net.FrontEnd.csproj" />
    <ProjectReference Include="..\POS.Data\MixERP.Net.Core.Modules.POS.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Pages, controls and scripts of this module are served by the FrontEnd web application. -->
    <None Remove="**" />
    <Content Remove="**" />
  </ItemGroup>
</Project>

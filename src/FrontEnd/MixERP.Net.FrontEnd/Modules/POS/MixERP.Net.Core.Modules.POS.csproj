<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <RootNamespace>MixERP.Net.Core.Modules.POS</RootNamespace>
    <AssemblyName>MixERP.Net.Core.Modules.POS</AssemblyName>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\..\</SolutionDir>
    <Configurations>Debug;Release;Mono-Debug;Mono-Release</Configurations>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The module folder is part of the legacy web root: it holds the markup, the client scripts
         and the NuGet packages folder next to the sources, so the SDK content globs are turned off
         and only the sources are compiled. -->
    <EnableDefaultContentItems>false</EnableDefaultContentItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <DefaultItemExcludes>$(DefaultItemExcludes);packages\**;bin\**</DefaultItemExcludes>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <!-- The GAC references the .NET Framework project carried (System, System.Data, System.Drawing,
         System.Web, System.Web.Services, System.Web.Extensions, System.Configuration,
         System.EnterpriseServices, System.Xml, ...) do not exist on modern .NET. The ones that still
         have a counterpart are supplied as packages below; the System.Web.UI and System.Web.Services
         surface has none, which is why the Web Forms and ASMX sources are excluded from the compile.
         See knowledge base docs 25, 26 and 33. -->
    <!-- ASP.NET Core SignalR lives in the shared framework rather than in a package; a class
         library has to ask for the framework explicitly. See knowledge base doc 32. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.ScrudFactory\MixERP.Net.WebControls.ScrudFactory.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.StockTransactionView\MixERP.Net.WebControls.StockTransactionViewFactory.csproj" />
    <ProjectReference Include="..\..\MixERP.Net.FrontEnd.csproj" />
    <ProjectReference Include="..\POS.Data\MixERP.Net.Core.Modules.POS.Data.csproj" />
  </ItemGroup>
  <!-- Web Forms / ASMX presentation layer. Neither System.Web.UI nor System.Web.Services was
       ported to modern .NET (knowledge base docs 25, 26 and 33), and there is no mechanical
       translation for a server control or a user control code-behind. The source is kept in the
       tree, shipped as content, and excluded from the net10.0 compile; the per-page re-authoring
       backlog is tracked in summary.md. -->
  <ItemGroup>
    <Compile Remove="AssignCashier.ascx.cs" />
    <Compile Remove="AssignCashier.ascx.designer.cs" />
    <Compile Remove="Index.ascx.cs" />
    <None Include="AssignCashier.ascx.cs" />
    <None Include="AssignCashier.ascx.designer.cs" />
    <None Include="Index.ascx.cs" />
  </ItemGroup>
</Project>

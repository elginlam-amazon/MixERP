<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.Core.Modules.Manufacturing</RootNamespace>
    <AssemblyName>MixERP.Net.Core.Modules.Manufacturing</AssemblyName>
    <LangVersion>latest</LangVersion>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
    <!-- Web Forms module (user controls, services, hubs) loaded by MixERP.Net.FrontEnd at runtime (see ..\Directory.Build.targets);
         it targets net10.0 only because it references the web application. -->
    <IsMixERPModule>true</IsMixERPModule>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
    <PackageReference Include="CoreWebForms.SystemWebExtensions" Version="0.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\..\Libraries\Server Controls\Project\MixERP.Net.WebControls.StockTransactionView\MixERP.Net.WebControls.StockTransactionViewFactory.csproj" />
    <ProjectReference Include="..\..\MixERP.Net.FrontEnd.csproj" />
    <ProjectReference Include="..\Manufacturing.Data\MixERP.Net.Core.Modules.Manufacturing.Data.csproj" />
  </ItemGroup>
</Project>

{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "AppSettings": {
    "IsIDE": "true",
    "SupressMissingResourceException": "true",
    "DisplayErrorDetails": "true",
    "MaxInvalidPasswordAttempts": "4",
    "ResourceDirectory": "~/Resource/",
    "ReportAPIConfigFileLocation": "~/Resource/Configuration/ReportAPI.config",
    "DbServerConfigFileLocation": "~/Resource/Configuration/DbServer.config",
    "PartyControlConfigFileLocation": "~/Resource/Configuration/PartyControl.config",
    "TransactionChecklistConfigFileLocation": "~/Resource/Configuration/TransactionChecklist.config",
    "ParameterConfigFileLocation": "~/Resource/Configuration/Parameters.config",
    "ReportConfigFileLocation": "~/Resource/Configuration/Report.config",
    "StockTransactionFactoryConfigFileLocation": "~/Resource/Configuration/StockTransactionFactory.config",
    "UpdaterConfigFileLocation": "~/Resource/Configuration/Updater.config",
    "ValidationSettings:UnobtrusiveValidationMode": "None"
  },

  "Globalization": {
    "Culture": "auto",
    "UICulture": "auto"
  },

  "SessionState": {
    "Mode": "InProc",
    "CookieMode": "UseCookies",
    "TimeoutMinutes": 60
  },

  "Authentication": {
    "LoginPath": "/SignIn.aspx",
    "DefaultPath": "/Dashboard/Index.aspx",
    "TimeoutMinutes": 60,
    "SlidingExpiration": true
  },

  "RequestLimits": {
    "MaxRequestBodyBytes": 1073741824,
    "MaxRequestLengthBytes": 1073741824
  },

  "AnonymousPaths": [
    "/bundles",
    "/static/images",
    "/Scripts"
  ],

  "StaticFiles": {
    "AdditionalContentTypes": {
      ".backup": "application/octet-stream"
    }
  }
}

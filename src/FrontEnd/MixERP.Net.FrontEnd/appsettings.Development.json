{
  // Former Web.Debug.config deltas. The legacy transform only turned on
  // <compilation debug="true"> (already the default in Development) and left
  // customErrors off, which is the ASP.NET Core developer exception page.
  // DisplayErrorDetails is repeated here with the SAME value the base file
  // carries so Site/RuntimeError's behaviour is byte-for-byte identical in
  // Development: it shows details when the server-software header is absent
  // (dev) OR when DisplayErrorDetails == "true".
  "DisplayErrorDetails": "true",
  "IsIDE": "true",
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.AspNetCore": "Information"
    }
  }
}

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows Forms / IIS installer: Windows only. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>MixERP.Net.Utility.Installer</AssemblyName>
    <RootNamespace>MixERP.Net.Utility.Installer</RootNamespace>
    <ApplicationIcon>zip_archive.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- Not part of the original build. -->
    <Compile Remove="Certificate.cs" />
    <Compile Remove="packages\**" />
    <None Remove="packages\**" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\office.sql" />
    <EmbeddedResource Include="Configs\SQL\role.sql" />
    <EmbeddedResource Include="Configs\SQL\drop-office.sql" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="zip_archive.ico" />
  </ItemGroup>
</Project>

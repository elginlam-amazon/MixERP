<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Windows-only desktop installer (Windows Forms + IIS administration), so it targets
         the Windows flavour of net10.0. EnableWindowsTargeting lets it build on Linux. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <RootNamespace>MixERP.Net.Utility.Installer</RootNamespace>
    <AssemblyName>MixERP.Net.Utility.Installer</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationIcon>zip_archive.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Not part of the legacy project (dead code kept on disk). -->
    <Compile Remove="Certificate.cs" />
    <Compile Remove="packages/**" />
    <None Remove="packages/**" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Configs/SQL/office.sql" />
    <EmbeddedResource Include="Configs/SQL/role.sql" />
    <EmbeddedResource Include="Configs/SQL/drop-office.sql" />
  </ItemGroup>

</Project>

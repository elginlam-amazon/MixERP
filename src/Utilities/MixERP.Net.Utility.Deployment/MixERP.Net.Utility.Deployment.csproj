<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MixERP.Net.Utility.Installer</RootNamespace>
    <AssemblyName>MixERP.Net.Utility.Installer</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <ApplicationIcon>zip_archive.ico</ApplicationIcon>
    <!-- This utility is a Windows Forms front end over Microsoft.Web.Administration: it creates the
         IIS site and application pool for a MixERP deployment, so it stays Windows only
         (net10.0-windows). EnableWindowsTargeting lets it be built from a non Windows machine
         (NETSDK1100); it still only runs on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\office.sql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\role.sql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\drop-office.sql" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="zip_archive.ico" />
  </ItemGroup>
</Project>
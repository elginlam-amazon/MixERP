<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MixERP.Net.Utility.Installer</RootNamespace>
    <AssemblyName>MixERP.Net.Utility.Installer</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Windows-only installer (WinForms, IIS administration); allows building it on Linux build agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>zip_archive.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\office.sql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\role.sql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\drop-office.sql" />
  </ItemGroup>
  <ItemGroup>
    <!-- Not part of the original project; kept on disk but not compiled. -->
    <Compile Remove="Certificate.cs" />
    <None Include="Certificate.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="zip_archive.ico" />
  </ItemGroup>
</Project>
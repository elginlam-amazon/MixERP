<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MixERP.Net.Utility.Installer</RootNamespace>
    <AssemblyName>MixERP.Net.Utility.Installer</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <ImportWindowsDesktopTargets>true</ImportWindowsDesktopTargets>
    <!-- Windows-only installer (WinForms + IIS administration); allow building it on non-Windows CI agents. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>zip_archive.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.Administration" Version="11.1.0" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\office.sql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\role.sql" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Configs\SQL\drop-office.sql" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="zip_archive.ico" />
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.TransactionGovernor\MixERP.Net.TransactionGovernor.csproj" />
    <ProjectReference Include="..\..\..\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\..\Data\MixERP.Net.WebControls.TransactionViewFactory.Data\MixERP.Net.WebControls.TransactionViewFactory.Data.csproj" />
    <ProjectReference Include="..\MixERP.Net.WebControls.Common\MixERP.Net.WebControls.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.WebControls.Flag\MixERP.Net.WebControls.Flag.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="TransactionViewFactory.js" />
  </ItemGroup>
  <!-- Web Forms / ASMX presentation layer. Neither System.Web.UI nor System.Web.Services was
       ported to modern .NET (knowledge base docs 25, 26 and 33), and there is no mechanical
       translation for a server control or a user control code-behind. The source is kept in the
       tree, shipped as content, and excluded from the net10.0 compile; the per-page re-authoring
       backlog is tracked in summary.md. -->
  <ItemGroup>
    <Compile Remove="Control\Buttons.cs" />
    <Compile Remove="Control\Control.cs" />
    <Compile Remove="Control\DefaultValues.cs" />
    <Compile Remove="Control\Events.cs" />
    <Compile Remove="Control\Flag.cs" />
    <Compile Remove="Control\GridPanel.cs" />
    <Compile Remove="Control\Heading.cs" />
    <Compile Remove="Control\HiddenFields.cs" />
    <Compile Remove="Control\IDisposable.cs" />
    <Compile Remove="Control\JavaScript.cs" />
    <Compile Remove="Control\SelectedValues.cs" />
    <Compile Remove="Control\TopPanel.cs" />
    <Compile Remove="Helpers\GridViewColumnHelper.cs" />
    <None Include="Control\Buttons.cs" />
    <None Include="Control\Control.cs" />
    <None Include="Control\DefaultValues.cs" />
    <None Include="Control\Events.cs" />
    <None Include="Control\Flag.cs" />
    <None Include="Control\GridPanel.cs" />
    <None Include="Control\Heading.cs" />
    <None Include="Control\HiddenFields.cs" />
    <None Include="Control\IDisposable.cs" />
    <None Include="Control\JavaScript.cs" />
    <None Include="Control\SelectedValues.cs" />
    <None Include="Control\TopPanel.cs" />
    <None Include="Helpers\GridViewColumnHelper.cs" />
  </ItemGroup>
</Project>
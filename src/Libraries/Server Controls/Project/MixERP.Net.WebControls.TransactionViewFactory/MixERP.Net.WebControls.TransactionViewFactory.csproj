    <ProjectReference Include="../../../Logic/PetaPoco/PetaPoco.csproj" />
    <ProjectReference Include="../../Data/MixERP.Net.WebControls.TransactionViewFactory.Data/MixERP.Net.WebControls.TransactionViewFactory.Data.csproj" />

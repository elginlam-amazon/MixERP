<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Nonshipping>true</Nonshipping>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.TransactionGovernor\MixERP.Net.TransactionGovernor.csproj" />
    <ProjectReference Include="..\..\..\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\..\Data\MixERP.Net.WebControls.StockTransactionView.Data\MixERP.Net.WebControls.StockTransactionViewFactory.Data.csproj" />
    <ProjectReference Include="..\MixERP.Net.WebControls.Common\MixERP.Net.WebControls.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.WebControls.Flag\MixERP.Net.WebControls.Flag.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="StockTransactionView.js" />
  </ItemGroup>

  <!-- Web Forms (System.Web.UI) is provided on .NET 10 by CoreWebForms, which ships for net9.0+ only. netstandard2.0 has no Web Forms surface, so the Web Forms sources are compiled for net10.0 only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Control\Buttons.cs" />
    <Compile Remove="Control\Buttons\AddButton.cs" />
    <Compile Remove="Control\Buttons\FlagButton.cs" />
    <Compile Remove="Control\Buttons\MergeToDeliveryButton.cs" />
    <Compile Remove="Control\Buttons\MergeToGRNButton.cs" />
    <Compile Remove="Control\Buttons\MergeToOrderButton.cs" />
    <Compile Remove="Control\Buttons\PrintButton.cs" />
    <Compile Remove="Control\Buttons\ReturnButton.cs" />
    <Compile Remove="Control\Control.cs" />
    <Compile Remove="Control\ErrorLabel.cs" />
    <Compile Remove="Control\Flag.cs" />
    <Compile Remove="Control\Form.cs" />
    <Compile Remove="Control\Form\DateFrom.cs" />
    <Compile Remove="Control\Form\DateTo.cs" />
    <Compile Remove="Control\Form\Office.cs" />
    <Compile Remove="Control\Form\Party.cs" />
    <Compile Remove="Control\Form\PriceType.cs" />
    <Compile Remove="Control\Form\ReferenceNumber.cs" />
    <Compile Remove="Control\Form\ShowButton.cs" />
    <Compile Remove="Control\Form\StatementReference.cs" />
    <Compile Remove="Control\Form\User.cs" />
    <Compile Remove="Control\Grid.cs" />
    <Compile Remove="Control\HiddenFields.cs" />
    <Compile Remove="Control\IDisposable.cs" />
    <Compile Remove="Control\Javascript.cs" />
    <Compile Remove="Control\Title.cs" />
    <Compile Remove="Control\Validation.cs" />
    <Compile Remove="Helpers\GridViewColumnHelper.cs" />
  </ItemGroup>
</Project>
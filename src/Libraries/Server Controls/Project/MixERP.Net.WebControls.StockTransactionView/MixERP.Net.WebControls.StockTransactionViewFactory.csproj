<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.StockTransactionViewFactory</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.StockTransactionViewFactory</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>../../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs.
       AssemblyTitle/Product carry the original's duplicated "Factory" suffix verbatim. -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.WebControls.StockTransactionViewFactoryFactory</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.WebControls.StockTransactionViewFactoryFactory</Product>
    <Copyright>Copyright ©  2013-2015</Copyright>
    <!-- The original AssemblyInfo.cs emitted [assembly: AssemblyConfiguration("")]. The SDK
         otherwise defaults this to $(Configuration) and would emit Debug/Release. -->
    <AssemblyConfiguration></AssemblyConfiguration>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>bd5ba8de-516b-4374-8657-d08c4dc82065</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ComponentBase, [Parameter], EventCallback and Microsoft.JSInterop (IJSRuntime) come
       from the ASP.NET Core shared framework on net10.0; the Razor SDK alone does not
       supply them. Replaces the former bare System/System.Web/System.Drawing references. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- StockTransactionView.js stays an embedded resource: JSUtility resolves it by the
       manifest name MixERP.Net.WebControls.StockTransactionViewFactory.StockTransactionView.js
       and the host serves it via JSUtility.WebResourceRoutePrefix (PartyControl precedent). -->
  <ItemGroup>
    <EmbeddedResource Include="StockTransactionView.js" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Entities/MixERP.Net.Entities.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.TransactionGovernor/MixERP.Net.TransactionGovernor.csproj" />
    <ProjectReference Include="../../../Logic/PetaPoco/PetaPoco.csproj" />
    <ProjectReference Include="../../Data/MixERP.Net.WebControls.StockTransactionView.Data/MixERP.Net.WebControls.StockTransactionViewFactory.Data.csproj" />
    <ProjectReference Include="../MixERP.Net.WebControls.Common/MixERP.Net.WebControls.Common.csproj" />
    <ProjectReference Include="../MixERP.Net.WebControls.Flag/MixERP.Net.WebControls.Flag.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../../mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

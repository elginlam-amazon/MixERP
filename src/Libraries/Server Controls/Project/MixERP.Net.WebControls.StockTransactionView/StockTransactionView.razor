@*
    Blazor replacement for the former WebForms composite server control
    "MixERP.Net.WebControls.StockTransactionViewFactory.StockTransactionView"
    (the sealed partial class formerly spread over the 25 files under Control/**).

    One component, markup + @code, no .razor.cs sidecar and NO @page: this is a
    library control, so the consuming host owns the render mode.

    The template below is the port of Control/Control.cs CreateChildControls(), in
    the SAME DOM order it produced:

        CreateTitle          -> <h2>
        CreateButtons        -> div.basic ui buttons (7 buttons)
        CreateErrorLabel     -> div.big error
        CreateFilterSegment  -> div#FilterDiv > div.ui form > div.nine fields (9 fields)
        AddGridView          -> div[overflow:auto] > <MixERPGridView ID="ProductViewGridView" />
        AddFlag              -> <Flag ElementId="FlagPopUnder" />
        LoadGridView         -> OnAfterRenderAsync(firstRender) + ShowButton/flag update
        AddJavascript        -> OnAfterRenderAsync(firstRender)
        CreateHiddenFields   -> input#SelectedValuesHidden (two-way bound)

    RecreateChildControls()/EnsureChildControls()/Render(HtmlTextWriter), the
    PlaceHolder wrapper and [ToolboxData] are dropped - see migration-summary.md
    section 2.

    *** LOAD-BEARING DOM CONTRACT - StockTransactionView.js binds by LITERAL id ***
    #PrintButton, #ShowButton, #OfficeTextBox, #SelectedValuesHidden,
    #ProductViewGridView, h2 (the print title), #FlagButton/#FlagPopUnder, plus the
    grid's column POSITIONS 2 (select checkbox) and 3 (id) - which is why the grid
    is rendered with AutoGenerateColumns="false" and the column set produced by
    GridViewColumnHelper.AddColumns. Auto-generated columns would prepend and shift
    those positions, compiling green and silently killing every selection / merge /
    flag feature.
*@

@namespace MixERP.Net.WebControls.StockTransactionViewFactory

@using System
@using System.Collections.Generic
@using System.Collections.ObjectModel
@using System.Data
@using System.Linq
@using System.Threading.Tasks
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.Extensions.Logging
@using Microsoft.JSInterop
@using MixERP.Net.Common
@using MixERP.Net.Common.Helpers
@using MixERP.Net.Entities
@using MixERP.Net.Entities.Helpers
@using MixERP.Net.Framework
@using MixERP.Net.i18n.Resources
@using MixERP.Net.WebControls.Common
@using MixERP.Net.WebControls.Flag
@using MixERP.Net.WebControls.StockTransactionViewFactory.Data
@using MixERP.Net.WebControls.StockTransactionViewFactory.Data.Helpers
@using MixERP.Net.WebControls.StockTransactionViewFactory.Data.Models
@using MixERP.Net.WebControls.StockTransactionViewFactory.Helpers

@inject IJSRuntime JSRuntime
@inject NavigationManager NavigationManager
@inject ProtectedSessionStorage SessionStorage
@inject ILogger<StockTransactionView> Logger

@* Control/Title.cs - MUST stay an h2: the print script reads $("h2").html(). *@
<h2>@this.Text</h2>

@* Control/Buttons.cs *@
<div class="basic ui buttons">
    @* Control/Buttons/AddButton.cs *@
    @if (!string.IsNullOrWhiteSpace(this.AddNewUrl))
    {
        <input type="button" id="AddNewButton" class="ui button" value="@Titles.AddNew"
               onclick="@("window.location='" + PageUtility.ResolveAbsoluteUrl(this.NavigationManager, this.AddNewUrl) + "'")" />
    }

    @* Control/Buttons/MergeToOrderButton.cs *@
    @if (this.ShowMergeToOrderButton)
    {
        <button type="button" id="MergeToOrderButton" class="ui button"
                @onclick="this.MergeToOrderButton_Click">@Titles.MergeBatchToSalesOrder</button>
    }

    @* Control/Buttons/MergeToDeliveryButton.cs *@
    @if (this.ShowMergeToDeliveryButton)
    {
        <button type="button" id="MergeToDeliveryButton" class="ui button"
                @onclick="this.MergeToDeliveryButton_Click">@Titles.MergeBatchToSalesDelivery</button>
    }

    @* Control/Buttons/MergeToGRNButton.cs *@
    @if (this.ShowMergeToGRNButton)
    {
        <button type="button" id="MergeToGRNButton" class="ui button"
                @onclick="this.MergeToGRNButton_Click">@Titles.MergeBatchToGRN</button>
    }

    @* Control/Buttons/ReturnButton.cs *@
    @if (this.ShowReturnButton)
    {
        <button type="button" id="ReturnButton" class="ui button"
                @onclick="this.ReturnButton_Click">@Titles.Return</button>
    }

    @* Control/Buttons/FlagButton.cs - the Flag component binds its popunder to this id. *@
    <input type="button" id="FlagButton" class="ui button" value="@Titles.Flag" />

    @* Control/Buttons/PrintButton.cs - the embedded JS binds the click -> printGridView. *@
    <input type="button" id="PrintButton" class="ui button" value="@Titles.Print" />
</div>

@* Control/ErrorLabel.cs - the former errorLabel HtmlGenericControl("div"). *@
<div class="big error">@this.errorMessage</div>

@* Control/Form.cs - CreateFilterSegment. *@
<div id="FilterDiv" class="ui segment">
    <div class="ui form" margin-left="8px;">
        <div class="nine fields">
            @* Control/Form/DateFrom.cs *@
            <div class="field">
                <DateTextBox ID="DateFromDateTextBox" CssClass="date" Mode="FrequencyType.FiscalYearStartDate"
                             Required="true" Catalog="@this.Catalog" OfficeId="@this.OfficeId"
                             @bind-Text="this.dateFrom" @ref="this.dateFromDateTextBox" />
            </div>

            @* Control/Form/DateTo.cs *@
            <div class="field">
                <DateTextBox ID="DateToDateTextBox" CssClass="date" Mode="FrequencyType.MonthEndDate"
                             Required="true" Catalog="@this.Catalog" OfficeId="@this.OfficeId"
                             @bind-Text="this.dateTo" @ref="this.dateToDateTextBox" />
            </div>

            @* Control/Form/Office.cs - ALT+O focuses #OfficeTextBox. *@
            <div class="field">
                <input type="text" id="OfficeTextBox" placeholder="@Titles.Office" @bind="this.office" @bind:event="oninput" />
            </div>

            @* Control/Form/Party.cs *@
            <div class="field">
                <input type="text" id="PartyTextBox" placeholder="@Titles.Party" @bind="this.party" @bind:event="oninput" />
            </div>

            @* Control/Form/PriceType.cs - rendered only when SubBook != Receipt. *@
            @if (this.SubBook != SubTranBook.Receipt)
            {
                <div class="field">
                    <input type="text" id="PriceTypeTextBox" placeholder="@Titles.PriceType" @bind="this.priceType" @bind:event="oninput" />
                </div>
            }

            @* Control/Form/User.cs *@
            <div class="field">
                <input type="text" id="UserTextBox" placeholder="@Titles.User" @bind="this.user" @bind:event="oninput" />
            </div>

            @* Control/Form/ReferenceNumber.cs *@
            <div class="field">
                <input type="text" id="ReferenceNumberTextBox" placeholder="@Titles.ReferenceNumber" @bind="this.referenceNumber" @bind:event="oninput" />
            </div>

            @* Control/Form/StatementReference.cs *@
            <div class="field">
                <input type="text" id="StatementReferenceTextBox" placeholder="@Titles.StatementReference" @bind="this.statementReference" @bind:event="oninput" />
            </div>

            @* Control/Form/ShowButton.cs - ServerClick -> @onclick; CTRL+ENTER clicks it. *@
            <button type="button" id="ShowButton" class="blue ui button" @onclick="this.LoadGridView">@Titles.Show</button>
        </div>
    </div>
</div>

@* Control/Grid.cs - AddGridView. GridLines.None is dropped (no border attributes emitted). *@
<div style="width:100%;overflow:auto;">
    <MixERPGridView ID="ProductViewGridView" CssClass="ui nowrap table" AutoGenerateColumns="false"
                    Columns="@this.columns" DataSource="@this.dataSource" />
</div>

@* Control/Flag.cs - AddFlag. ID -> ElementId, Updated event -> EventCallback. *@
<Flag ElementId="FlagPopUnder" AssociatedControlId="FlagButton" OnClientClick="return getSelectedItems();"
      CssClass="ui form segment initially hidden" Catalog="@this.Catalog" Updated="@this.Flag_Updated" />

@*
    Control/HiddenFields.cs - the former HiddenField.

    LOAD BEARING, and NOT bound. getSelectedItems() in StockTransactionView.js publishes the
    selection with $("#SelectedValuesHidden").val(...), and jQuery's .val() raises no
    input/change event, so a Blazor @bind on this element would never fire - the selection
    would never reach the server and every merge, the Return button and flag creation would
    silently operate on an empty collection. The element is therefore left unbound (so a
    re-render can never overwrite what the script wrote) and the server reads its value
    through the readSelectedValuesHidden() interop function - see GetSelectedItemsAsync()
    and RefreshSelectedValuesAsync().
*@
<input type="hidden" id="SelectedValuesHidden" name="SelectedValuesHidden" />

@code {
    #region Properties - Control/Properties.cs

    //All 21 public property names and types are FROZEN (8 dependent projects) and
    //become [Parameter]s. See migration-summary.md section 4.

    [Parameter]
    public string AddNewUrl { get; set; }

    [Parameter]
    public string Catalog { get; set; }

    [Parameter]
    public TranBook Book { get; set; }

    [Parameter]
    public string ChecklistUrl { get; set; }

    [Parameter]
    public string PreviewUrl { get; set; }

    [Parameter]
    public bool ShowMergeToDeliveryButton { get; set; }

    [Parameter]
    public string MergeToDeliveryButtonUrl { get; set; }

    [Parameter]
    public bool ShowMergeToGRNButton { get; set; }

    [Parameter]
    public string MergeToGRNButtonUrl { get; set; }

    [Parameter]
    public bool ShowMergeToOrderButton { get; set; }

    [Parameter]
    public string MergeToOrderButtonUrl { get; set; }

    [Parameter]
    public SubTranBook SubBook { get; set; }

    [Parameter]
    public string Text { get; set; }

    [Parameter]
    public string DbTableName { get; set; }

    [Parameter]
    public string PrimaryKey { get; set; }

    [Parameter]
    public bool IsNonGlTransaction { get; set; }

    [Parameter]
    public bool ShowReturnButton { get; set; }

    [Parameter]
    public string ReturnButtonUrl { get; set; }

    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public int OfficeId { get; set; }

    #endregion

    #region State - Control/IDisposable.cs

    //The 18 private WebForms child-control fields become ordinary component state.
    //No Dispose() is reproduced: a Blazor component owns no child-control tree and no
    //unmanaged resource (see migration-summary.md section 2). The PlaceHolder field is
    //gone with the composite-control render tree.

    private DateTextBox dateFromDateTextBox;
    private DateTextBox dateToDateTextBox;

    private string dateFrom;
    private string dateTo;
    //Text filters start as string.Empty (WebForms TextBox.Text was never null); the SQL
    //view filters with LIKE '%' || lower(x) || '%', so a NULL filter would match no rows.
    private string office = string.Empty;
    private string party = string.Empty;

    //Stays string.Empty when the PriceType field is not rendered (the ported null-guard
    //of "if (this.priceTypeInputText != null)").
    private string priceType = string.Empty;

    private string user = string.Empty;
    private string referenceNumber = string.Empty;
    private string statementReference = string.Empty;
    private string selectedValues;
    private string errorMessage;

    private object dataSource;
    private readonly List<MixERPGridViewColumn> columns = new List<MixERPGridViewColumn>();

    #endregion

    #region Javascript - Control/Javascript.cs

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     ALL JS interop runs from OnAfterRenderAsync and NEVER from OnInitialized:
    ///     StockTransactionView.js binds #ProductViewGridView and #PrintButton, which must
    ///     be in the DOM first. Registering it earlier is legal C#, raises no error and
    ///     leaves every client feature dead.
    ///     <para>
    ///         LoadGridView() is called on the first render (CreateChildControls() called it
    ///         before AddJavascript()), because the two DateTextBox children only publish
    ///         their initialised dates through @bind-Text after their own first render.
    ///     </para>
    ///     <para>
    ///         The re-init call is NOT inside the firstRender branch, and that is
    ///         deliberate. StateHasChanged() only QUEUES a re-render - it does not flush one
    ///         - so on the first pass the grid still has no data rows when this handler
    ///         runs. More importantly Blazor REPLACES the grid's &lt;tr&gt; set on every
    ///         later re-render (Show, a flag update, any LoadGridView()), and the script
    ///         element is injected only once per circuit, so any row binding made once at
    ///         load time is attached to rows that do not exist yet or are later discarded.
    ///         initStockTransactionView() re-wires the row click handler and re-runs
    ///         updateFlagColor() after EVERY render; it is idempotent (namespaced
    ///         .off().on(), no cached lookups), so repeat calls rebind instead of stacking
    ///         handlers. Without this, row-click selection and the flag row colours render
    ///         and silently do nothing - see migration-summary.md section 3.6a.
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            this.LoadGridView();
            this.StateHasChanged();

            this.AddJavascript();
        }

        await this.InitClientWiringAsync();

        await base.OnAfterRenderAsync(firstRender);
    }

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Calls the idempotent window.initStockTransactionView() so the grid's current rows
    ///     carry their click handler and their flag colours.
    /// </summary>
    /// <remarks>
    ///     The function is PROBED rather than called inside a blanket catch, following the
    ///     AttachmentFactory precedent. JSUtility.AddJSReference is a void, fire-and-forget
    ///     API, so on the first render the script element may not have finished loading and
    ///     "initStockTransactionView" is not defined yet - that case needs no retry, because
    ///     the script's own $(document).ready self-initialisation wires the control as soon
    ///     as it loads, and the next render calls this again. Swallowing every JSException
    ///     instead would hide a genuine throw from INSIDE the function (missing jQuery,
    ///     undefined Resources), leaving a control that renders and silently does nothing.
    /// </remarks>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private async Task InitClientWiringAsync()
    {
        bool ready = false;

        try
        {
            ready = await this.JSRuntime.InvokeAsync<bool>("eval",
                "typeof window.initStockTransactionView === 'function'");
        }
        catch (JSException)
        {
            //The circuit cannot evaluate script at all; the self-initialisation path in
            //StockTransactionView.js is the remaining route and needs no action here.
            return;
        }

        if (!ready)
        {
            return;
        }

        try
        {
            await this.JSRuntime.InvokeVoidAsync("initStockTransactionView");
        }
        catch (JSException ex)
        {
            //A real failure INSIDE initStockTransactionView (missing jQuery, undefined
            //Resources, absent toogleSelection/createFlaggedRows). It must not be silent -
            //that is the exact failure mode this guard exists to prevent.
            //
            //It is reported through ILogger, following the AttachmentFactory precedent,
            //NOT through this.errorMessage: OnAfterRenderAsync does not trigger a re-render,
            //so a field assigned here would never be painted. Calling StateHasChanged() to
            //force one is not an option either - this path runs after EVERY render, so a
            //persistent client fault would loop re-render -> re-init -> throw -> re-render.
            //The logger works from this lifecycle phase and needs no render.
            this.Logger?.LogError(ex,
                "initStockTransactionView() failed; the StockTransactionView grid will render but its row-click selection and flag row colours will not be wired.");
        }
    }

    private void AddJavascript()
    {
        JSUtility.AddJSReference(this.JSRuntime, "MixERP.Net.WebControls.StockTransactionViewFactory.StockTransactionView.js", "StockTransactionView", typeof(StockTransactionView));
    }

    #endregion

    #region Buttons - Control/Buttons/**

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     The former OnClientClick guard, "if(!getSelectedItems()){return false;};", carried
    ///     by all four merge/return buttons. Blazor attaches its @onclick through event
    ///     delegation at the document root, and returning false from an inline onclick
    ///     attribute only prevents the default action - it does NOT stop propagation - so the
    ///     inline attribute cannot cancel the server call and is not emitted. The guard is
    ///     evaluated here instead, by calling the very same client function, which both
    ///     publishes the selection into #SelectedValuesHidden and raises the "nothing
    ///     selected" notification, exactly as the original client-side cancel did, and exactly
    ///     once per click.
    /// </summary>
    /// <remarks>
    ///     The selection is then READ BACK over interop. jQuery's .val() raises no input
    ///     event, so the hidden field cannot be @bind-ed; reading it explicitly is what makes
    ///     the selection visible to GetSelectedValues() on the server.
    /// </remarks>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private async Task<bool> GetSelectedItemsAsync()
    {
        //JSUtility.AddJSReference is void/fire-and-forget, so on a very early click the
        //script element may not have finished loading and "getSelectedItems" would not be
        //defined - an unguarded invoke would throw JSException straight out of the click
        //handler and tear down the circuit. Treat "not loaded yet" as "no selection": the
        //user has not been able to tick a row either, which is exactly what the original
        //client-side guard reported.
        bool ready;

        try
        {
            ready = await this.JSRuntime.InvokeAsync<bool>("eval",
                "typeof window.getSelectedItems === 'function'");
        }
        catch (JSException)
        {
            return false;
        }

        if (!ready)
        {
            this.errorMessage = Warnings.CouldNotRegisterJavascript;
            return false;
        }

        if (!await this.JSRuntime.InvokeAsync<bool>("getSelectedItems"))
        {
            return false;
        }

        await this.RefreshSelectedValuesAsync();
        return true;
    }

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Reads #SelectedValuesHidden - what getSelectedItems() wrote on the client - into
    ///     the component's state, so GetSelectedValues() parses the current selection.
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private async Task RefreshSelectedValuesAsync()
    {
        try
        {
            this.selectedValues = await this.JSRuntime.InvokeAsync<string>("readSelectedValuesHidden");
        }
        catch (JSException)
        {
            //The reader is not available yet (fire-and-forget script injection). Leave the
            //previous value rather than tearing down the circuit; the caller's guard reports
            //"nothing selected", which is the original behaviour when no row was ticked.
            this.errorMessage = Warnings.CouldNotRegisterJavascript;
        }
    }

    private async Task MergeToOrderButton_Click()
    {
        if (!await this.GetSelectedItemsAsync())
        {
            return;
        }

        Collection<long> values = this.GetSelectedValues();

        if (this.IsValid(this.Catalog))
        {
            if (string.IsNullOrWhiteSpace(this.MergeToOrderButtonUrl))
            {
                throw new Exception(Warnings.CannotMergeUrlNull);
            }

            await this.Merge(values, this.MergeToOrderButtonUrl);
        }
    }


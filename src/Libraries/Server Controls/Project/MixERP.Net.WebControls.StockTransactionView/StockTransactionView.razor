    }

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Control/Buttons/ReturnButton.cs ReturnButton_Click.
    ///     The values[0] indexing is the ORIGINAL behaviour and is preserved as-is
    ///     (only the first selected transaction is returned).
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private async Task ReturnButton_Click()
    {
        if (!await this.GetSelectedItemsAsync())
        {
            return;
        }

        Collection<long> values = this.GetSelectedValues();

        if (string.IsNullOrWhiteSpace(this.ReturnButtonUrl))
        {
            throw new MixERPException(Warnings.ReturnButtonUrlNull);
        }

        this.NavigationManager.NavigateTo(PageUtility.ResolveAbsoluteUrl(this.NavigationManager, this.ReturnButtonUrl) + "?TranId=" + values[0]);
    }

    #endregion

    #region Grid - Control/Grid.cs

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Replaces ProductViewGridView_RowDataBound, which dug the per-row anchors back
    ///     out of e.Row.Cells[0] with FindControl("PrintAnchor") and read the transaction
    ///     id from e.Row.Cells[2].Text. The row object is now the id source and the url is
    ///     supplied to the Actions column template. A blank id - or a blank PreviewUrl -
    ///     leaves the print anchor unwired, exactly as before.
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private string GetPreviewUrl(object row)
    {
        string id = GetRowId(row);

        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(this.PreviewUrl))
        {
            return null;
        }

        return PageUtility.ResolveAbsoluteUrl(this.NavigationManager, this.PreviewUrl + "?TranId=" + id);
    }

    private string GetChecklistUrl(object row)
    {
        string id = GetRowId(row);

        if (string.IsNullOrWhiteSpace(id))
        {
            return null;
        }

        if (string.IsNullOrWhiteSpace(this.ChecklistUrl))
        {
            return null;
        }

        return PageUtility.ResolveAbsoluteUrl(this.NavigationManager, this.ChecklistUrl + "?TranId=" + id);
    }

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     The row's Id - the value the former handler read as e.Row.Cells[2].Text (the
    ///     third cell, which is the Id column). Supports both data-source shapes
    ///     MixERPGridView accepts: a DataRow or an entity.
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private static string GetRowId(object row)
    {
        if (row == null)
        {
            return null;
        }

        DataRow dataRow = row as DataRow;

        if (dataRow != null)
        {
            return dataRow.Table.Columns.Contains("Id") ? Conversion.TryCastString(dataRow["Id"]) : null;
        }

        System.Reflection.PropertyInfo property = row.GetType().GetProperty("Id");

        return property == null ? null : Conversion.TryCastString(property.GetValue(row, null));
    }

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Control/Grid.cs LoadGridView, ported verbatim.
    ///     <para>
    ///         The three-branch data-source selection ORDER is behavioural:
    ///         (a) IsNonGlTransaction, (b) Sales + Receipt, (c) everything else.
    ///     </para>
    ///     <para>
    ///         DataBind() disappears - MixERPGridView re-renders on a parameter change.
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private void LoadGridView()
    {
        // The WebForms control was rebuilt on every postback, so the error div started
        // blank on each request. errorMessage is component state and survives re-renders,
        // so it is cleared explicitly to reproduce that per-request reset - otherwise a
        // validation message would persist through every later successful interaction.
        this.errorMessage = null;

        DateTime dateFromValue = Conversion.TryCastDate(this.dateFrom);
        DateTime dateToValue = Conversion.TryCastDate(this.dateTo);
        string officeValue = this.office;
        string partyValue = this.party;

        //The PriceType field is not rendered for SubTranBook.Receipt; the value then
        //stays string.Empty, which is the ported "if (this.priceTypeInputText != null)"
        //null-guard.
        string priceTypeValue = this.SubBook == SubTranBook.Receipt ? string.Empty : this.priceType;

        string userValue = this.user;
        string referenceNumberValue = this.referenceNumber;
        string statementReferenceValue = this.statementReference;
        string bookName = TransactionBookHelper.GetInvariantTransactionBookName(this.Book, this.SubBook);

        int userId = this.UserId;
        int officeId = this.OfficeId;

        GridViewColumnHelper.AddColumns(this.columns, this.SubBook, this.GetPreviewUrl, this.GetChecklistUrl);

        if (this.IsNonGlTransaction)
        {
            this.dataSource = NonGlStockTransaction.GetView(this.Catalog, userId, bookName, officeId, dateFromValue,
                dateToValue, officeValue, partyValue, priceTypeValue, userValue, referenceNumberValue, statementReferenceValue);
            return;
        }

        if (this.Book == TranBook.Sales && this.SubBook == SubTranBook.Receipt)
        {
            this.dataSource = CustomerReceipts.GetView(this.Catalog, userId, officeId, dateFromValue, dateToValue,
                officeValue, partyValue, userValue, referenceNumberValue, statementReferenceValue);
            return;
        }

        this.dataSource = GLStockTransaction.GetView(this.Catalog, userId, bookName, officeId, dateFromValue,
            dateToValue, officeValue, partyValue, priceTypeValue, userValue, referenceNumberValue, statementReferenceValue);
    }

    #endregion

    #region Hidden fields - Control/HiddenFields.cs

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Ported verbatim, including the Conversion.TryCastInteger parse and the val > 0
    ///     filter, reading what getSelectedItems() wrote into #SelectedValuesHidden.
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private Collection<long> GetSelectedValues()
    {
        string selected = this.selectedValues;

        if (string.IsNullOrWhiteSpace(selected))
        {
            return new Collection<long>();
        }

        Collection<long> values = new Collection<long>();

        foreach (string value in selected.Split(','))
        {
            int val = Conversion.TryCastInteger(value);

            if (val > 0)
            {
                values.Add(val);
            }
        }

        return values;
    }

    #endregion

    #region Flag - Control/Flag.cs

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Control/Flag.cs Flag_Updated.
    ///     <para>
    ///         The Flag component's OnClientClick ("return getSelectedItems();") publishes the
    ///         selection into #SelectedValuesHidden on the client, but jQuery's .val() raises
    ///         no event, so the selection is read back over interop here before
    ///         GetSelectedValues() parses it. Without the refresh the flag would be created
    ///         against an empty collection and report success.
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private async Task Flag_Updated(FlagUpdatedEventArgs e)
    {
        if (e == null)
        {
            return;
        }

        await this.RefreshSelectedValuesAsync();

        int flagTypeId = e.FlagId;

        string resource = this.DbTableName;
        string resourceKey = this.PrimaryKey;

        if (string.IsNullOrWhiteSpace(resource))
        {
            throw new MixERPException(Warnings.CannotCreateFlagTransactionTableNull);
        }

        if (string.IsNullOrWhiteSpace(resourceKey))
        {
            throw new MixERPException(Warnings.CannotCreateFlagTransactionTablePrimaryKeyNull);
        }

        Flags.CreateFlag(this.Catalog, this.UserId, flagTypeId, resource, resourceKey, this.GetSelectedValues().Select(t => Conversion.TryCastString(t)).ToList().ToCollection());

        this.LoadGridView();
    }

    #endregion

    #region Merger - Control/Merger.cs

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Control/Merger.cs Merge(ids, link).
    ///     <para>
    ///         HttpContext.Current is NULL over the SignalR circuit, so
    ///         Session["Product"] = model becomes
    ///         ProtectedSessionStorage.SetAsync("Product", model) and
    ///         Response.Redirect(link) becomes NavigationManager.NavigateTo(link).
    ///         The storage KEY is unchanged ("Product") - see migration-summary.md
    ///         section 5: the Entry pages that used to read Session["Product"] must read
    ///         it back with ProtectedSessionStorage.GetAsync&lt;MergeModel&gt;("Product").
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private async Task Merge(Collection<long> ids, string link)
    {
        MergeModel model = ModelFactory.GetMergeModel(this.Catalog, ids, this.Book, this.SubBook);

        if (model.View == null)
        {
            return;
        }

        if (model.View.Count.Equals(0))
        {
            return;
        }

        await this.SessionStorage.SetAsync("Product", model);

        // Consumers pass app-relative targets ("~/Modules/Sales/Entry/Order.mix"). The
        // original Response.Redirect resolved "~/"; NavigationManager does not, so resolve
        // it here or the browser is sent to a literal "~/..." path.
        this.NavigationManager.NavigateTo(PageUtility.ResolveAbsoluteUrl(this.NavigationManager, link));
    }

    #endregion

    #region Validation - Control/Validation.cs

    ////////////////////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     The short-circuit ORDER is behavioural and preserved exactly:
    ///     nothing-selected -> BelongToSameParty -> AreAlreadyMerged -> ContainsIncompatibleTaxes.
    ///     Every former "errorLabel.InnerText = ..." assignment now sets errorMessage,
    ///     which div.big error renders.
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////////////////////
    private bool IsValid(string catalog)
    {
        // Per-request reset - see LoadGridView(). A stale message from an earlier failed
        // attempt must not survive into a later successful one.
        this.errorMessage = null;

        Collection<long> values = this.GetSelectedValues();

        if (values.Count.Equals(0))
        {
            this.errorMessage = Warnings.NothingSelected;
            return false;
        }

        if (!this.BelongToSameParty(catalog, values))
        {
            return false;
        }

        if (this.AreAlreadyMerged(catalog, values))
        {
            return false;
        }

        if (this.ContainsIncompatibleTaxes(catalog, values))
        {
            return false;
        }

        return true;
    }

    private bool BelongToSameParty(string catalog, Collection<long> values)
    {
        bool belongToSameParty = NonGlStockTransaction.TransactionIdsBelongToSameParty(catalog, values);

        if (!belongToSameParty)
        {
            this.errorMessage = Warnings.CannotMergeDifferentPartyTransaction;
            return false;
        }

        return true;
    }

    private bool AreAlreadyMerged(string catalog, Collection<long> values)
    {
        if (this.AreSalesQuotationsAlreadyMerged(catalog, values))
        {
            return true;
        }

        if (this.AreSalesOrdersAlreadyMerged(catalog, values))
        {
            return true;
        }

        return false;
    }

    private bool AreSalesQuotationsAlreadyMerged(string catalog, Collection<long> values)
    {
        if (this.Book == TranBook.Sales && this.SubBook == SubTranBook.Quotation)
        {
            if (NonGlStockTransaction.AreSalesQuotationsAlreadyMerged(catalog, values))
            {
                this.errorMessage = Warnings.CannotMergeAlreadyMerged;
                return true;
            }
        }

        return false;
    }

    private bool AreSalesOrdersAlreadyMerged(string catalog, Collection<long> values)
    {
        if (this.Book == TranBook.Sales && this.SubBook == SubTranBook.Order)
        {
            if (NonGlStockTransaction.AreSalesOrdersAlreadyMerged(catalog, values))
            {
                this.errorMessage = Warnings.CannotMergeAlreadyMerged;
                return true;
            }
        }

        return false;
    }

    private bool ContainsIncompatibleTaxes(string catalog, Collection<long> values)
    {
        if (this.Book == TranBook.Sales)
        {
            if (NonGlStockTransaction.ContainsIncompatibleTaxes(catalog, values))
            {
                this.errorMessage = Warnings.CannotMergeIncompatibleTax;
                return true;
            }
        }

        return false;
    }

    #endregion
}

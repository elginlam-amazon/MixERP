<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>MixERP.Net.WebControls.ReportEngine</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.ReportEngine</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\Data\MixERP.Net.WebControls.ReportEngine.Data\MixERP.Net.WebControls.ReportEngine.Data.csproj" />
    <ProjectReference Include="..\MixERP.Net.WebControls.Common\MixERP.Net.WebControls.Common.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripts\ReportEngine.QRCode.js" />
    <EmbeddedResource Include="Scripts\JQueryQRcode\jquery.qrcode.js" />
    <EmbeddedResource Include="Scripts\JQueryQRcode\qrcode.js" />
    <EmbeddedResource Include="Scripts\ReportEngine.Barcode.js" />
    <EmbeddedResource Include="Scripts\JsBarcode\CODE128.js" />
    <EmbeddedResource Include="Scripts\JsBarcode\CODE39.js" />
    <EmbeddedResource Include="Scripts\JsBarcode\EAN_UPC.js" />
    <EmbeddedResource Include="Scripts\JsBarcode\ITF.js" />
    <EmbeddedResource Include="Scripts\JsBarcode\ITF14.js" />
    <EmbeddedResource Include="Scripts\JsBarcode\JsBarcode.js" />
  </ItemGroup>
</Project>

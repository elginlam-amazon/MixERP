<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.ReportEngine</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.ReportEngine</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>../../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.WebControls.ReportEngine</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.WebControls.ReportEngine</Product>
    <Copyright>Copyright ©  2013-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>eb4f067e-9da2-464a-8138-a956b91f87c6</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ComponentBase, [Parameter], EventCallback and Microsoft.JSInterop (IJSRuntime) come
       from the ASP.NET Core shared framework on net10.0; the Razor SDK alone does not
       supply them. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Replaces the legacy bare <Reference>s to Serilog / Serilog.FullNetFx
       (packages/Serilog.1.5.7). Serilog.FullNetFx has no modern equivalent; the static
       Log API used by Helpers/XmlHelper.cs ships in the Serilog package itself. -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <!-- Added during migration: AppState.CurrentUserName replaces
         HttpContext.Current.User.Identity.Name in Helpers/ReportParser.cs. -->
    <ProjectReference Include="../../../Logic/MixER.Net.StateServer/MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="../../Data/MixERP.Net.WebControls.ReportEngine.Data/MixERP.Net.WebControls.ReportEngine.Data.csproj" />
    <ProjectReference Include="../MixERP.Net.WebControls.Common/MixERP.Net.WebControls.Common.csproj" />
  </ItemGroup>

  <!-- Logical resource names are runtime string keys for the
       /_mixerp/script/{assemblyName}/{resourceName} endpoint and the 10
       [assembly: WebResource] names. Do NOT rename. -->
  <ItemGroup>
    <EmbeddedResource Include="Scripts/ReportEngine.QRCode.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.ReportEngine.QRCode.js" />
    <EmbeddedResource Include="Scripts/JQueryQRcode/jquery.qrcode.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JQueryQRcode.jquery.qrcode.js" />
    <EmbeddedResource Include="Scripts/JQueryQRcode/qrcode.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JQueryQRcode.qrcode.js" />
    <EmbeddedResource Include="Scripts/ReportEngine.Barcode.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.ReportEngine.Barcode.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/CODE128.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JsBarcode.CODE128.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/CODE39.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JsBarcode.CODE39.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/EAN_UPC.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JsBarcode.EAN_UPC.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/ITF.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JsBarcode.ITF.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/ITF14.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JsBarcode.ITF14.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/JsBarcode.js" LogicalName="MixERP.Net.WebControls.ReportEngine.Scripts.JsBarcode.JsBarcode.js" />
    <Content Include="Scripts/JsBarcode/MIT-LICENSE.txt" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../../mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.ReportEngine</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.ReportEngine</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Serilog" Version="4.4.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <ProjectReference Include="../../Data/MixERP.Net.WebControls.ReportEngine.Data/MixERP.Net.WebControls.ReportEngine.Data.csproj" />
    <ProjectReference Include="../MixERP.Net.WebControls.Common/MixERP.Net.WebControls.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Scripts/ReportEngine.QRCode.js" />
    <EmbeddedResource Include="Scripts/JQueryQRcode/jquery.qrcode.js" />
    <EmbeddedResource Include="Scripts/JQueryQRcode/qrcode.js" />
    <EmbeddedResource Include="Scripts/ReportEngine.Barcode.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/CODE128.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/CODE39.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/EAN_UPC.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/ITF.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/ITF14.js" />
    <EmbeddedResource Include="Scripts/JsBarcode/JsBarcode.js" />
  </ItemGroup>

  <!-- Web Forms sources (System.Web.UI server controls, pages, user controls, designer
       files) that have no ASP.NET Core equivalent and still need the per-control/per-page
       Blazor rewrite tracked in summary.md. They are kept in the tree, unchanged, as the
       reference for that rewrite, but are not compiled. -->
  <ItemGroup Label="PendingWebFormsRewrite">
    <Compile Remove="Helpers/ReportParser.cs" />
    <None Include="Helpers/ReportParser.cs" />
    <Compile Remove="Report/Body.cs" />
    <None Include="Report/Body.cs" />
    <Compile Remove="Report/CommandPanel.cs" />
    <None Include="Report/CommandPanel.cs" />
    <Compile Remove="Report/Control.cs" />
    <None Include="Report/Control.cs" />
    <Compile Remove="Report/Events.cs" />
    <None Include="Report/Events.cs" />
    <Compile Remove="Report/HiddenControls.cs" />
    <None Include="Report/HiddenControls.cs" />
    <Compile Remove="Report/IDisposable.cs" />
    <None Include="Report/IDisposable.cs" />
    <Compile Remove="Report/Intializer.cs" />
    <None Include="Report/Intializer.cs" />
    <Compile Remove="Report/Javascript.cs" />
    <None Include="Report/Javascript.cs" />
    <Compile Remove="Report/Properties.cs" />
    <None Include="Report/Properties.cs" />
    <Compile Remove="ReportHeader/Control.cs" />
    <None Include="ReportHeader/Control.cs" />
    <Compile Remove="ReportHeader/Events.cs" />
    <None Include="ReportHeader/Events.cs" />
    <Compile Remove="ReportHeader/Properties.cs" />
    <None Include="ReportHeader/Properties.cs" />
    <Compile Remove="ReportHeader/RaisedEvents.cs" />
    <None Include="ReportHeader/RaisedEvents.cs" />
  </ItemGroup>

</Project>

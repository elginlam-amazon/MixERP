<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.AttachmentFactory</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.AttachmentFactory</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.WebControls.AttachmentFactory</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.WebControls.AttachmentFactory</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>555e40bb-7f0b-427f-8ee1-ebb0f927f3db</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Both scripts intentionally stay EmbeddedResources: MixERP.Net.Common's JSUtility
       resolves them by their manifest resource names
       "MixERP.Net.WebControls.AttachmentFactory.AttachmentFactory.js" and
       "MixERP.Net.WebControls.AttachmentFactory.ajax-file-upload.js", and the host serves
       them through the JSUtility.WebResourceRoutePrefix ("/_mixerp/script") endpoint. -->
  <ItemGroup>
    <EmbeddedResource Include="AttachmentFactory.js" />
    <EmbeddedResource Include="ajax-file-upload.js" />
  </ItemGroup>

  <!-- ComponentBase, Microsoft.JSInterop (IJSRuntime/JSException), IFormFile,
       IEndpointRouteBuilder and IWebHostEnvironment come from the ASP.NET Core shared
       framework on net10.0. The Razor SDK alone does not supply them. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\..\Logic\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.AttachmentFactory</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.AttachmentFactory</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Logic/MixER.Net.StateServer/MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Entities/MixERP.Net.Entities.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <ProjectReference Include="../../../Logic/PetaPoco/PetaPoco.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="AttachmentFactory.js" />
    <EmbeddedResource Include="ajax-file-upload.js" />
  </ItemGroup>

  <!-- Web Forms sources (System.Web.UI server controls, pages, user controls, designer
       files) that have no ASP.NET Core equivalent and still need the per-control/per-page
       Blazor rewrite tracked in summary.md. They are kept in the tree, unchanged, as the
       reference for that rewrite, but are not compiled. -->
  <ItemGroup Label="PendingWebFormsRewrite">
    <Compile Remove="Attachment/Buttons.cs" />
    <None Include="Attachment/Buttons.cs" />
    <Compile Remove="Attachment/Control.cs" />
    <None Include="Attachment/Control.cs" />
    <Compile Remove="Attachment/HiddenFields.cs" />
    <None Include="Attachment/HiddenFields.cs" />
    <Compile Remove="Attachment/IDisposable.cs" />
    <None Include="Attachment/IDisposable.cs" />
    <Compile Remove="Attachment/Javascript.cs" />
    <None Include="Attachment/Javascript.cs" />
    <Compile Remove="Attachment/Persmission.cs" />
    <None Include="Attachment/Persmission.cs" />
    <Compile Remove="Attachment/Properties.cs" />
    <None Include="Attachment/Properties.cs" />
    <Compile Remove="Attachment/Upload Panel/HeaderRow.cs" />
    <None Include="Attachment/Upload Panel/HeaderRow.cs" />
    <Compile Remove="Attachment/Upload Panel/Row.cs" />
    <None Include="Attachment/Upload Panel/Row.cs" />
    <Compile Remove="Attachment/UploadPanel.cs" />
    <None Include="Attachment/UploadPanel.cs" />
    <Compile Remove="Attachment/WarningLabel.cs" />
    <None Include="Attachment/WarningLabel.cs" />
  </ItemGroup>

</Project>

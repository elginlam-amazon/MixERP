    [Parameter]
    public string EditButtonIconCssClass { get; set; }

    [Parameter]
    public string ErrorCssClass { get; set; }

    /// <summary>
    ///     Comma separated list of columns to exclude for CRUD operation.
    /// </summary>
    [Parameter]

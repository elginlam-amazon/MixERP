    ////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Port of <c>CreatePager(Control container)</c>: page size, total record count, the
    ///     current page (defaulting to 1), the three pager css classes and the hardcoded block
    ///     count of 10 - and the early return that rendered NO pager at all when the view has no
    ///     rows or fits on one page.
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////
    private RenderFragment CreatePager()
    {
        int pageSize = this.GetPageSize();
        int totalRecords = FormHelper.GetTotalRecords(this.Catalog, this.ViewSchema, this.View);

        int currentPage = Conversion.TryCastInteger(this.GetQueryStringValue("page"));

        if (currentPage.Equals(0))
        {
            currentPage = 1;
        }

        string cssClass = this.GetPagerCssClass();
        string activeCssClass = this.GetPagerCurrentPageCssClass();
        string itemCssClass = this.GetPagerPageButtonCssClass();

        if (totalRecords == 0 || pageSize > totalRecords)
        {
            return null;
        }

        const int blockCount = 10; //This can be parameterized.

        return this.CreatePager(pageSize, totalRecords, currentPage, blockCount, cssClass, activeCssClass, itemCssClass);
    }

    ////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Port of the 8-argument <c>CreatePager</c> overload. The <c>container</c> argument is
    ///     gone (there is no control collection to add to); the <c>ScrudPager</c> model is built
    ///     with exactly the same ten values and its <c>GetPager()</c> now returns a
    ///     <c>RenderFragment</c>.
    ///     <para>
    ///         <c>QueryString</c> must have NO leading '?' - <c>ScrudPager</c> compares it against
    ///         the exact literal "modal=1&amp;CallBackFunctionName=..." to decide whether to carry
    ///         the item-selector popup's callback parameters into every page link.
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////
    private RenderFragment CreatePager(int pageSize, int totalRecords, int currentPage, int blockCount, string cssClass, string activeCssClass, string itemCssClass)
    {
        string queryString = this.GetQueryString();

        ScrudPager scrudPager = new ScrudPager
        {
            TotalRecords = totalRecords,
            CurrentPage = currentPage,
            PageSize = pageSize,
            BlockCount = blockCount,
            CssClass = cssClass,
            ActiveCssClass = activeCssClass,
            ItemCssClass = itemCssClass,
            CurrentPageUrl = this.GetCurrentPageUrl(),
            QueryString = queryString
        };

        return scrudPager.GetPager();
    }


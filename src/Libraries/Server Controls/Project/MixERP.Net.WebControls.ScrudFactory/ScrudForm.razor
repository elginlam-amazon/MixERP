    /// <summary>
    ///     Port of <c>LoadGrid()</c>: bind the grid, then apply its width and the
    ///     <c>white-space: nowrap</c> style. The two hidden fields it also refreshed are rendered
    ///     straight from <c>UserId</c>/<c>OfficeCode</c> above, so there is nothing to re-assign.
    /// </summary>
    private void LoadGrid()
    {
        this.BindGridView();
    }

    ////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Port of <c>BindGridView()</c>. The <c>limit</c>/<c>offset</c> arithmetic is verbatim,
    ///     including the default limit of 10 and <c>offset = (page - 1) * limit</c>;
    ///     <c>this.Page.Request["page"]</c> becomes a <c>NavigationManager</c> read. A negative
    ///     limit (<c>MaxRowLimit = -1</c> with <c>show=all</c>) reaches
    ///     <c>FormHelper.GetView</c>, which drops the LIMIT/OFFSET clause - the "all rows" branch.
    ///     <para>
    ///         The explicit <c>DataBind()</c> disappears: <c>DataSource</c> is a
    ///         <c>[Parameter]</c> on the migrated grid and Blazor re-renders on change. The
    ///         <c>DataTable</c> is NOT disposed here (the original's <c>using</c> block was safe
    ///         only because <c>DataBind()</c> had already copied the rows into the control tree);
    ///         it stays alive as long as it is the grid's data source.
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////
    private void BindGridView()
    {
        var limit = 10;
        var offset = 0;

        if (this.GetPageSize() != 0)
        {
            limit = this.GetPageSize();
        }

        string page = this.GetQueryStringValue("page");

        if (page != null)
        {
            offset = (Conversion.TryCastInteger(page) - 1) * limit;
        }

        string key = string.Format(CultureInfo.InvariantCulture, "{0}|{1}|{2}", this.GetQueryString(), limit, offset);

        if (this.gridDataSource != null && key.Equals(this.gridKey, StringComparison.Ordinal))
        {
            return;
        }

        this.gridKey = key;
        this.gridDataSource = FormHelper.GetView(this.Catalog, this.ViewSchema, this.View, this.KeyColumn, limit, offset);
        this.gridColumns = this.BuildGridColumns();
    }

    ////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     The column set <c>AddGridView</c> + <c>FormGridView_RowDataBound</c>'s header branch
    ///     produced: a 20px-wide, header-less select column FIRST (its <c>Template</c> renders the
    ///     per-row <c>#SelectRadio</c>), then one column per view column whose header text is run
    ///     through <c>ScrudLocalizationHelper.GetResourceString(resourceClassName, columnName)</c>.
    ///     <para>
    ///         <c>AutoGenerateColumns</c> is false on the component because <c>MixERPGridView</c>
    ///         APPENDS an explicit column set after the generated one, which would put the select
    ///         column last; building the list here keeps the legacy order (and therefore the
    ///         Cells[0]/Cells[1] relationship Scrud.js and the radio template rely on).
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////
    private IReadOnlyList<MixERPGridViewColumn> BuildGridColumns()
    {
        List<MixERPGridViewColumn> columns = new List<MixERPGridViewColumn>();

        MixERPGridViewColumn selectColumn = new MixERPGridViewColumn();
        selectColumn.HeaderText = string.Empty;
        selectColumn.CssClass = "select-cell";
        selectColumn.HeaderCssClass = "select-cell";
        selectColumn.Template = this.GetSelectColumnTemplate();

        columns.Add(selectColumn);

        if (this.gridDataSource != null)
        {
            string resourceClassName = this.GetResourceClassName();

            foreach (DataColumn column in this.gridDataSource.Columns)
            {
                MixERPGridViewColumn gridColumn = new MixERPGridViewColumn(column.ColumnName, ScrudLocalizationHelper.GetResourceString(resourceClassName, column.ColumnName), column.DataType);

                columns.Add(gridColumn);
            }
        }

        return columns;
    }

    /// <summary>
    ///     Port of <c>CreateGridPanel()</c>'s inline style: the panel's <c>Width</c> (a CSS length
    ///     string now - task 15) followed by the <c>GridPanelStyle</c> the original added as a
    ///     <c>style</c> attribute. Both are emitted only when a value is actually set, and the
    ///     <c>display</c> the server-side alerts toggle is appended last so it wins.
    /// </summary>
    private string GetGridPanelInlineStyle()
    {
        string style = string.Empty;

        string width = this.GetGridPanelWidth();

        if (!string.IsNullOrWhiteSpace(width))
        {
            style += "width:" + width + ";";
        }

        string custom = this.GetGridPanelStyle();

        if (!string.IsNullOrWhiteSpace(custom))
        {
            style += custom;

            if (!custom.TrimEnd().EndsWith(";", StringComparison.Ordinal))
            {
                style += ";";
            }
        }

        style += this.gridVisible ? "display:block;" : "display:none;";

        return style;
    }

    /// <summary>
    ///     Port of <c>GetGridPanelStyle()</c>: the <c>GridPanelStyle</c> property wins, except that
    ///     - verbatim, quirk included - the original only consulted the property when a
    ///     <c>GridPanelWidth</c> had been set, falling back to the
    ///     <c>GridPanelStyle</c> scrud parameter otherwise.

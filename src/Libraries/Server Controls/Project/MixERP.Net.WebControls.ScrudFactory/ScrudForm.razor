    ///         The legacy <c>[Localizable(true)]</c> designer metadata is kept: it costs nothing
    ///         and documents that this string is user-visible.
    ///     </para>
    /// </summary>
    [Parameter]
    [Localizable(true)]
    public string Text { get; set; }

    /// <summary>
    ///     CssClass of the title label.
    /// </summary>
    [Parameter]
    public string TitleLabelCssClass { get; set; }

    /// <summary>
    ///     If the table has foreign keys, set this to override the data being populated on the
    ///     respective DropDownList control. Setting this will allow the Scrud to
    ///     fetch the data from the DisplayViews Expression Tables instead of the original parent table.
    /// </summary>
    [Parameter]
    public bool UseDisplayViewsAsParents { get; set; }

    /// <summary>
    ///     The name of the database view or table to select and display the resultset from.
    /// </summary>
    [Parameter]
    public string View { get; set; }

    /// <summary>
    ///     The database schema container of the "View" property of this control.
    /// </summary>
    [Parameter]
    public string ViewSchema { get; set; }

    //==================================================================================
    // Component state - the replacement for the 16 WebForms child-control fields the old
    // ScrudForm/IDisposable.cs used to null out.
    //==================================================================================

    /// <summary>
    ///     The generated form's field set. This is the replacement for the <c>HtmlTable</c> the
    ///     factories mutated AND for the four <c>FindControl("{column}_...")</c> lookups
    ///     <c>GetFormCollection</c> performed; it also backs the server-side validation gate.
    /// </summary>
    private readonly ScrudFieldTable fieldTable = new ScrudFieldTable();

    /// <summary>Control.cs: the bytea column name, assigned while the form is generated.</summary>
    private string imageColumn = string.Empty;

    private CommandPanel topCommandPanel;
    private CommandPanel bottomCommandPanel;

    /// <summary>ViewFactory/GridView.cs BindGridView(): the view's current page of rows.</summary>
    private DataTable gridDataSource;

    /// <summary>
    ///     The grid's columns. The select column is FIRST, as it was when
    ///     <c>CreateGridPanel</c> added its <c>TemplateField</c> to a <c>GridView</c> whose
    ///     <c>AutoGenerateColumns</c> was true (explicit columns preceded generated ones) - which is
    ///     also what <c>FormGridView_RowDataBound</c> assumed when it injected the radio into
    ///     <c>Cells[0]</c> and read the key out of <c>Cells[1]</c>.
    /// </summary>
    private IReadOnlyList<MixERPGridViewColumn> gridColumns = new List<MixERPGridViewColumn>();

    /// <summary>Pager.cs: the rendered pager, or null when there is nothing to page.</summary>
    private RenderFragment pager;

    private string messageText = string.Empty;
    private string messageCssClass;
    private string messageStyle;

    /// <summary>
    ///     FormPanel.cs: <c>formPanel.Style.Add("display", "none")</c>, flipped by Scrud.js's
    ///     scrudAddNew()/scrudEdit() and by DisplayError/DisplaySuccess on the server.
    /// </summary>
    private bool formVisible;

    private bool gridVisible = true;

    /// <summary>
    ///     True while a save/delete is in flight. Drives the <c>loading</c> class on
    ///     <c>#FormPanel div.segment</c> - the same class Scrud.js's scrudDispalyLoading() adds.
    /// </summary>
    private bool busy;

    /// <summary>
    ///     What the grid was last loaded for (query string + page size). The legacy control bound
    ///     the grid exactly once per request inside CreateChildControls; OnParametersSet can run
    ///     several times per interaction, so the database round trip is repeated only when the page
    ///     or the page size actually changed.
    /// </summary>
    private string gridKey;

    //==================================================================================
    // ScrudForm/Control.cs CreateChildControls() - the ordering is load-bearing.
    //  Validate() -> container -> title -> description -> grid -> pager ->
    //  InitializeScrudControl() -> generator meta
    // RecreateChildControls()/EnsureChildControls() and Render(HtmlTextWriter) disappear: the
    // template above IS the render tree, and Blazor re-renders on its own.
    //==================================================================================

    protected override void OnParametersSet()
    {
        this.ValidateProperties();

        this.CreateCommandPanels();

        this.LoadGrid();

        this.pager = this.CreatePager();

        this.InitializeScrudControl();

        base.OnParametersSet();
    }


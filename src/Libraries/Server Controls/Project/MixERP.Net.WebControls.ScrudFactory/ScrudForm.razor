    ////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     The outer width of grid container.
    ///     <para>
    ///         API DIVERGENCE (checklist task 15): this was a
    ///         <c>System.Web.UI.WebControls.Unit</c>, a removed platform type. It is now a CSS
    ///         length string, for example <c>"800px"</c>. The rendered output - an inline
    ///         <c>width:</c> style, emitted only when a value is actually set - is unchanged.
    ///     </para>
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////
    [Parameter]
    public string GridPanelWidth { get; set; }

    [Parameter]
    public string GridViewAlternateRowCssClass { get; set; }

    [Parameter]
    public string GridViewCssClass { get; set; }

    [Parameter]
    public string GridViewRowCssClass { get; set; }

    /// <summary>
    ///     The full inner width of the grid. <c>Unit</c> -&gt; CSS length string; see
    ///     <see cref="GridPanelWidth" />.
    /// </summary>
    [Parameter]
    public string GridViewWidth { get; set; }

    /// <summary>
    ///     Use this parameter to override "ItemSelectorPath" key in the configuration file.
    ///     ItemSelectorPath is a page which pops up on iframe and provides
    ///     some basic search functionalities for the dropdownlist control.
    /// </summary>
    [Parameter]
    public string ItemSelectorPath { get; set; }

    //----------------------------------------------------------------------------------
    // The five members FrontEnd/MixERP.Net.FrontEnd/Controls/Scrud.cs assigns from its
    // constructor (public sealed class Scrud : ScrudForm). They are [Parameter]s AND plain
    // settable properties, so that subclass still compiles - see the API freeze.
    //----------------------------------------------------------------------------------

    [Parameter]
    public int UserId { get; set; }

    [Parameter]
    public string UserName { get; set; }

    [Parameter]
    public string OfficeCode { get; set; }

    [Parameter]
    public int OfficeId { get; set; }

    /// <summary>
    ///     The name of the primary key column.
    /// </summary>
    [Parameter]
    public string KeyColumn { get; set; }

    [Parameter]
    public string PagerCssClass { get; set; }

    [Parameter]
    public string PagerCurrentPageCssClass { get; set; }

    [Parameter]
    public string PagerPageButtonCssClass { get; set; }


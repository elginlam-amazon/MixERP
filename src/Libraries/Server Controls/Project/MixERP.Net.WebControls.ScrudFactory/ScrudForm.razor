    /// <summary>
    ///     Port of <c>InitializeScrudControl()</c>: the form is generated once, from an EMPTY
    ///     <c>DataTable</c> whose <c>Locale</c> is the current culture (an insert form).
    ///     <para>
    ///         The guard is new and necessary: <c>CreateChildControls</c> ran once per request,
    ///         whereas <c>OnParametersSet</c> runs on every parameter change - regenerating the
    ///         fields there would discard whatever the user has typed.
    ///     </para>
    /// </summary>
    private void InitializeScrudControl()
    {
        if (this.fieldTable.Fields.Count > 0)
        {
            return;
        }

        using (DataTable table = new DataTable())
        {
            table.Locale = Thread.CurrentThread.CurrentCulture;
            this.LoadForm(table, false);
        }
    }

    ////////////////////////////////////////////////////////////////////////////////////
    /// <summary>
    ///     Port of <c>IsModal()</c>. <c>HttpContext.Current.CurrentHandler as Page</c> plus
    ///     <c>page.Request.QueryString["modal"]</c> becomes a query-string read off the injected
    ///     <c>NavigationManager</c>. The truthiness semantics are unchanged: ONLY the literal "1"
    ///     counts as modal.
    /// </summary>
    ////////////////////////////////////////////////////////////////////////////////////
    private bool IsModal()
    {
        return "1".Equals(this.GetQueryStringValue("modal"));
    }

    /// <summary>
    ///     The single replacement for every <c>this.Page.Request[...]</c> /
    ///     <c>HttpContext.Current</c> query-string read in the legacy control
    ///     (<c>modal</c>, <c>show</c>, <c>page</c>).
    /// </summary>
    private string GetQueryStringValue(string key)
    {
        if (this.Nav == null)
        {
            return null;
        }

        string query = new Uri(this.Nav.Uri).Query;

        if (string.IsNullOrEmpty(query))
        {
            return null;
        }

        StringValues value;

        if (QueryHelpers.ParseQuery(query).TryGetValue(key, out value))
        {
            return value.ToString();
        }

        return null;
    }

    /// <summary>
    ///     The request's query string WITHOUT a leading '?', which is what
    ///     <c>this.Page.Request.QueryString.ToString()</c> produced. <c>ScrudPager</c> compares it
    ///     against exact strings, so the leading '?' must not be carried.
    /// </summary>
    private string GetQueryString()
    {
        if (this.Nav == null)
        {
            return string.Empty;
        }

        return new Uri(this.Nav.Uri).Query.TrimStart('?');
    }

    /// <summary>
    ///     The replacement for <c>this.Page.Request.Url.AbsolutePath</c>, which the pager used as
    ///     the base of every page link.
    /// </summary>
    private string GetCurrentPageUrl()
    {
        if (this.Nav == null)
        {
            return string.Empty;
        }

        return new Uri(this.Nav.Uri).AbsolutePath;
    }


<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.ScrudFactory</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.ScrudFactory</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>../../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.WebControls.ScrudFactory</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.WebControls.ScrudFactory</Product>
    <Copyright>Copyright ©  2013-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>cc5a8002-6808-407d-b085-c27df176d9b6</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ComponentBase, [Parameter], EventCallback, NavigationManager, IWebHostEnvironment,
       IFormFile and Microsoft.JSInterop (IJSRuntime) come from the ASP.NET Core shared
       framework on net10.0 (same reasoning as MixERP.Net.WebControls.Common). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Serilog 1.5.7 -> 4.3.0 (solution pin). Serilog.FullNetFx has no modern equivalent;
       its ILogger extensions folded into the Serilog core package. -->
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Entities/MixERP.Net.Entities.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <ProjectReference Include="../../../Logic/PetaPoco/PetaPoco.csproj" />
    <ProjectReference Include="../MixERP.Net.WebControls.Common/MixERP.Net.WebControls.Common.csproj" />
    <ProjectReference Include="../../Data/MixERP.Net.WebControls.ScrudFactory.Data/MixERP.Net.WebControls.ScrudFactory.Data.csproj" />
  </ItemGroup>

  <!-- Both scripts stay embedded resources: JSUtility resolves them by manifest resource
       name (MixERP.Net.WebControls.ScrudFactory.Scrud.js /
       MixERP.Net.WebControls.ScrudFactory.ScrudItemSelector.js) and the host serves them
       through JSUtility.WebResourceRoutePrefix. Do NOT move them to wwwroot. -->
  <ItemGroup>
    <EmbeddedResource Include="Scrud.js" />
    <EmbeddedResource Include="ScrudItemSelector.js" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../../mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

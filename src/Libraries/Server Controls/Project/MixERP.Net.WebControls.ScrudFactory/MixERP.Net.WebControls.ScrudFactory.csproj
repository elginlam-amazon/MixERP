<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Nonshipping>true</Nonshipping>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\..\</SolutionDir>
    <RestorePackages>true</RestorePackages>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scrud.js" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\..\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\MixERP.Net.WebControls.Common\MixERP.Net.WebControls.Common.csproj" />
    <ProjectReference Include="..\..\Data\MixERP.Net.WebControls.ScrudFactory.Data\MixERP.Net.WebControls.ScrudFactory.Data.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="ScrudItemSelector.js" />
  </ItemGroup>

  <!-- Web Forms (System.Web.UI) is provided on .NET 10 by CoreWebForms, which ships for net9.0+ only. netstandard2.0 has no Web Forms surface, so the Web Forms sources are compiled for net10.0 only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="Controls\CommandPanel.cs" />
    <Compile Remove="Controls\ImageUpload.cs" />
    <Compile Remove="Controls\ListControls\DropDownList.cs" />
    <Compile Remove="Controls\ListControls\Helper.cs" />
    <Compile Remove="Controls\ListControls\RadioButtonList.cs" />
    <Compile Remove="Controls\ScrudPager.cs" />
    <Compile Remove="Controls\TextBoxes\DateTextBox.cs" />
    <Compile Remove="Controls\TextBoxes\DecimalTextBox.cs" />
    <Compile Remove="Controls\TextBoxes\NumberTextBox.cs" />
    <Compile Remove="Controls\TextBoxes\TextBox.cs" />
    <Compile Remove="Helpers\ScrudFactoryHelper.cs" />
    <Compile Remove="Helpers\ScrudItemSelectorSelectTemplate.cs" />
    <Compile Remove="Helpers\ScrudJavaScriptHelper.cs" />
    <Compile Remove="Helpers\ScrudProgressTemplate.cs" />
    <Compile Remove="ScrudForm\Control.cs" />
    <Compile Remove="ScrudForm\Events\GridViewEvents.cs" />
    <Compile Remove="ScrudForm\Events\ScrudEvents.cs" />
    <Compile Remove="ScrudForm\FormFactory\Alert.cs" />
    <Compile Remove="ScrudForm\FormFactory\FormFactory.cs" />
    <Compile Remove="ScrudForm\FormFactory\FormPanel.cs" />
    <Compile Remove="ScrudForm\IDisposable.cs" />
    <Compile Remove="ScrudForm\Pager.cs" />
    <Compile Remove="ScrudForm\Properties.cs" />
    <Compile Remove="ScrudForm\ScrudContainer.cs" />
    <Compile Remove="ScrudForm\Styling.cs" />
    <Compile Remove="ScrudForm\Title.cs" />
    <Compile Remove="ScrudForm\UpdatePanel.cs" />
    <Compile Remove="ScrudForm\Validation.cs" />
    <Compile Remove="ScrudForm\ViewFactory\GridPanel.cs" />
    <Compile Remove="ScrudForm\ViewFactory\GridView.cs" />
    <Compile Remove="ScrudForm\ViewFactory\Selection.cs" />
    <Compile Remove="ScrudItemSelector\Control.cs" />
    <Compile Remove="ScrudItemSelector\Events.cs" />
    <Compile Remove="ScrudItemSelector\Intializer.cs" />
    <Compile Remove="ScrudItemSelector\ItemSelector.cs" />
    <Compile Remove="ScrudItemSelector\JavaScript.cs" />
    <Compile Remove="ScrudItemSelector\Properties.cs" />
  </ItemGroup>
</Project>
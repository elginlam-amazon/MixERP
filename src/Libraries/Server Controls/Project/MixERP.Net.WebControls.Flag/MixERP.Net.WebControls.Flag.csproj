<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.Flag</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.Flag</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.WebControls.Flag</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.WebControls.Flag</Product>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <!-- The original AssemblyInfo.cs emitted [assembly: AssemblyConfiguration("")]. The SDK
         otherwise defaults this to $(Configuration) and would emit Debug/Release. -->
    <AssemblyConfiguration></AssemblyConfiguration>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>5868a529-e1b6-4009-8d96-ff4d26c7d278</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ComponentBase, EventCallback and Microsoft.JSInterop (IJSRuntime) come from the
       ASP.NET Core shared framework on net10.0. The Razor SDK alone does not supply them.
       Matches the MixERP.Net.WebControls.PartyControl precedent. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- This project ships NO .js of its own: the popUnder(popunder, button) function the
       registered inline script calls is host-provided by
       FrontEnd/MixERP.Net.FrontEnd/Scripts/mixerp/mixerp-core.min.js. There is therefore
       no EmbeddedResource and no wwwroot here, unlike PartyControl/AttachmentFactory. -->

  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\..\Logic\PetaPoco\PetaPoco.csproj" />
    <ProjectReference Include="..\..\Data\MixERP.Net.WebControls.Flag.Data\MixERP.Net.WebControls.Flag.Data.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

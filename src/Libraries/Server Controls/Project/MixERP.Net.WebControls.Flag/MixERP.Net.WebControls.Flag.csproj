<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.Flag</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.Flag</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <AddRazorSupportForMvc>false</AddRazorSupportForMvc>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Entities/MixERP.Net.Entities.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <ProjectReference Include="../../../Logic/PetaPoco/PetaPoco.csproj" />
    <ProjectReference Include="../../Data/MixERP.Net.WebControls.Flag.Data/MixERP.Net.WebControls.Flag.Data.csproj" />
  </ItemGroup>

  <!-- Web Forms sources (System.Web.UI server controls, pages, user controls, designer
       files) that have no ASP.NET Core equivalent and still need the per-control/per-page
       Blazor rewrite tracked in summary.md. They are kept in the tree, unchanged, as the
       reference for that rewrite, but are not compiled. -->
  <ItemGroup Label="PendingWebFormsRewrite">
    <Compile Remove="FlagControl/Control.cs" />
    <None Include="FlagControl/Control.cs" />
    <Compile Remove="FlagControl/Events.cs" />
    <None Include="FlagControl/Events.cs" />
    <Compile Remove="FlagControl/IDisposable.cs" />
    <None Include="FlagControl/IDisposable.cs" />
    <Compile Remove="FlagControl/JavaScript.cs" />
    <None Include="FlagControl/JavaScript.cs" />
    <Compile Remove="FlagControl/Properties.cs" />
    <None Include="FlagControl/Properties.cs" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.StockAdjustmentFactory</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.StockAdjustmentFactory</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>../../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs. -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.WebControls.StockAdjustmentFactory</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.WebControls.StockAdjustmentFactory</Product>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <!-- The original AssemblyInfo.cs emitted [assembly: AssemblyConfiguration("")]. The SDK
         otherwise defaults this to $(Configuration) and would emit Debug/Release. -->
    <AssemblyConfiguration></AssemblyConfiguration>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <!-- [assembly: ComVisible(false)] and the COM typelib GUID, copied VERBATIM from the former
       Properties/AssemblyInfo.cs. That file declared NO [assembly: CLSCompliant], so none is
       emitted here (unlike the StockTransactionFactory precedent, whose AssemblyInfo did). -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>b36002da-56f2-4f4a-adce-0ed7a48cae1f</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- ComponentBase, [Parameter] and Microsoft.JSInterop (IJSRuntime) come from the ASP.NET
       Core shared framework on net10.0; the Razor SDK alone does not supply them. Replaces the
       former bare System/System.Core/System.Xml.Linq/System.Data.DataSetExtensions/
       Microsoft.CSharp/System.Drawing/System.Web references. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- FormView.js stays an embedded resource. It moved to Includes/Script/ to match the
       StockTransactionFactory layout, so LogicalName PINS the original manifest name
       "MixERP.Net.WebControls.StockAdjustmentFactory.FormView.js" that AddJavascript() passes
       to JSUtility; the host serves it through JSUtility.WebResourceRoutePrefix (PartyControl
       precedent). Changing either side silently 404s the script and the form goes dead. -->
  <ItemGroup>
    <EmbeddedResource Include="Includes/Script/FormView.js">
      <LogicalName>MixERP.Net.WebControls.StockAdjustmentFactory.FormView.js</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.Entities/MixERP.Net.Entities.csproj" />
    <ProjectReference Include="../../../Logic/MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
    <ProjectReference Include="../MixERP.Net.WebControls.Common/MixERP.Net.WebControls.Common.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

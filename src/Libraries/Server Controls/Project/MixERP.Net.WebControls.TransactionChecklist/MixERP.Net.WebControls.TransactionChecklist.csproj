<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <Nonshipping>true</Nonshipping>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.HtmlParser\MixERP.Net.HtmlParser.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Messaging\MixERP.Net.Messaging.Email.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.TransactionGovernor\MixERP.Net.TransactionGovernor.csproj" />
  </ItemGroup>
  <ItemGroup>
    <WCFMetadata Include="Service References\" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Scripts\TransactionChecklist.js" />
  </ItemGroup>
  <!-- Web Forms / ASMX presentation layer. Neither System.Web.UI nor System.Web.Services was
       ported to modern .NET (knowledge base docs 25, 26 and 33), and there is no mechanical
       translation for a server control or a user control code-behind. The source is kept in the
       tree, shipped as content, and excluded from the net10.0 compile; the per-page re-authoring
       backlog is tracked in summary.md. -->
  <ItemGroup>
    <Compile Remove="TransactionCheckList\Base.cs" />
    <Compile Remove="TransactionCheckList\Buttons.cs" />
    <Compile Remove="TransactionCheckList\Events.cs" />
    <Compile Remove="TransactionCheckList\Footer.cs" />
    <Compile Remove="TransactionCheckList\Heading.cs" />
    <Compile Remove="TransactionCheckList\HiddenFields.cs" />
    <Compile Remove="TransactionCheckList\IDisposable.cs" />
    <Compile Remove="TransactionCheckList\Javascript.cs" />
    <Compile Remove="TransactionCheckList\Properties.cs" />
    <Compile Remove="TransactionCheckList\QueryStringData.cs" />
    <Compile Remove="TransactionCheckList\VerificationStatuses.cs" />
    <Compile Remove="TransactionCheckList\WithdrawDiv.cs" />
    <None Include="TransactionCheckList\Base.cs" />
    <None Include="TransactionCheckList\Buttons.cs" />
    <None Include="TransactionCheckList\Events.cs" />
    <None Include="TransactionCheckList\Footer.cs" />
    <None Include="TransactionCheckList\Heading.cs" />
    <None Include="TransactionCheckList\HiddenFields.cs" />
    <None Include="TransactionCheckList\IDisposable.cs" />
    <None Include="TransactionCheckList\Javascript.cs" />
    <None Include="TransactionCheckList\Properties.cs" />
    <None Include="TransactionCheckList\QueryStringData.cs" />
    <None Include="TransactionCheckList\VerificationStatuses.cs" />
    <None Include="TransactionCheckList\WithdrawDiv.cs" />
  </ItemGroup>
</Project>
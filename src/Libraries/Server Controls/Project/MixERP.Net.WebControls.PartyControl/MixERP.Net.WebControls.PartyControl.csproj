<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.WebControls.PartyControl</RootNamespace>
    <AssemblyName>MixERP.Net.WebControls.PartyControl</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>..\..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.WebControls.PartyControl</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.WebControls.PartyControl</Product>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>e6cad8c2-c3ba-41d0-9cdd-ccccbb3281e0</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- PartyControl.js intentionally stays an EmbeddedResource: MixERP.Net.Common's
       JSUtility resolves it by the manifest resource name
       "MixERP.Net.WebControls.PartyControl.PartyControl.js" and the host serves it
       through the JSUtility.WebResourceRoutePrefix ("/_mixerp/script") endpoint. -->
  <ItemGroup>
    <EmbeddedResource Include="PartyControl.js" />
  </ItemGroup>

  <!-- ComponentBase, Microsoft.JSInterop (IJSRuntime/JSException) and the Razor component
       runtime come from the ASP.NET Core shared framework on net10.0. The Razor SDK alone
       does not supply them, and the standalone Microsoft.JSInterop/Components NuGet
       packages are legacy-pinned (same reasoning as MixERP.Net.Common). -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

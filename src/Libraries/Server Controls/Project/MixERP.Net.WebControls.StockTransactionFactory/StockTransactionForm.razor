    /// <summary>
    ///     The key under which StockTransactionViewFactory hands the merge payload over.
    ///     Formerly Page.Session["Product"], now ProtectedSessionStorage.
    /// </summary>
    private const string MergeModelSessionKey = "Product";

    /// <summary>
    ///     Replaces the second session slot, Session["StockTransactionFactory"], which was pure
    ///     intra-request plumbing between LoadValuesFromSession() and GetTable() - it had no
    ///     reader outside this class. It is now an ordinary private field with the same
    ///     lifetime over the circuit; the session key itself is gone (recorded in
    ///     migration-summary.md section 2), and with it this project's last use of
    ///     MixERP.Net.Common SessionHelper.
    /// </summary>
    private Collection<ProductDetail> productCollection;

    /// <summary>Value of #PartyCodeHidden (formerly partyCodeHidden.Value).</summary>
    private string partyCodeHidden;

    /// <summary>Value of #PriceTypeIdHidden (formerly priceTypeIdHidden.Value).</summary>
    private string priceTypeId;

    /// <summary>Value of #StoreIdHidden (formerly storeIdHidden.Value).</summary>
    private string storeId;

    /// <summary>Value of #ShipperIdHidden (formerly shipperIdHidden.Value).</summary>
    private string shipperId;

    /// <summary>Value of #ShippingAddressCodeHidden (formerly shippingAddressCodeHidden.Value).</summary>
    private string shippingAddressCode;

    /// <summary>Value of #SalesPersonIdHidden (formerly salesPersonIdHidden.Value).</summary>
    private string salesPersonId;

    /// <summary>Value of #TranIdCollectionHiddenField (formerly tranIdCollectionHidden.Value).</summary>
    private string tranIdCollection;

    /// <summary>Value of #StatementReferenceTextArea (formerly statementReferenceTextArea.Value).</summary>
    private string statementReference;

    /// <summary>
    ///     Rendered in the contracted #ErrorLabel span when the merge handoff arrives empty.
    /// </summary>
    private string mergeDataWarning;

    /// <summary>
    ///     Control/Session.cs - LoadValuesFromSession(), ported. The payload used to be the very
    ///     same CLR MergeModel instance in HttpContext.Current.Session; it now travels as JSON
    ///     through ProtectedSessionStorage. Both of the original early returns are kept: no
    ///     value stored (formerly Session[key] == null) and a value that does not deserialize to
    ///     a MergeModel (formerly the failed "as MergeModel" cast).
    /// </summary>
    private async Task LoadValuesFromSessionAsync()
    {
        ProtectedBrowserStorageResult<MergeModel> result =
            await ProtectedSessionStorage.GetAsync<MergeModel>(MergeModelSessionKey);

        if (!result.Success)
        {
            return;
        }

        MergeModel merged = result.Value;

        if (merged == null)
        {
            return;
        }

        // GUARD (migration-summary section 3.4): the merge payload travels as JSON over
        // ProtectedSessionStorage. A successful read whose collections are BOTH empty means the
        // MergeModel JSON round-trip has regressed and every merged line/id was lost. Surface
        // it; never render an empty merge form as if the merge had succeeded.
        if (merged.View.Count == 0 && merged.TransactionIdCollection.Count == 0)
        {
            this.mergeDataWarning = Titles.NothingSelected;
            Console.Error.WriteLine(
                "StockTransactionForm: ProtectedSessionStorage key \"Product\" was read successfully " +
                "but MergeModel.View and MergeModel.TransactionIdCollection are both EMPTY. " +
                "The MergeModel System.Text.Json round-trip has regressed - see " +
                "StockTransactionFactory/migration-summary.md 3.2/3.3.");
        }

        this.model = merged;

        this.partyCodeHidden = this.model.PartyCode.ToString(CultureInfo.InvariantCulture);
        this.partyCode = this.model.PartyCode.ToString(CultureInfo.InvariantCulture);
        this.priceTypeId = this.model.PriceTypeId.ToString(CultureInfo.InvariantCulture);
        this.storeId = this.model.StoreId.ToString(CultureInfo.InvariantCulture);
        this.shipperId = this.model.ShippingCompanyId.ToString(CultureInfo.InvariantCulture);
        this.shippingAddressCode = this.model.ShippingAddressCode.ToString(CultureInfo.InvariantCulture);
        this.salesPersonId = this.model.SalesPersonId.ToString(CultureInfo.InvariantCulture);

        this.referenceNumber = this.model.ReferenceNumber;
        this.statementReference = this.model.StatementReference;

        // Formerly: this.Page.Session[sessionKey] = this.model.View;
        this.productCollection = this.model.View;
        this.tranIdCollection = string.Join(",", this.model.TransactionIdCollection);
    }

    /// <summary>
    ///     Control/Session.cs - ClearSession(). The two SessionHelper.RemoveSessionKey() calls
    ///     become the deletion of the ProtectedSessionStorage key plus the clearing of the local
    ///     product field. MUST run AFTER BindGridView() so the merge payload is consumed exactly
    ///     once.
    /// </summary>
    private async Task ClearSessionAsync()
    {
        await ProtectedSessionStorage.DeleteAsync(MergeModelSessionKey);
        this.productCollection = null;
    }

    /// <summary>
    ///     Control/Session.cs - GetTable(), ported verbatim against the new field: when it holds
    ///     a collection the collection is summated and the SUMMATED collection is stored back
    ///     ("summate once, keep summated"); otherwise an empty collection is returned.
    /// </summary>
    private Collection<ProductDetail> GetTable()
    {
        Collection<ProductDetail> productCollection = new Collection<ProductDetail>();

        if (this.productCollection != null)
        {
            //Get an instance of the ProductDetailsModel collection stored for this form.
            productCollection = this.productCollection;

            //Summate the collection.
            productCollection = SummateProducts(productCollection);

            //Store the summated table back.
            this.productCollection = productCollection;
        }

        return productCollection;
    }

    /// <summary>
    ///     Control/Session.cs - SummateProducts(), ported VERBATIM: the five-key match
    ///     (ItemCode, ItemName, Unit, Price, TaxCode), the "collection.Count > 0" guard before
    ///     FirstOrDefault and the seven accumulated fields. No behaviour change.
    /// </summary>
    private static Collection<ProductDetail> SummateProducts(IEnumerable<ProductDetail> productCollection)
    {
        //Create a new collection of products.
        Collection<ProductDetail> collection = new Collection<ProductDetail>();

        //Iterate through the supplied product collection.
        foreach (ProductDetail product in productCollection)
        {
            //Create a product
            ProductDetail productInCollection = null;

            if (collection.Count > 0)
            {
                productInCollection = collection.FirstOrDefault(x => x.ItemCode == product.ItemCode && x.ItemName == product.ItemName && x.Unit == product.Unit && x.Price == product.Price && x.TaxCode == product.TaxCode);
            }

            if (productInCollection == null)
            {
                collection.Add(product);
            }
            else
            {
                productInCollection.Quantity += product.Quantity;
                productInCollection.Amount += product.Amount;
                productInCollection.Discount += product.Discount;
                productInCollection.Subtotal += product.Subtotal;
                productInCollection.ShippingCharge += product.ShippingCharge;
                productInCollection.Tax += product.Tax;
                productInCollection.Total += product.Total;
            }
        }

        return collection;
    }

    //---------------------------------------------------------------------------------------
    // Control/Javascript.cs
    //
    // DROPPED (recorded in migration-summary.md section 2):
    //   [assembly: WebResource("...StockTransactionForm.js", "application/x-javascript",
    //   PerformSubstitution = true)] and the companion stylesheet WebResource attribute -
    //   System.Web.UI.WebResourceAttribute is a removed type; the script is now resolved by
    //   JSUtility through the assembly manifest name and served by the host's
    //   JSUtility.WebResourceRoutePrefix endpoint.
    //   [AspNetHostingPermission(SecurityAction.Demand, Level = Minimal)] on AddJavascript()
    //   (and the one on AddStylesheet()) - Code Access Security is gone from modern .NET, and
    //   these were host-trust demands rather than application authorization rules.
    //---------------------------------------------------------------------------------------

    /// <summary>
    ///     Control/Javascript.cs - RegisterJavascript(), ported verbatim. isSales and
    ///     verifyStock are emitted as NON-string vars ("true"/"false") and tranBook as a string
    ///     var, under the unchanged key "StockTransactionForm_Vars": StockTransactionForm.js
    ///     reads the globals isSales, tranBook and verifyStock.
    /// </summary>
    private void RegisterJavascript()
    {
        string isSales = (this.Book.Equals(TranBook.Sales)) ? "true" : "false";
        string tranBook = this.GetTranBook();
        string verifyStock = (this.VerifyStock) ? "true" : "false";

        string js = string.Empty;
        js += JSUtility.GetVar("isSales", isSales, false);
        js += JSUtility.GetVar("tranBook", tranBook);
        js += JSUtility.GetVar("verifyStock", verifyStock, false);

        PageUtility.RegisterJavascript("StockTransactionForm_Vars", js, JSRuntime, true);
    }

    /// <summary>
    ///     Control/Javascript.cs - GetTranBook(). Public API, return strings unchanged.
    /// </summary>
    public string GetTranBook()
    {
        if (this.Book == TranBook.Sales)
        {
            return "Sales";
        }

        return "Purchase";
    }

    /// <summary>
    ///     Control/Javascript.cs - AddJavascript(). The manifest name is pinned by the
    ///     &lt;LogicalName&gt; of the EmbeddedResource in the csproj and must stay byte-identical.
    /// </summary>
    private void AddJavascript()
    {
        JSUtility.AddJSReference(JSRuntime, "MixERP.Net.WebControls.StockTransactionFactory.Includes.Script.StockTransactionForm.js", "StockTransactionForm", typeof(StockTransactionForm));
    }


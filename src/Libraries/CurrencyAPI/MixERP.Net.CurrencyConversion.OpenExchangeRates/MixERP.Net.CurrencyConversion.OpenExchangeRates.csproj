<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.CurrencyConversion.OpenExchangeRates</RootNamespace>
    <AssemblyName>MixERP.Net.CurrencyConversion.OpenExchangeRates</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>MixERP.Net.CurrencyConversion.OpenExchangeRates</AssemblyTitle>
    <Product>MixERP.Net.CurrencyConversion.OpenExchangeRates</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- These were explicitly empty in the former Properties/AssemblyInfo.cs; the SDK would
         otherwise default Company to the assembly name and Configuration to "Debug". -->
    <Company></Company>
    <Description></Description>
    <AssemblyTrademark></AssemblyTrademark>
    <AssemblyConfiguration></AssemblyConfiguration>
    <!-- Keep AssemblyInformationalVersion as the bare version, with no git-SHA suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Preserved from the deleted Properties/AssemblyInfo.cs -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>c581089b-c93c-437b-98c7-d202eda53cf2</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Newtonsoft is retained deliberately: Parser.Parse() relies on JObject's dynamic
         member semantics (item.Name / item.Value), which System.Text.Json does not provide. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- IHttpClientFactory (replaces the per-call `new HttpClient()`). -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <!-- IConfiguration: supplies the OpenExchangeRates:AppId API key outside the database. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Logic\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.CurrencyConversion.Currencylayer</RootNamespace>
    <AssemblyName>MixERP.Net.CurrencyConversion.Currencylayer</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>MixERP.Net.CurrencyConversion.Currencylayer</AssemblyTitle>
    <Product>MixERP.Net.CurrencyConversion.Currencylayer</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <Company></Company>
    <Description></Description>
    <AssemblyTrademark></AssemblyTrademark>
    <NeutralLanguage></NeutralLanguage>
    <ComVisible>false</ComVisible>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- The FrontEnd host probes this assembly out of its own bin folder (plugin discovery). -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../../../FrontEnd/MixERP.Net.FrontEnd/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../Logic/MixER.Net.StateServer/MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="../../Logic/MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../../Logic/MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

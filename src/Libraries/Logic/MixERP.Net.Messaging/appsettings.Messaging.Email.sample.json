{
  // Reference section for the host application's appsettings.json.
  //
  // These values are the application-wide SMTP defaults consumed by
  // MixERP.Net.Messaging.Email via IOptions<EmailOptions> (section
  // "Messaging:Email"). The per-catalog messaging parameters stored in the
  // database still override any value they supply, which preserves the
  // original multi-tenant behavior.
  //
  // NEVER commit real SMTP credentials. Supply SmtpUsername / SmtpPassword
  // through user secrets (dotnet user-secrets set "Messaging:Email:SmtpPassword" ...)
  // or environment variables (Messaging__Email__SmtpPassword).
  "Messaging": {
    "Email": {
      "FromName": "MixERP",
      "FromEmail": "no-reply@example.com",
      "SmtpHost": "smtp.example.com",
      "SmtpPort": 587,
      "EnableSsl": true,
      "SmtpUsername": "<<SECRET>>",
      "SmtpPassword": "<<SECRET>>",
      // Network | SpecifiedPickupDirectory | PickupDirectoryFromIis
      "DeliveryMethod": "Network",
      "PickupDirectory": "~/App_Data/MailPickup"
    }
  },
  "_PORT_TODO_secrets": "Messaging:Email:SmtpUsername and Messaging:Email:SmtpPassword — move to user secrets or environment variables"
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.Messaging.Email</RootNamespace>
    <AssemblyName>MixERP.Net.Messaging.Email</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.Messaging</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.Messaging</Product>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>23c56849-5c0f-4684-9b23-01171cd0787b</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog 1.5.7 (bare Reference) -> solution pin. Serilog.FullNetFx has no modern
         equivalent; the Log static API it was used for ships in the Serilog package. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <!-- Replaces the obsolete System.Net.Mail.SmtpClient / MailMessage send path. -->
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- IOptions-based SMTP host/credentials. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

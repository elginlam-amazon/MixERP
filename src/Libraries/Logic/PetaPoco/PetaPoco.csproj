<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>PetaPoco</RootNamespace>
    <AssemblyName>PetaPoco</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>PetaPoco</AssemblyTitle>
    <Company></Company>
    <Description></Description>
    <Product>PetaPoco</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Narrow abstractions only: IConfiguration (for the connection-string source that
         replaces ConfigurationManager.ConnectionStrings) and IServiceCollection (for the
         host registration helper). Deliberately NOT a FrameworkReference on
         Microsoft.AspNetCore.App — this is a plain data-access library and its consumers
         include non-web (console/service) projects, which must still be able to load it. -->
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>MixERP.Net.TransactionGovernor.Data</AssemblyName>
    <RootNamespace>MixERP.Net.TransactionGovernor.Data</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Npgsql" Version="7.0.10" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.DbFactory\MixERP.Net.DBFactory.csproj" />
    <ProjectReference Include="..\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>
</Project>

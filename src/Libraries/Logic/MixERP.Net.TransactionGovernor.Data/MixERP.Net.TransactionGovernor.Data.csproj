<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.TransactionGovernor.Data</RootNamespace>
    <AssemblyName>MixERP.Net.TransactionGovernor.Data</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1685</NoWarn>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the deleted Properties/AssemblyInfo.cs so the
       assembly identity stays equivalent for dependent projects. -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.TransactionGovernor.Data</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.TransactionGovernor.Data</Product>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
    <!-- Keep InformationalVersion exactly "1.2.0.1 RC"; the SDK otherwise appends "+<git sha>". -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.DbFactory\MixERP.Net.DBFactory.csproj" />
    <ProjectReference Include="..\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

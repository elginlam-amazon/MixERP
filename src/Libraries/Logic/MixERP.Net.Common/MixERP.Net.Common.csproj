<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\</SolutionDir>
    <RestorePackages>true</RestorePackages>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
    <!-- System.Drawing.Common is Windows-only on modern .NET. SkiaSharp is the cross platform
         replacement used by ImageHelper/Conversion. See knowledge base doc 21. -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="4.150.1" />
  </ItemGroup>
  <!-- Web Forms only helpers (System.Web.UI). Web Forms was never ported to modern .NET, so these
       are kept as source for the per-page Razor re-authoring tracked in summary.md and excluded
       from the net10.0 compile. See knowledge base doc 25. -->
  <ItemGroup>
    <Compile Remove="Conversion.WebForms.cs" />
    <Compile Remove="PageUtility.WebForms.cs" />
    <Compile Remove="Helpers\DropDownListHelper.cs" />
    <Compile Remove="Helpers\GridViewHelper.cs" />
    <Compile Remove="Helpers\HtmlControlHelper.cs" />
    <Compile Remove="Helpers\JSUtility.cs" />
    <Compile Remove="jQueryHelper\jQueryUI.cs" />
    <!-- CodeDOM runtime compilation (CSharpCodeProvider) does not exist on modern .NET. -->
    <Compile Remove="Helpers\ExpressionHelper.CodeDom.cs" />
    <None Include="Helpers\ExpressionHelper.CodeDom.cs" />
    <None Include="Conversion.WebForms.cs" />
    <None Include="PageUtility.WebForms.cs" />
    <None Include="Helpers\DropDownListHelper.cs" />
    <None Include="Helpers\GridViewHelper.cs" />
    <None Include="Helpers\HtmlControlHelper.cs" />
    <None Include="Helpers\JSUtility.cs" />
    <None Include="jQueryHelper\jQueryUI.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>
</Project>
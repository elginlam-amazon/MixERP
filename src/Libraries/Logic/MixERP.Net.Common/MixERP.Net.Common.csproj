<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>MixERP.Net.Common</AssemblyName>
    <RootNamespace>MixERP.Net.Common</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Npgsql" Version="7.0.10" />
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Web Forms (System.Web.UI) types are only available on net10.0 via CoreWebForms. -->
    <Compile Remove="jQueryHelper\jQueryUI.cs" />
    <Compile Remove="Helpers\HtmlControlHelper.cs" />
    <Compile Remove="Helpers\JSUtility.cs" />
    <Compile Remove="Helpers\GridViewHelper.cs" />
    <Compile Remove="Helpers\DropDownListHelper.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <OutputType>Library</OutputType>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\</SolutionDir>
    <RestorePackages>true</RestorePackages>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" />
    <PackageReference Include="SkiaSharp" Version="4.153.1" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="Npgsql" Version="10.0.3" Condition="'$(TargetFramework)' == 'net10.0'" />
    <PackageReference Include="Npgsql" Version="8.0.8" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>

  <!-- Web Forms (System.Web.UI) is provided on .NET 10 by CoreWebForms, which ships for net9.0+ only. netstandard2.0 has no Web Forms surface, so the Web Forms sources are compiled for net10.0 only. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <Compile Remove="jQueryHelper\jQueryUI.cs" />
    <Compile Remove="Helpers\HtmlControlHelper.cs" />
    <Compile Remove="Helpers\JSUtility.cs" />
    <Compile Remove="Helpers\GridViewHelper.cs" />
    <Compile Remove="Helpers\DropDownListHelper.cs" />
  </ItemGroup>
</Project>
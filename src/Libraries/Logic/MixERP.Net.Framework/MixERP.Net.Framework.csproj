<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\</SolutionDir>
    <RestorePackages>true</RestorePackages>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.14" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <!-- Web Forms base classes (System.Web.UI.Page / UserControl / PageStatePersister). Web Forms was
       never ported to modern .NET, so these are kept as source for the per-page Razor re-authoring
       tracked in summary.md and excluded from the net10.0 compile. See knowledge base doc 25. -->
  <ItemGroup>
    <Compile Remove="Controls\MixERPUserControlBase.cs" />
    <Compile Remove="Controls\MixERPWebPageBase.cs" />
    <Compile Remove="Controls\MixERPWidgetBase.cs" />
    <None Include="Controls\MixERPUserControlBase.cs" />
    <None Include="Controls\MixERPWebPageBase.cs" />
    <None Include="Controls\MixERPWidgetBase.cs" />
  </ItemGroup>
</Project>
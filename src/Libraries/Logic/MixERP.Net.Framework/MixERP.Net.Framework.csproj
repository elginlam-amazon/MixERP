<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <UseSystemWeb>true</UseSystemWeb>
    <OutputType>Library</OutputType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.14" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Web Forms base classes: System.Web.UI is not available on netstandard2.0. -->
    <Compile Remove="Controls\**" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Controls\MixERPUserControlBase.cs">
      <SubType>ASPXCodeBehind</SubType>
    </Compile>
    <Compile Update="Controls\MixERPWebPageBase.cs">
      <SubType>ASPXCodeBehind</SubType>
    </Compile>
    <Compile Update="Controls\MixERPWidgetBase.cs">
      <SubType>ASPXCodeBehind</SubType>
    </Compile>
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.Framework</RootNamespace>
    <AssemblyName>MixERP.Net.Framework</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.Framework</AssemblyTitle>
    <Product>MixERP.Net.Framework</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.0.0.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides Microsoft.AspNetCore.Components (ComponentBase, RenderFragment,
         NavigationManager), Microsoft.Extensions.Caching.Memory (IMemoryCache) and
         Microsoft.Extensions.Logging.Abstractions (ILogger<T>) — the modern
         replacements for System.Web.UI, System.Runtime.Caching and Serilog. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

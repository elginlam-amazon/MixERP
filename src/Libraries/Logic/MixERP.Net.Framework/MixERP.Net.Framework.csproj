<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <AssemblyName>MixERP.Net.Framework</AssemblyName>
    <RootNamespace>MixERP.Net.Framework</RootNamespace>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.13" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.13" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <PackageReference Include="CoreWebForms" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Web Forms (System.Web.UI) types are only available on net10.0 via CoreWebForms. -->
    <Compile Remove="Controls\MixERPUserControlBase.cs" />
    <Compile Remove="Controls\MixERPWebPageBase.cs" />
    <Compile Remove="Controls\MixERPWidgetBase.cs" />
  </ItemGroup>
</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.Updater</RootNamespace>
    <AssemblyName>MixERP.Net.Updater</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.Updater</AssemblyTitle>
    <Product>MixERP.Net.Updater</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>5ba920d0-2a52-4583-b7cb-8b427d4a05d8</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Markdig replaces the net35-only MarkdownDeep.NET-Signed 1.5 reference. -->
    <PackageReference Include="Markdig" Version="0.37.0" />
    <!-- Newtonsoft.Json (solution pin) supplies the JToken dynamic shape that replaces
         Microsoft.AspNet.WebApi.Client's ReadAsAsync<dynamic>(). -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <!-- Serilog (solution pin) is used directly by Api/Releases.cs. -->
    <PackageReference Include="Serilog" Version="4.3.0" />
    <!-- Npgsql (solution pin): MixERP.Net.DbFactory's DbOperation surface exposes NpgsqlCommand,
         which Installation/Tasks/RunPatch.cs binds against (CS0012 without this reference). -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.DbFactory\MixERP.Net.DBFactory.csproj" />
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

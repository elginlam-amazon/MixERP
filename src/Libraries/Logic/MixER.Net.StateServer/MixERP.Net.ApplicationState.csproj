<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.ApplicationState</RootNamespace>
    <AssemblyName>MixERP.Net.ApplicationState</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>MixERP.Net.ApplicationState</AssemblyTitle>
    <Product>MixERP.Net.ApplicationState</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <!-- These were explicitly empty in the former Properties/AssemblyInfo.cs; the SDK would
         otherwise default Company to the assembly name and Configuration to "Debug". -->
    <Company></Company>
    <Description></Description>
    <AssemblyTrademark></AssemblyTrademark>
    <AssemblyConfiguration></AssemblyConfiguration>
    <!-- Keep AssemblyInformationalVersion as the bare version, with no git-SHA suffix. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Preserved from the deleted Properties/AssemblyInfo.cs -->
  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>3c368908-78a5-483c-bf25-62322b35f192</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Replaces the legacy System.Web reference: IHttpContextAccessor for the current-user seam. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.i18n</RootNamespace>
    <AssemblyName>MixERP.Net.i18n</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <CodeAnalysisRuleSet>../../../MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.i18n</AssemblyTitle>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.i18n</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.2.0.1</Version>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides Microsoft.Extensions.Caching.Memory (IMemoryCache),
         Microsoft.Extensions.Options / Configuration, Microsoft.Extensions.Hosting
         (IHostEnvironment) and the endpoint routing types used by
         MapResourcesEndpoint — the modern replacements for System.Runtime.Caching,
         System.Configuration and System.Web. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="8.0.5" />
  </ItemGroup>

  <ItemGroup>
    <!-- ICacheFactory: the application-wide IMemoryCache-backed cache abstraction. -->
    <ProjectReference Include="../MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Design-time T4 templates that generate Resources.cs. -->
    <None Include="Processor.ttinclude" />
    <None Include="Resources.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Resources.cs</LastGenOutput>
    </None>
    <None Include="Generator.ttinclude" />
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

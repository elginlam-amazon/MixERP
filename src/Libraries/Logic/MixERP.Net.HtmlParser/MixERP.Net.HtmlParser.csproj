<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.HtmlParser</RootNamespace>
    <AssemblyName>MixERP.Net.HtmlParser</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the former Properties/AssemblyInfo.cs -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.HtmlParser</AssemblyTitle>
    <Description></Description>
    <Company>MixERP Inc.</Company>
    <Product>MixERP.Net.HtmlParser</Product>
    <Copyright>Copyright ©  2014-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.CLSCompliantAttribute">
      <_Parameter1>true</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>8ad7603c-1846-4cc9-9090-43d2dc74310f</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- Rendering engine: the legacy bare-DLL HtmlRenderer / HtmlRenderer.WinForms references and
       System.Windows.Forms.WebBrowser are .NET Framework + Windows only and have no net10.0 build.
       PuppeteerSharp (headless Chromium) is the cross-platform replacement that keeps real HTML/CSS
       layout fidelity for both serializers; SixLabors.ImageSharp (same version as MixERP.Net.Common)
       supplies the IImageFormat/IImageEncoder surface used by ImageHelper. -->
  <ItemGroup>
    <PackageReference Include="PuppeteerSharp" Version="25.15.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

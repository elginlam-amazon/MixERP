<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <!-- Image formats are expressed with SkiaSharp now that System.Drawing is Windows only.
         See knowledge base doc 21. -->
    <PackageReference Include="SkiaSharp" Version="4.150.1" />
  </ItemGroup>
  <!-- WinForms/GDI+ HTML rasterizers. Neither TheArtOfDev.HtmlRenderer.WinForms nor the WinForms
       WebBrowser control exists on modern .NET, so the originals are kept as source for the port
       tracked in summary.md and excluded from the net10.0 compile. -->
  <ItemGroup>
    <Compile Remove="ImageSerializer\HtmlRendererImageSerializer.WinForms.cs" />
    <Compile Remove="ImageSerializer\WebBrowserImageSerializer.WinForms.cs" />
    <None Include="ImageSerializer\HtmlRendererImageSerializer.WinForms.cs" />
    <None Include="ImageSerializer\WebBrowserImageSerializer.WinForms.cs" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
  </ItemGroup>
</Project>
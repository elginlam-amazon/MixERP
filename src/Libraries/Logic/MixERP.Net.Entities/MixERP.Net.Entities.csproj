<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;netstandard2.0</TargetFrameworks>
    <UseSystemWeb>true</UseSystemWeb>
    <OutputType>Library</OutputType>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CSharp" Version="4.7.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="Npgsql" Version="$(NpgsqlVersion)" />
    <PackageReference Include="System.Data.DataSetExtensions" Version="4.5.0" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="System.Runtime.Caching" Version="10.0.14" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <Compile Update="Config.cs">
      <DependentUpon>Config.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Public.cs">
      <DependentUpon>Public.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Localization.cs">
      <DependentUpon>Localization.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Transactions.cs">
      <DependentUpon>Transactions.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="CRM.cs">
      <DependentUpon>CRM.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Audit.cs">
      <DependentUpon>Audit.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Policy.cs">
      <DependentUpon>Policy.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Office.cs">
      <DependentUpon>Office.tt</DependentUpon>
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="Core.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Core.tt</DependentUpon>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Update="Public.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Public.cs</LastGenOutput>
    </None>
    <None Update="Localization.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Localization.cs</LastGenOutput>
    </None>
    <None Update="Transactions.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Transactions.cs</LastGenOutput>
    </None>
    <None Update="CRM.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>CRM.cs</LastGenOutput>
    </None>
    <None Update="Audit.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Audit.cs</LastGenOutput>
    </None>
    <None Update="Policy.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Policy.cs</LastGenOutput>
    </None>
    <None Update="Office.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Office.cs</LastGenOutput>
    </None>
    <None Update="Core.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Core.cs</LastGenOutput>
    </None>
  </ItemGroup>
  <ItemGroup>
    <None Update="Config.tt">
      <Generator>TextTemplatingFileGenerator</Generator>
      <LastGenOutput>Config.cs</LastGenOutput>
    </None>
  </ItemGroup>
</Project>
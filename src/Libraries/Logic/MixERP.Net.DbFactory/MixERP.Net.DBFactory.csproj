<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.DbFactory</RootNamespace>
    <AssemblyName>MixERP.Net.DbFactory</AssemblyName>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <NoWarn>1685</NoWarn>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Assembly metadata migrated from the deleted Properties/AssemblyInfo.cs so the
       assembly identity stays equivalent for the 16 dependent projects. -->
  <PropertyGroup>
    <AssemblyTitle>MixERP.Net.DbFactory</AssemblyTitle>
    <Product>MixERP.Net.DbFactory</Product>
    <Company>MixERP Inc.</Company>
    <Copyright>Copyright ©  2013-2015</Copyright>
    <NeutralLanguage>en</NeutralLanguage>
    <Version>1.2.0.1</Version>
    <AssemblyVersion>1.2.0.1</AssemblyVersion>
    <FileVersion>1.2.0.1</FileVersion>
    <InformationalVersion>1.2.0.1 RC</InformationalVersion>
    <ComVisible>false</ComVisible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../MixERP.Net.Common/MixERP.Net.Common.csproj" />
    <ProjectReference Include="../MixERP.Net.Framework/MixERP.Net.Framework.csproj" />
    <ProjectReference Include="../MixERP.Net.i18n/MixERP.Net.i18n.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../../mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
    <None Include="Mix Open Foundation.snk" />
  </ItemGroup>

</Project>

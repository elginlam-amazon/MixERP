<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>MixERP.Net.DbFactory</RootNamespace>
    <SolutionDir Condition="$(SolutionDir) == '' Or $(SolutionDir) == '*Undefined*'">..\..\..\</SolutionDir>
    <RestorePackages>true</RestorePackages>
    <Configurations>Debug;Debug-net20;Debug-net35;Debug-net40;Debug-net45;Mono-Debug;Mono-Release;Release;Release-net20;Release-net35;Release-net40;Release-net45</Configurations>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>Mix Open Foundation.snk</AssemblyOriginatorKeyFile>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <CodeAnalysisRuleSet>..\..\..\MixERP.ruleset</CodeAnalysisRuleSet>
    <NoWarn>1685</NoWarn>
    <RegisterForComInterop>false</RegisterForComInterop>
  </PropertyGroup>
  <ItemGroup>
    <!-- The GAC references the .NET Framework project carried (System, System.Core,
         System.configuration, System.Web) do not exist on modern .NET: System/System.Core are part
         of the shared framework, and System.configuration / System.Web are supplied by the
         System.Configuration.ConfigurationManager and SystemWebAdapters packages below. -->
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters.CoreServices" Version="2.3.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\..\mixerp.licenseheader">
      <Link>mixerp.licenseheader</Link>
    </None>
  </ItemGroup>
</Project>
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MixERP.Net.FirstSteps</RootNamespace>
    <AssemblyName>MixERP.Net.FirstSteps</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>MixERP.Net.FirstSteps.NewUser</AssemblyTitle>
    <Product>MixERP.Net.FirstSteps.NewUser</Product>
    <Copyright>Copyright ©  2015</Copyright>
    <Version>1.0.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <!-- Preserved from the deleted Properties/AssemblyInfo.cs -->
  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.InteropServices.ComVisibleAttribute">
      <_Parameter1>false</_Parameter1>
      <_Parameter1_TypeName>System.Boolean</_Parameter1_TypeName>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Runtime.InteropServices.GuidAttribute">
      <_Parameter1>1b6bec53-70f6-4933-83b2-bf5c57e08a82</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <!-- The FrontEnd host probes this assembly out of its own bin folder (checklist/plugin discovery
       via MixERP.Net.Framework.DiscoveryAssemblies). Preserved from the legacy Debug OutputPath. -->
  <PropertyGroup Condition=" '$(Configuration)' == 'Debug' ">
    <OutputPath>../../../FrontEnd/MixERP.Net.FrontEnd/bin/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Logic\MixER.Net.StateServer\MixERP.Net.ApplicationState.csproj" />
    <ProjectReference Include="..\..\Logic\MixERP.Net.Common\MixERP.Net.Common.csproj" />
    <ProjectReference Include="..\..\Logic\MixERP.Net.Entities\MixERP.Net.Entities.csproj" />
    <ProjectReference Include="..\..\Logic\MixERP.Net.Framework\MixERP.Net.Framework.csproj" />
    <ProjectReference Include="..\..\Logic\MixERP.Net.i18n\MixERP.Net.i18n.csproj" />
    <ProjectReference Include="..\..\Logic\PetaPoco\PetaPoco.csproj" />
  </ItemGroup>

</Project>
